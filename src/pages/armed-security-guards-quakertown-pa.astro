---
import BaseLayout from '@/layouts/BaseLayout.astro';

const serviceAreas = [
  { name: 'Quakertown', href: '/armed-security-guards-quakertown-pa/' },
  { name: 'Coopersburg', href: '/armed-security-pa/' },
  { name: 'Center Valley', href: '/security-guards-pa/' },
  { name: 'Perkasie', href: '/armed-security-pa/' },
  { name: 'Sellersville', href: '/security-guards-pa/' },
  { name: 'Trumbaursville', href: '/armed-security-pa/' },
  { name: 'Spinnersville', href: '/security-guards-pa/' },
  { name: 'Zionhill', href: '/armed-security-pa/' },
  { name: 'Limeport', href: '/security-guards-pa/' },
  { name: 'East Greenville', href: '/armed-security-pa/' },
];

const hours = [
  { day: 'Monday', status: 'Open 24 Hours', isOpen: true },
  { day: 'Tuesday', status: 'Open 24 Hours', isOpen: true },
  { day: 'Wednesday', status: 'Open 24 Hours', isOpen: true },
  { day: 'Thursday', status: 'Open 24 Hours', isOpen: true },
  { day: 'Friday', status: 'Open 24 Hours', isOpen: true },
  { day: 'Saturday', status: 'Closed', isOpen: false },
  { day: 'Sunday', status: 'Closed', isOpen: false },
];
---

<BaseLayout
  title="Armed Security Guards in Quakertown, PA | KRE Security"
  description="KRE Security provides armed security guards for businesses and events in Quakertown, Pennsylvania. Contact our team to plan protection for your property."
  headerVariant="transparent"
>
  <main data-ps="src/pages/armed-security-guards-quakertown-pa.astro:m34ve1">
    <!-- Hero Section -->
    <section class="bg-dark-background pt-32 pb-20" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:1dwpe0">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5r6">
        <div class="flex items-center gap-3 mb-6" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5r7">
          <span class="status-dot" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwqj">[ Serving Quakertown &amp; Surrounding Cities ]</span>
        </div>
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5r8">
          <div data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5r9">
            <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 text-h1 leading-[1.05]" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:wcdjzg">
              Armed Security Guards Quakertown PA
            </h1>
            <p class="text-dark-muted-foreground text-base leading-relaxed mb-8 max-w-lg" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zz6">
              Our mission is to provide qualified, educated and professional law enforcement, security services protection, and investigation services that meet the needs of our clients as &ldquo;Your Total Security Professional.&rdquo; Our obligation is to promote safety and security for you 24/7 while maintaining competitive and affordable security services throughout Pennsylvania.
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5rv">
              <a
                href="tel:16105620971"
                class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
               data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3bw">
                610-562-0971
              </a>
              <a
                href="/contact/"
                class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
               data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3bv">
                Contact Us
              </a>
            </div>
          </div>

          <!-- Support Card -->
          <aside class="kre-support" aria-labelledby="support-title" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:ryt4bw">
            <div class="kre-support-heading" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5rw">
              <div class="kre-support-brand" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5rx">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="1024"
                  height="1226"
                  loading="eager" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:1rtykf" />
              </div>
              <div class="kre-support-heading-copy" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5ry">
                <span class="kre-panel-label" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwqk">KRE SECURITY, LLC</span>
                <h2 id="support-title" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:o0bkrg">How can we help?</h2>
                <p data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zz5">
                  <span class="kre-status" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwql"></span>24-hour emergency dispatch
                </p>
              </div>
            </div>

            <div class="kre-support-links" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5rz">
              <a href="/act-67-certified-services/" class="kre-support-link" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3bu">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwqm">◇</span>
                <span data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwqn">
                  <strong>Act 67 Training</strong>
                  <small>School security training and certification</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwqo">↗</span>
              </a>
              <a href="/first-aid-training/" class="kre-support-link" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3bt">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwqp">+</span>
                <span data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrb">
                  <strong>First Aid Training</strong>
                  <small>Explore our first aid training programs</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrc">↗</span>
              </a>
              <a href="tel:610-562-0971" class="kre-support-link" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3bs">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrd">◷</span>
                <span data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwre">
                  <strong>24-hour emergency dispatch</strong>
                  <small>610-562-0971</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrf">↗</span>
              </a>
              <a href="/employment/" class="kre-support-link" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3br">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrg">+</span>
                <span data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrh">
                  <strong>KRE Job Openings</strong>
                  <small>Explore careers with KRE Security</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwri">↗</span>
              </a>
            </div>

            <p class="kre-support-note" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zz4">Your total security professional.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- Content & Reviews Section -->
    <section class="bg-surface py-20" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:1dwpe1">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5s0">
        <div class="grid lg:grid-cols-2 gap-16 mb-20" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5s1">
          <!-- Reviews -->
          <div data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5s2">
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zz3">
              [ Verified Reviews ]
            </p>
            <h2 class="font-display font-bold uppercase tracking-tight text-foreground mb-6 text-h2 leading-[1.1]" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:o0bkrh">
              Our Quakertown Armed Security Guard Reviews
            </h2>
            <div class="space-y-4" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5s3">
              <a
                href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.9865777,17z"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 tactical-frame bg-background p-5 group hover:border-primary transition-colors duration-150"
               data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3bq">
                <span class="text-primary font-display font-bold text-2xl" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrj">G</span>
                <div data-ps="src/pages/armed-security-guards-quakertown-pa.astro:qf5s4">
                  <p class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zz2">Google Maps Reviews</p>
                  <p class="text-muted-foreground text-xs" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zz1">View our armed security guard reviews on Google</p>
                </div>
                <span class="ml-auto text-muted-foreground group-hover:text-primary transition-colors" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piwrk">→</span>
              </a>
              <a
                href="https://www.bark.com/en/company/kre-security-investigations/9enON/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 tactical-frame bg-background p-5 group hover:border-primary transition-colors duration-150"
               data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3b4">
                <span class="text-primary font-display font-bold text-2xl" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piws6">B</span>
                <div data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62k">
                  <p class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zz0">Bark.com Reviews</p>
                  <p class="text-muted-foreground text-xs" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zyz">View our armed security guard reviews on Bark.com</p>
                </div>
                <span class="ml-auto text-muted-foreground group-hover:text-primary transition-colors" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:5piws7">→</span>
              </a>
            </div>
          </div>

          <!-- Coverage Zone -->
          <div data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62j">
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zyd">
              [ Coverage Zone ]
            </p>
            <h2 class="font-display font-bold uppercase tracking-tight text-foreground mb-6 text-h2 leading-[1.1]" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:o0bkri">
              Proudly Serving
            </h2>
            <div class="grid grid-cols-2 gap-2 mb-6" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62i">
              {
                serviceAreas.map((area, __psIdx) => (
                  <a
                    href={area.href}
                    class="flex items-center gap-2 text-muted-foreground hover:text-primary text-sm transition-colors duration-150 py-1"
                   data-ps={`src/pages/armed-security-guards-quakertown-pa.astro:8b3b3-${__psIdx}`}>
                    <span class="w-1.5 h-1.5 bg-primary flex-shrink-0" />
                    {area.name}
                  </a>
                ))
              }
            </div>
            <p class="text-muted-foreground text-sm" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zyc">
              And surrounding cities &mdash; <a href="/" class="text-primary hover:underline" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:8b3b2">View All Service Areas</a>
            </p>
          </div>
        </div>

        <!-- Main Office & Hours -->
        <div class="bg-dark-background p-8 lg:p-12 tactical-frame" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62h">
          <div class="grid lg:grid-cols-2 gap-10" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62g">
            <!-- Office Info -->
            <div data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62f">
              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zyb">
                [ Main Office ]
              </p>
              <h3 class="font-display font-bold uppercase text-dark-foreground text-xl mb-4" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:9bwnjv">
                KRE Security
              </h3>
              <div class="space-y-2 text-dark-muted-foreground text-sm mb-6" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62e">
                <p data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zya">11 S 3rd St</p>
                <p data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zy9">Hamburg, PA 19526</p>
                <a
                  href="tel:16105620971"
                  class="block text-primary font-display font-bold text-lg hover:text-primary-hover transition-colors"
                >
                  610-562-0971
                </a>
              </div>
              <a
                href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.9865777,17z"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block border border-dark-border text-dark-foreground font-display font-bold uppercase tracking-widest text-xs px-5 py-3 hover:border-primary hover:text-primary transition-colors duration-150"
              >
                Get Driving Directions
              </a>
            </div>

            <!-- Hours of Operation -->
            <div data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62d">
              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-4" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:7c8zy8">
                [ Hours of Operation ]
              </p>
              <div class="space-y-2" data-ps="src/pages/armed-security-guards-quakertown-pa.astro:g0k62c">
                {
                  hours.map((item, __psIdx) => (
                    <div class="flex justify-between items-center border-b border-dark-border pb-2" data-ps={`src/pages/armed-security-guards-quakertown-pa.astro:g0k62b-${__psIdx}`}>
                      <span class="text-dark-muted-foreground text-sm">{item.day}</span>
                      <span
                        class:list={[
                          'font-display font-bold text-xs uppercase tracking-wide',
                          item.isOpen ? 'text-primary' : 'text-dark-muted-foreground',
                        ]}
                      >
                        {item.status}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-dot {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-flex;
  }

  .status-dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
    display: inline-block;
  }

  .tactical-frame {
    border: 1px solid var(--color-border);
    position: relative;
  }

  .tactical-frame::before {
    content: '';
    border-top: 3px solid var(--color-primary);
    border-left: 3px solid var(--color-primary);
    width: 12px;
    height: 12px;
    position: absolute;
    top: -2px;
    left: -2px;
  }

  .tactical-frame::after {
    content: '';
    border-bottom: 3px solid var(--color-primary);
    border-right: 3px solid var(--color-primary);
    width: 12px;
    height: 12px;
    position: absolute;
    bottom: -2px;
    right: -2px;
  }

  .bg-dark-background.tactical-frame {
    border-color: var(--color-dark-border);
  }

  .kre-support {
    --panel-gold: #dba400;
    color: rgb(250, 250, 250);
    background: #102032;
    border: 1px solid rgba(219, 171, 0, 0.247);
    border-radius: 20px;
    justify-self: end;
    width: 100%;
    max-width: 520px;
    padding: 24px;
    box-shadow: rgba(0, 0, 0, 0.2) 0px 24px 60px;
  }

  .kre-support-heading {
    text-align: left;
    grid-template-columns: 76px minmax(0px, 1fr);
    align-items: stretch;
    gap: 32px;
    margin-bottom: 22px;
    display: grid;
  }

  .kre-support-brand {
    position: relative;
  }

  .kre-support-brand img {
    object-fit: contain;
    object-position: left center;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0px;
  }

  .kre-support-heading-copy {
    min-width: 0px;
  }

  .kre-panel-label {
    letter-spacing: 0.08em;
    color: var(--panel-gold);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .kre-support h2 {
    font-family: var(--font-heading);
    letter-spacing: -0.03em;
    text-transform: none;
    color: rgb(250, 250, 250);
    margin: 7px 0px 8px;
    font-size: 28px;
    line-height: 1.25;
  }

  .kre-support-heading p,
  .kre-support-note {
    color: rgb(213, 219, 227);
    font-size: 1rem;
    line-height: 1.5;
  }

  .kre-status {
    background: var(--panel-gold);
    border-radius: 50%;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    display: inline-block;
  }

  .kre-support-links {
    gap: 10px;
    display: grid;
  }

  .kre-support-link {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.086);
    border-radius: 12px;
    align-items: center;
    gap: 12px;
    padding: 16px;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
    display: flex;
  }

  .kre-support-link:hover {
    background: rgba(219, 171, 0, 0.063);
    border-color: rgba(219, 171, 0, 0.5);
  }

  .kre-support-link:focus-visible {
    outline: 3px solid var(--panel-gold);
    outline-offset: 4px;
  }

  .kre-icon {
    color: var(--panel-gold);
    background: rgba(219, 171, 0, 0.094);
    border-radius: 9px;
    flex-shrink: 0;
    place-items: center;
    width: 38px;
    height: 38px;
    font-size: 24px;
    display: grid;
  }

  .kre-support-link > span:nth-child(2) {
    min-width: 0px;
  }

  .kre-support-link strong {
    color: rgb(250, 250, 250);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    display: block;
  }

  .kre-support-link small {
    color: rgb(213, 219, 227);
    margin-top: 5px;
    font-size: 1rem;
    line-height: 1.5;
    display: block;
  }

  .kre-arrow {
    color: var(--panel-gold);
    margin-left: auto;
  }

  .kre-support-note {
    text-align: center;
    margin-top: 19px;
  }
</style>
