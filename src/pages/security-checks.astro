---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Home & Business Security Checks in PA | KRE Security";
const description = "Travel with greater peace of mind. KRE Security offers planned home and business security checks in Pennsylvania while you are away or out of town.";
const logoUrl = "https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp";
---

<BaseLayout headerVariant="transparent" title={title} description={description}>
  <main data-ps="src/pages/security-checks.astro:os6skn">
    <!-- Hero Section -->
    <section class="bg-dark-background pt-32 pb-20 lg:pt-36 lg:pb-24" data-ps="src/pages/security-checks.astro:ag6e94">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/security-checks.astro:4gquz2">
        <div class="flex items-center gap-3 mb-6" data-ps="src/pages/security-checks.astro:4gquyg">
          <span class="status-dot text-primary font-display font-bold uppercase tracking-widest text-xs flex items-center gap-2" data-ps="src/pages/security-checks.astro:3r9aih">
            <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block" data-ps="src/pages/security-checks.astro:3r9aig"></span>
            [ Berks · Schuylkill · Lehigh &amp; Surrounding Counties ]
          </span>
        </div>

        <div class="grid lg:grid-cols-12 gap-12 items-center" data-ps="src/pages/security-checks.astro:4gquyf">
          <div class="lg:col-span-7" data-ps="src/pages/security-checks.astro:4gquye">
            <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 text-4xl sm:text-5xl lg:text-6xl leading-[1.05]" data-ps="src/pages/security-checks.astro:mnztng">
              Residential / Commercial Security Checks
            </h1>
            <p class="text-primary font-display font-bold uppercase tracking-widest text-sm mb-4" data-ps="src/pages/security-checks.astro:dnsyls">
              "Your Total Security Professional"
            </p>
            <p class="text-dark-muted-foreground text-base leading-relaxed mb-8 max-w-xl" data-ps="src/pages/security-checks.astro:dnsylt">
              KRE Security LLC. offers expert home security check services — giving you, the home or business owner, peace-of-mind while you are on vacation, traveling for business or out of town for a prolonged period of time. We care for your home as if it were our very own.
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/security-checks.astro:4gquyd">
              <a
                href="/contact/"
                class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
               data-ps="src/pages/security-checks.astro:4m4kxl">
                Contact Us Today
              </a>
              <a
                href="tel:16105620971"
                class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
               data-ps="src/pages/security-checks.astro:4m4kxm">
                610-562-0971
              </a>
            </div>
          </div>

          <!-- Support Sidebar Card -->
          <div class="lg:col-span-5" data-ps="src/pages/security-checks.astro:4gquyc">
            <aside class="bg-[#102032] border border-primary/25 rounded-[20px] p-6 lg:p-7 shadow-2xl relative" aria-labelledby="support-title" data-ps="src/pages/security-checks.astro:yh9tvo">
              <div class="flex items-center gap-4 mb-6" data-ps="src/pages/security-checks.astro:4gquyb">
                <div class="w-14 h-14 flex-shrink-0 flex items-center justify-center" data-ps="src/pages/security-checks.astro:4gquya">
                  <img
                    src={logoUrl}
                    alt="KRE Security"
                    width="56"
                    height="67"
                    class="w-full h-auto object-contain" data-ps="src/pages/security-checks.astro:6yzzan" />
                </div>
                <div data-ps="src/pages/security-checks.astro:4gquy9">
                  <span class="text-primary text-xs font-bold uppercase tracking-[1.28px] block" data-ps="src/pages/security-checks.astro:3r9aif">
                    KRE SECURITY, LLC
                  </span>
                  <h2 id="support-title" class="text-2xl font-bold font-display text-white tracking-tight leading-tight" data-ps="src/pages/security-checks.astro:xopb41">
                    How can we help?
                  </h2>
                  <p class="text-xs text-dark-muted-foreground flex items-center gap-2 mt-1" data-ps="src/pages/security-checks.astro:dnsylu">
                    <span class="w-2 h-2 rounded-full bg-primary inline-block" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9hay"></span>
                    24-hour emergency dispatch
                  </p>
                </div>
              </div>

              <div class="flex flex-col gap-3" data-ps="src/pages/security-checks.astro:4gquy8">
                <a
                  href="/act-67-certified-services/"
                  class="bg-white/[0.02] border border-white/[0.086] hover:border-primary/50 hover:bg-white/[0.05] rounded-xl p-3.5 flex items-center justify-between transition-all group"
                 data-ps="src/pages/security-checks.astro:4m4kxn">
                  <div class="flex items-center gap-3" data-ps="src/pages/security-checks.astro:4gquy7">
                    <span class="w-8 h-8 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9hax">
                      ◇
                    </span>
                    <div data-ps="src/pages/security-checks.astro:4gquxl">
                      <strong class="block text-sm font-semibold text-white group-hover:text-primary transition-colors">
                        Act 67 Training
                      </strong>
                      <small class="block text-xs text-dark-muted-foreground">
                        School security training and certification
                      </small>
                    </div>
                  </div>
                  <span class="text-primary text-sm font-bold ml-2 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9haw">
                    ↗
                  </span>
                </a>

                <a
                  href="/first-aid-training/"
                  class="bg-white/[0.02] border border-white/[0.086] hover:border-primary/50 hover:bg-white/[0.05] rounded-xl p-3.5 flex items-center justify-between transition-all group"
                 data-ps="src/pages/security-checks.astro:4m4kxo">
                  <div class="flex items-center gap-3" data-ps="src/pages/security-checks.astro:4gquxk">
                    <span class="w-8 h-8 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9hav">
                      +
                    </span>
                    <div data-ps="src/pages/security-checks.astro:4gquxj">
                      <strong class="block text-sm font-semibold text-white group-hover:text-primary transition-colors">
                        First Aid Training
                      </strong>
                      <small class="block text-xs text-dark-muted-foreground">
                        Explore our first aid training programs
                      </small>
                    </div>
                  </div>
                  <span class="text-primary text-sm font-bold ml-2 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9hau">
                    ↗
                  </span>
                </a>

                <a
                  href="tel:610-562-0971"
                  class="bg-white/[0.02] border border-white/[0.086] hover:border-primary/50 hover:bg-white/[0.05] rounded-xl p-3.5 flex items-center justify-between transition-all group"
                 data-ps="src/pages/security-checks.astro:4m4kxp">
                  <div class="flex items-center gap-3" data-ps="src/pages/security-checks.astro:4gquxi">
                    <span class="w-8 h-8 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9hat">
                      ◷
                    </span>
                    <div data-ps="src/pages/security-checks.astro:4gquxh">
                      <strong class="block text-sm font-semibold text-white group-hover:text-primary transition-colors">
                        24-hour emergency dispatch
                      </strong>
                      <small class="block text-xs text-dark-muted-foreground">
                        610-562-0971
                      </small>
                    </div>
                  </div>
                  <span class="text-primary text-sm font-bold ml-2 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9has">
                    ↗
                  </span>
                </a>

                <a
                  href="/employment/"
                  class="bg-white/[0.02] border border-white/[0.086] hover:border-primary/50 hover:bg-white/[0.05] rounded-xl p-3.5 flex items-center justify-between transition-all group"
                 data-ps="src/pages/security-checks.astro:4m4kxq">
                  <div class="flex items-center gap-3" data-ps="src/pages/security-checks.astro:4gquxg">
                    <span class="w-8 h-8 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9har">
                      +
                    </span>
                    <div data-ps="src/pages/security-checks.astro:4gquxf">
                      <strong class="block text-sm font-semibold text-white group-hover:text-primary transition-colors">
                        KRE Job Openings
                      </strong>
                      <small class="block text-xs text-dark-muted-foreground">
                        Explore careers with KRE Security
                      </small>
                    </div>
                  </div>
                  <span class="text-primary text-sm font-bold ml-2 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-checks.astro:ig9haq">
                    ↗
                  </span>
                </a>
              </div>

              <p class="text-center text-xs text-dark-muted-foreground mt-5" data-ps="src/pages/security-checks.astro:dnsymg">
                Your total security professional.
              </p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content: Comprehensive Inspection Section -->
    <section class="bg-surface py-20" data-ps="src/pages/security-checks.astro:ag6e93">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/security-checks.astro:4gquxe">
        <div class="text-center mb-14" data-ps="src/pages/security-checks.astro:4gquxd">
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/security-checks.astro:dnsymh">
            [ Comprehensive Inspection ]
          </p>
          <h2 class="font-display font-bold uppercase tracking-tight text-foreground text-3xl sm:text-4xl lg:text-5xl leading-[1.1]" data-ps="src/pages/security-checks.astro:xopb42">
            What Do Home Security Checks Include?
          </h2>
        </div>

        <!-- 12 Item Grid -->
        <div class="grid md:grid-cols-2 gap-4 mb-16" data-ps="src/pages/security-checks.astro:4gquxc">
          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwq">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9hap"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9ha3">
              Check all doors and windows to be sure closed and locked
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwp">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9ha2"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9ha1">
              Water indoor and outdoor plants per your instructions
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwo">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9ha0"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h9z">
              Bring in mail, solicitation flyers &amp; newspapers
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwn">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h9y"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h9x">
              Rotate lights for lived-in look
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwm">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h9w"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h9v">
              Check for water leaks under sinks, toilets and washing machine
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwl">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h9u"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h98">
              After rain storm check ceilings in home and garage for water leaks
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwk">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h97"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h96">
              Follow up with landscaper, pool server, housekeeper, pest control, etc., as needed
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwj">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h95"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h94">
              Spray weeds (client provides weed spray)
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwi">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h93"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h92">
              Put out trash cans on scheduled trash, then put away after emptied
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:4gquwh">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h91"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h90">
              Prepare home for client's return — reset thermostat, turn some lights on, schedule housekeeper, pest control, etc.
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:56o87">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h8z"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h8d">
              After each inspection, we will notify you of our findings
            </span>
          </div>

          <div class="flex gap-4 items-start tactical-frame bg-background p-4 shadow-sm" data-ps="src/pages/security-checks.astro:56o86">
            <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/security-checks.astro:ig9h8c"></span>
            <span class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:ig9h8b">
              Alarm response by officers to check on your property while you are away
            </span>
          </div>
        </div>

        <!-- Serving Eastern PA Tactical Box -->
        <div class="bg-dark-background p-8 lg:p-12 tactical-frame" data-ps="src/pages/security-checks.astro:56o85">
          <div class="grid lg:grid-cols-2 gap-10 items-center" data-ps="src/pages/security-checks.astro:56o84">
            <div data-ps="src/pages/security-checks.astro:56o83">
              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/security-checks.astro:dnsymi">
                [ Coverage Area ]
              </p>
              <h2 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-4 text-2xl sm:text-3xl lg:text-4xl leading-[1.1]" data-ps="src/pages/security-checks.astro:xopb43">
                Serving Eastern Pennsylvania
              </h2>
              <p class="text-dark-muted-foreground text-sm leading-relaxed mb-6" data-ps="src/pages/security-checks.astro:dnsymj">
                KRE Security LLC. offers Berks, Schuylkill, Lehigh and surrounding counties expert home security check services — giving you, the home or business owner, complete peace-of-mind while you are away.
              </p>
              <div class="flex flex-wrap gap-2 mb-8" data-ps="src/pages/security-checks.astro:56o82">
                <span class="border border-dark-border text-dark-muted-foreground font-display font-bold uppercase text-xs tracking-widest px-3 py-1" data-ps="src/pages/security-checks.astro:ig9h8a">
                  Berks County
                </span>
                <span class="border border-dark-border text-dark-muted-foreground font-display font-bold uppercase text-xs tracking-widest px-3 py-1" data-ps="src/pages/security-checks.astro:ig9h89">
                  Schuylkill County
                </span>
                <span class="border border-dark-border text-dark-muted-foreground font-display font-bold uppercase text-xs tracking-widest px-3 py-1" data-ps="src/pages/security-checks.astro:ig9h88">
                  Lehigh County
                </span>
                <span class="border border-dark-border text-dark-muted-foreground font-display font-bold uppercase text-xs tracking-widest px-3 py-1" data-ps="src/pages/security-checks.astro:ig9h87">
                  Surrounding Counties
                </span>
              </div>
              <a
                href="/contact/"
                class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
              >
                Contact Us Today to Get Started
              </a>
            </div>

            <div class="space-y-4" data-ps="src/pages/security-checks.astro:56o81">
              <div class="border border-dark-border p-5" data-ps="src/pages/security-checks.astro:56o80">
                <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/security-checks.astro:dnsymk">
                  [ Peace of Mind ]
                </p>
                <p class="text-dark-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:dnsyml">
                  Our security checks are designed and planned with you in mind — giving you total confidence while you're on vacation, traveling for business, or out of town for a prolonged period.
                </p>
              </div>

              <div class="border border-dark-border p-5" data-ps="src/pages/security-checks.astro:56o7z">
                <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/security-checks.astro:dnsymm">
                  [ Personal Care ]
                </p>
                <p class="text-dark-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:dnsymn">
                  We care for your home as if it were our very own. Every inspection is followed up with a full report of our findings.
                </p>
              </div>

              <div class="border border-dark-border p-5" data-ps="src/pages/security-checks.astro:56o7y">
                <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/security-checks.astro:dnsymo">
                  [ 24-Hour Alarm Response ]
                </p>
                <p class="text-dark-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-checks.astro:dnsymp">
                  Our officers respond to alarms and check on your property around the clock while you are away.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tactical-frame {
    position: relative;
    border: 1px solid var(--color-border);
  }

  .tactical-frame::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 7px;
    height: 7px;
    border-top: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
    pointer-events: none;
  }

  .tactical-frame::after {
    content: '';
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 7px;
    height: 7px;
    border-bottom: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
    pointer-events: none;
  }

  .bg-dark-background.tactical-frame {
    border-color: var(--color-dark-border);
  }
</style>
