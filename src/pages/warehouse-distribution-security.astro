                </li>
                <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/warehouse-distribution-security.astro:8ileht">
                  <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf39l"></span>
                  <span data-ps="src/pages/warehouse-distribution-security.astro:ynf39m">Certified and Trained Security Patrol Personnel</span>
                </li>
                <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/warehouse-distribution-security.astro:8ilehs">
                  <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf39n"></span>
