                    <small class="block text-dark-muted-foreground text-xs font-sans">Explore careers with KRE Security</small>
                  </div>
                </div>
                <span class="text-primary text-sm font-bold" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf37y">↗</span>
              </a>
            </div>

            <p class="text-center text-xs sm:text-sm text-dark-muted-foreground font-sans" data-ps="src/pages/warehouse-distribution-security.astro:5oezrm">
              Your total security professional.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="bg-surface py-16 lg:py-20" data-ps="src/pages/warehouse-distribution-security.astro:62b1fg">
