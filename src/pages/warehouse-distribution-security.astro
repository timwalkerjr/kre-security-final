---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Warehouse & Distribution Security in PA | KRE Security";
const description = "Protect your warehouse or distribution center with KRE Security’s Pennsylvania security services. Discuss patrols and coverage for your facility.";
---

<BaseLayout
  headerVariant="transparent"
  title={title}
  description={description}
>
  <main data-ps="src/pages/warehouse-distribution-security.astro:6urb4a">
    <!-- Hero Section -->
    <section class="bg-dark-background py-16 lg:py-20 border-b border-dark-border" data-ps="src/pages/warehouse-distribution-security.astro:62b1ff">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/warehouse-distribution-security.astro:nodowl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/warehouse-distribution-security.astro:nodowm">
          <div data-ps="src/pages/warehouse-distribution-security.astro:nodown">
            <p class="flex items-center gap-2 text-primary font-heading font-bold text-xs uppercase tracking-[1.2px] mb-4" data-ps="src/pages/warehouse-distribution-security.astro:5oezsa">
              <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block shrink-0" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf372"></span>
              <span data-ps="src/pages/warehouse-distribution-security.astro:ynf373">[ Industrial Security Division ]</span>
            </p>
            <h1 class="font-heading font-bold uppercase tracking-tight text-dark-foreground text-4xl sm:text-5xl lg:text-[56px] leading-[1.15] mb-6" data-ps="src/pages/warehouse-distribution-security.astro:274807">
              Warehouse &amp; Distribution Center Security
            </h1>
            <p class="font-sans text-dark-muted-foreground text-base sm:text-lg leading-relaxed mb-8" data-ps="src/pages/warehouse-distribution-security.astro:5oezs9">
              KRE has extensive experience providing security programs and services to distribution center clients. We demonstrate a vast understanding of the unique challenges and common concerns associated with this market.
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/warehouse-distribution-security.astro:nodox9">
              <a
                href="/contact/"
                class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors"
               data-ps="src/pages/warehouse-distribution-security.astro:1fiwt5">
                Contact Us Today
              </a>
              <a
                href="tel:6105620971"
                class="inline-block bg-transparent text-dark-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors"
               data-ps="src/pages/warehouse-distribution-security.astro:1fiwt6">
                610-562-0971
              </a>
            </div>
          </div>

          <!-- Support Panel Sidebar -->
          <aside class="bg-[#102032] border border-primary/25 rounded-[20px] p-6 sm:p-8" aria-labelledby="support-title" data-ps="src/pages/warehouse-distribution-security.astro:3dao2p">
            <div class="flex items-start gap-4 mb-6" data-ps="src/pages/warehouse-distribution-security.astro:nodoxa">
              <div class="w-12 h-14 shrink-0" data-ps="src/pages/warehouse-distribution-security.astro:nodoxb">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="1024"
                  height="1226"
                  class="w-full h-full object-contain" data-ps="src/pages/warehouse-distribution-security.astro:l64kl0" />
              </div>
              <div class="min-w-0 flex-1" data-ps="src/pages/warehouse-distribution-security.astro:nodoxc">
                <span class="block text-xs font-bold text-primary tracking-[1.28px] uppercase font-sans mb-1" data-ps="src/pages/warehouse-distribution-security.astro:ynf374">
                  KRE SECURITY, LLC
                </span>
                <h2 id="support-title" class="font-heading text-2xl sm:text-[28px] font-bold text-white leading-tight mb-1" data-ps="src/pages/warehouse-distribution-security.astro:chap80">
                  How can we help?
                </h2>
                <p class="flex items-center gap-2 text-dark-muted-foreground text-sm font-sans" data-ps="src/pages/warehouse-distribution-security.astro:5oezrn">
                  <span class="w-2 h-2 rounded-full bg-primary inline-block shrink-0" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf375"></span>
                  24-hour emergency dispatch
                </p>
              </div>
            </div>

            <div class="space-y-3 mb-6" data-ps="src/pages/warehouse-distribution-security.astro:nodoxd">
              <a
