                  <div data-ps="src/pages/warehouse-distribution-security.astro:nodoxf">
                    <strong class="block text-white font-sans text-sm font-bold group-hover:text-primary transition-colors">Act 67 Training</strong>
                    <small class="block text-dark-muted-foreground text-xs font-sans">School security training and certification</small>
                  </div>
                </div>
                <span class="text-primary text-sm font-bold" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf377">↗</span>
              </a>

              <a
                href="/first-aid-training/"
                class="bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 sm:p-4 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/warehouse-distribution-security.astro:1fiwt8">
                <div class="flex items-center gap-3.5" data-ps="src/pages/warehouse-distribution-security.astro:nodoxg">
                  <span class="w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base shrink-0" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf378">+</span>
                  <div data-ps="src/pages/warehouse-distribution-security.astro:nodoxh">
                    <strong class="block text-white font-sans text-sm font-bold group-hover:text-primary transition-colors">First Aid Training</strong>
                    <small class="block text-dark-muted-foreground text-xs font-sans">Explore our first aid training programs</small>
                  </div>
                </div>
                <span class="text-primary text-sm font-bold" aria-hidden="true" data-ps="src/pages/warehouse-distribution-security.astro:ynf379">↗</span>
              </a>

              <a
                href="tel:610-562-0971"
                class="bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 sm:p-4 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
