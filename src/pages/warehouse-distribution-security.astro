                  <div data-ps="src/pages/warehouse-distribution-security.astro:aoxw1a">
                    <strong class="block text-white font-sans text-sm font-bold group-hover:text-primary transition-colors">24-hour emergency dispatch</strong>
                    <small class="block text-dark-muted-foreground text-xs font-sans">610-562-0971</small>
