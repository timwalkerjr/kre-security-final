---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Logistics & Yard Security in PA | KRE Security';
const description = 'Protect storage yards, loading docks, and rail yards with KRE Security. Our team plans security duties and staffing around your Pennsylvania operation.';

const services = [
  {
    title: 'Inventory Control Assistance',
    desc: 'Assisting in accurate management of all transportation container inventories.',
  },
  {
    title: 'Fixed Guard Booth & GPS Tracking',
    desc: 'Stationary guard posts combined with GPS vehicle and asset tracking.',
  },
  {
    title: 'Docking Designation',
    desc: 'Keeping accurate timing and coordinating proper dock assignments.',
  },
  {
    title: 'Arrival & Departure Logging',
    desc: 'Tracking and maintaining logs for the arrival and departure of vehicles, materials, and equipment.',
  },
  {
    title: 'Shipping Inventory Management',
    desc: 'Managing and verifying all shipping inventory against manifests.',
  },
  {
    title: 'Full Truck Inspections',
    desc: 'Checking driver name, documenting front and back license plates, and ensuring no unauthorized pallets or equipment leave the facility.',
  },
  {
    title: 'Reefer Temperature Logging',
    desc: 'For refrigerated trucks, inspecting and logging refrigeration temperatures.',
  },
  {
    title: 'Cal/OSHA Audit Support',
    desc: 'Assisting in fulfilling Cal/OSHA audit requirements with highly trained staff.',
  },
];

const galleryImages = [
  {
    src: 'https://pagesmith-cdn.com/fe6bcc20/images/63861c_b40132039a454caca51a291d981bb653-mv2-320-43f95e-320.webp',
    alt: 'KRE Security logistics operations',
  },
  {
    src: 'https://pagesmith-cdn.com/fe6bcc20/images/63861c_2413aa10d3184636be68c163373f1337-mv2-320-58c3ca-320.webp',
    alt: 'Transportation security monitoring',
  },
  {
    src: 'https://pagesmith-cdn.com/fe6bcc20/images/63861c_7f6517f50dca4fe8be7a405cccb9c373-mv2-320-11af63-320.webp',
    alt: 'Logistical security guard',
  },
  {
    src: 'https://pagesmith-cdn.com/fe6bcc20/images/63861c_552b9b4f821e46da8b116aed877efd39-mv2-320-69a126-320.webp',
    alt: 'Security checkpoint operations',
  },
];
---

<BaseLayout title={title} description={description} headerVariant="transparent">
  <main data-ps="src/pages/logistical-security.astro:trwhf">
    <!-- HERO SECTION -->
    <section id="logistical-hero" class="bg-dark-background pt-28 pb-20 lg:pt-36 lg:pb-24" data-ps="src/pages/logistical-security.astro:651nnd">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/logistical-security.astro:w8tff7">
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/logistical-security.astro:w8tff8">
          <!-- Left Content -->
          <div data-ps="src/pages/logistical-security.astro:w8tff9">
            <div class="mb-6" data-ps="src/pages/logistical-security.astro:w8tffa">
              <span class="text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/logistical-security.astro:smfonh">
                [ Logistics Division: Active Since 1990 ]
              </span>
            </div>

            <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 text-h1" data-ps="src/pages/logistical-security.astro:8k9vsf">
              Logistical<br />Business Security
            </h1>

            <p class="text-dark-muted-foreground leading-relaxed text-lg mb-8 max-w-xl" data-ps="src/pages/logistical-security.astro:xwmxik">
              KRE Security specializes in providing security and logistical services for the transportation industry across the Eastern PA region since 1990, serving the I-78 Lehigh, Berks, and Lebanon Counties corridors.
            </p>

            <a
              href="/contact/"
              class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-8 py-3.5 transition-colors duration-150 bg-primary border-primary text-primary-foreground hover:bg-primary-hover hover:border-primary-hover"
             data-ps="src/pages/logistical-security.astro:qsp0ue">
              Contact Us Today to Get Started
            </a>
          </div>

          <!-- Right Support Card -->
          <aside
            class="bg-dark-surface border border-primary/25 rounded-[20px] p-6 lg:p-8 text-dark-foreground shadow-2xl"
            aria-labelledby="support-title"
           data-ps="src/pages/logistical-security.astro:swsow8">
            <div class="flex items-center gap-4 mb-6" data-ps="src/pages/logistical-security.astro:w8tffb">
              <div class="flex-shrink-0" data-ps="src/pages/logistical-security.astro:w8tffc">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="48"
                  height="58"
                  class="w-12 h-auto" data-ps="src/pages/logistical-security.astro:tqkb30" />
              </div>
              <div class="flex-1 min-w-0" data-ps="src/pages/logistical-security.astro:w8tffd">
                <span class="text-xs font-bold uppercase tracking-[1.28px] text-primary block mb-0.5" data-ps="src/pages/logistical-security.astro:smfoni">
                  KRE SECURITY, LLC
                </span>
                <h2 id="support-title" class="text-2xl font-bold font-display text-white tracking-tight" data-ps="src/pages/logistical-security.astro:6451f7">
                  How can we help?
                </h2>
                <p class="text-xs text-dark-muted-foreground flex items-center gap-2 mt-1" data-ps="src/pages/logistical-security.astro:xwmxij">
                  <span class="w-2 h-2 rounded-full bg-primary inline-block" aria-hidden="true" data-ps="src/pages/logistical-security.astro:smfonj"></span>
                  24-hour emergency dispatch
                </p>
              </div>
            </div>

            <div class="space-y-3" data-ps="src/pages/logistical-security.astro:w8tffe">
              <a
                href="/act-67-certified-services/"
                class="bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/logistical-security.astro:qsp0ud">
                <div class="flex items-center gap-3" data-ps="src/pages/logistical-security.astro:w8tfg0">
                  <span
                    class="w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-lg flex-shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors"
                    aria-hidden="true"
                   data-ps="src/pages/logistical-security.astro:smfonk">
                    ◇
                  </span>
                  <div data-ps="src/pages/logistical-security.astro:w8tfg1">
                    <strong class="block text-sm text-white font-medium group-hover:text-primary transition-colors">
                      Act 67 Training
                    </strong>
                    <small class="text-xs text-dark-muted-foreground block">
                      School security training and certification
                    </small>
                  </div>
                </div>
                <span class="text-primary text-base ml-2 flex-shrink-0" aria-hidden="true" data-ps="src/pages/logistical-security.astro:smfonl">↗</span>
              </a>

              <a
                href="/first-aid-training/"
                class="bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/logistical-security.astro:qsp0uc">
                <div class="flex items-center gap-3" data-ps="src/pages/logistical-security.astro:w8tfg2">
                  <span
                    class="w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-lg flex-shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors"
                    aria-hidden="true"
                   data-ps="src/pages/logistical-security.astro:smfonm">
                    +
                  </span>
                  <div data-ps="src/pages/logistical-security.astro:w8tfg3">
                    <strong class="block text-sm text-white font-medium group-hover:text-primary transition-colors">
                      First Aid Training
                    </strong>
                    <small class="text-xs text-dark-muted-foreground block">
                      Explore our first aid training programs
                    </small>
                  </div>
                </div>
                <span class="text-primary text-base ml-2 flex-shrink-0" aria-hidden="true" data-ps="src/pages/logistical-security.astro:smfonn">↗</span>
              </a>

              <a
                href="tel:610-562-0971"
                class="bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/logistical-security.astro:qsp0ub">
                <div class="flex items-center gap-3" data-ps="src/pages/logistical-security.astro:w8tfg4">
                  <span
                    class="w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-lg flex-shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors"
                    aria-hidden="true"
                   data-ps="src/pages/logistical-security.astro:smfono">
                    ◷
                  </span>
                  <div data-ps="src/pages/logistical-security.astro:w8tfg5">
                    <strong class="block text-sm text-white font-medium group-hover:text-primary transition-colors">
                      24-hour emergency dispatch
                    </strong>
                    <small class="text-xs text-dark-muted-foreground block">
                      610-562-0971
                    </small>
                  </div>
                </div>
                <span class="text-primary text-base ml-2 flex-shrink-0" aria-hidden="true" data-ps="src/pages/logistical-security.astro:smfonp">↗</span>
              </a>

              <a
                href="/employment/"
                class="bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/logistical-security.astro:qsp0ua">
                <div class="flex items-center gap-3" data-ps="src/pages/logistical-security.astro:w8tfg6">
                  <span
                    class="w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-lg flex-shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors"
                    aria-hidden="true"
                   data-ps="src/pages/logistical-security.astro:smfoob">
                    +
                  </span>
                  <div data-ps="src/pages/logistical-security.astro:w8tfg7">
                    <strong class="block text-sm text-white font-medium group-hover:text-primary transition-colors">
                      KRE Job Openings
                    </strong>
                    <small class="text-xs text-dark-muted-foreground block">
                      Explore careers with KRE Security
                    </small>
                  </div>
                </div>
                <span class="text-primary text-base ml-2 flex-shrink-0" aria-hidden="true" data-ps="src/pages/logistical-security.astro:smfooc">↗</span>
              </a>
            </div>

            <p class="text-center text-xs text-dark-muted-foreground mt-5" data-ps="src/pages/logistical-security.astro:xwmxii">
              Your total security professional.
            </p>
          </aside>
        </div>

        <!-- Corridor Tagline -->
        <div class="mt-12" data-ps="src/pages/logistical-security.astro:w8tfg8">
          <div class="border-l-2 border-primary pl-4" data-ps="src/pages/logistical-security.astro:w8tfg9">
            <p class="text-xs font-display font-bold uppercase tracking-widest text-dark-muted-foreground" data-ps="src/pages/logistical-security.astro:xwmxih">
              Eastern PA | I-78 Corridor | Lehigh · Berks · Lebanon
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- LOGISTICAL SERVICES SECTION -->
    <section id="logistical-services" class="bg-background py-16 lg:py-24" data-ps="src/pages/logistical-security.astro:651nne">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/logistical-security.astro:qgek0h">
        <!-- Section Header -->
        <div class="max-w-3xl mb-12" data-ps="src/pages/logistical-security.astro:qgek0g">
          <div class="mb-3" data-ps="src/pages/logistical-security.astro:qgek0f">
            <span class="text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/logistical-security.astro:smfood">
              [ Transportation Industry Specialists ]
            </span>
          </div>

          <h2 class="font-display font-bold uppercase tracking-tight text-foreground mb-4 text-h2" data-ps="src/pages/logistical-security.astro:6451f6">
            Our Logistical Security Services
          </h2>

          <p class="text-muted-foreground leading-relaxed" data-ps="src/pages/logistical-security.astro:xwmxig">
            Our very affordable security services relieve your personnel of select inventory and inspection duties while enhancing our ability to provide proper security and accountability of all transportation containers for our clients. Whether you manage a storage yard, loading dock or a rail yard, our management team will design post order duties to match your business's needs and assign guards that are well-qualified to accomplish them.
          </p>
        </div>

        <!-- Service Cards Grid -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12" data-ps="src/pages/logistical-security.astro:qgek0e">
          {
            services.map((service, __psIdx) => (
              <div class="border border-border p-5 bg-surface" data-ps={`src/pages/logistical-security.astro:qgek0d-${__psIdx}`}>
                <span class="w-2 h-2 rounded-full block mb-3 bg-primary" />
                <p class="font-display font-bold uppercase tracking-wide text-foreground text-sm mb-2" data-ps={`src/pages/logistical-security.astro:xwmxif-${__psIdx}`}>
                  {service.title}
                </p>
                <p class="text-xs text-muted-foreground leading-relaxed" data-ps={`src/pages/logistical-security.astro:xwmxie-${__psIdx}`}>
                  {service.desc}
                </p>
              </div>
            ))
          }
        </div>

        <!-- Operations Gallery -->
        <div class="mb-10" data-ps="src/pages/logistical-security.astro:qgek0c">
          <p class="text-xs font-display font-bold uppercase tracking-widest mb-4 text-primary" data-ps="src/pages/logistical-security.astro:xwmxhs">
            [ Operations Gallery ]
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" data-ps="src/pages/logistical-security.astro:qgek0b">
            {
              galleryImages.map((img, __psIdx) => (
                <div class="overflow-hidden" data-ps={`src/pages/logistical-security.astro:qgek0a-${__psIdx}`}>
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="320"
                    height="320"
                    class="w-full max-w-[320px] h-auto aspect-square object-cover"
                    loading="lazy" data-ps={`src/pages/logistical-security.astro:tqkb31-${__psIdx}`} />
                </div>
              ))
            }
          </div>
        </div>

        <!-- Bottom CTA Box -->
        <div class="border border-border p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 bg-surface" data-ps="src/pages/logistical-security.astro:qgek09">
          <div class="flex-1" data-ps="src/pages/logistical-security.astro:qgek08">
            <p class="font-display font-bold uppercase tracking-wide text-foreground mb-1" data-ps="src/pages/logistical-security.astro:xwmxhr">
              Serving the I-78 Corridor Since 1990
            </p>
            <p class="text-sm text-muted-foreground" data-ps="src/pages/logistical-security.astro:xwmxhq">
              Affordable, professional logistical security for transportation companies across Eastern Pennsylvania.
            </p>
          </div>
          <a
            href="/contact/"
            class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 flex-shrink-0 transition-colors duration-150 bg-secondary border-secondary text-secondary-foreground hover:bg-secondary-hover hover:border-secondary-hover"
           data-ps="src/pages/logistical-security.astro:qsp0to">
            Get Started
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
