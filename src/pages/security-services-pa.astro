---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  title: "About Our Pennsylvania Security Team | KRE Security",
  description: "Meet KRE Security’s owner and management team. Learn about our experience, leadership, and approach to security and investigation services in Pennsylvania.",
  canonicalUrl: "https://kre-security.netlify.app/security-services-pa/"
};
---

<BaseLayout headerVariant="transparent" title={seo.title} description={seo.description} canonicalUrl={seo.canonicalUrl}>
  <main data-ps="src/pages/security-services-pa.astro:cj7ojx">
    <!-- HERO SECTION -->
    <section class="bg-dark-background py-20 lg:py-24 border-b border-dark-border" data-ps="src/pages/security-services-pa.astro:so7mki">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/security-services-pa.astro:xd63bt">
        <div class="flex items-center gap-3 mb-6" data-ps="src/pages/security-services-pa.astro:xd63bu">
          <span class="text-primary font-display font-bold uppercase tracking-widest text-xs" data-ps="src/pages/security-services-pa.astro:sbxfwe">
            [ Founded August 1990 — Under New Ownership Since 2016 ]
          </span>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-start" data-ps="src/pages/security-services-pa.astro:xd63bv">
          <!-- Left Hero Column -->
          <div data-ps="src/pages/security-services-pa.astro:xd63ch">
            <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 text-4xl sm:text-5xl lg:text-[56px] leading-[1.05]" data-ps="src/pages/security-services-pa.astro:yaazit">
              About KRE Security
            </h1>
            <p class="text-dark-muted-foreground text-base leading-relaxed mb-6 max-w-lg" data-ps="src/pages/security-services-pa.astro:q1yhk6">
              KRE Security LLC. was founded in August of 1990. We are a full-time Security Service and Investigations Corporation. We provide factually based investigations and conduct every investigation ethically, morally, legally and with the highest degree of integrity.
            </p>
            <p class="text-dark-muted-foreground text-sm leading-relaxed mb-8 max-w-lg" data-ps="src/pages/security-services-pa.astro:q1yhk5">
              Our goal is to meet your security needs 24/7 while providing cost effective services to our customers.
            </p>

            <div class="flex flex-wrap gap-4" data-ps="src/pages/security-services-pa.astro:xd63ci">
              <a
                href="/contact/"
                class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover hover:border-primary-hover transition-colors duration-150"
               data-ps="src/pages/security-services-pa.astro:ir3hd0">
                Contact Us: 610-562-0971
              </a>
              <a
                href="/security-company-faq/"
                class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
               data-ps="src/pages/security-services-pa.astro:ir3hcz">
                Learn More: FAQs
              </a>
            </div>

            <!-- Featured Press Box -->
            <div class="relative bg-dark-border/20 mt-8 p-6 border border-dark-border" data-ps="src/pages/security-services-pa.astro:xd63cj">
              <span class="absolute -top-px -left-px w-2.5 h-2.5 border-t-2 border-l-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfwd"></span>
              <span class="absolute -bottom-px -right-px w-2.5 h-2.5 border-b-2 border-r-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfwc"></span>

              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/security-services-pa.astro:q1yhk4">
                [ Featured Press ]
              </p>
              <h3 class="font-display font-bold uppercase text-dark-foreground text-base mb-2" data-ps="src/pages/security-services-pa.astro:4xh52s">
                "Post-9/11, A New World Emerges for Security"
              </h3>
              <p class="text-dark-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-services-pa.astro:q1yhk3">
                An article written by Reading Eagle's Carole Duran — read about the difference KRE Security LLC. is making in the community when it comes to safety and security.{' '}
                <a
                  href="http://www.readingeagle.com/business-weekly/article/post-911-a-new-world-emerges-for-security&template=mobileart"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary underline underline-offset-4 hover:text-primary-hover transition-colors"
                 data-ps="src/pages/security-services-pa.astro:ir3hcy">
                  Read the Reading Eagle article →
                </a>
              </p>
            </div>
          </div>

          <!-- Right Hero Support Card -->
          <aside class="bg-[#102032] border border-primary/25 rounded-[20px] p-6 sm:p-8 relative shadow-2xl" aria-labelledby="support-title" data-ps="src/pages/security-services-pa.astro:extp3y">
            <div class="flex items-center gap-4 mb-6" data-ps="src/pages/security-services-pa.astro:xd63ck">
              <div class="w-12 h-14 flex-shrink-0 flex items-center justify-center" data-ps="src/pages/security-services-pa.astro:xd63cl">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="1024"
                  height="1226"
                  class="w-full h-full object-contain" data-ps="src/pages/security-services-pa.astro:uuwyzb" />
              </div>
              <div data-ps="src/pages/security-services-pa.astro:xd63cm">
                <span class="block text-[#dba400] font-sans font-bold uppercase tracking-[1.28px] text-xs mb-0.5" data-ps="src/pages/security-services-pa.astro:sbxfwb">
                  KRE SECURITY, LLC
                </span>
                <h2 id="support-title" class="font-display font-bold text-white text-2xl sm:text-[28px] leading-tight" data-ps="src/pages/security-services-pa.astro:jlw2b6">
                  How can we help?
                </h2>
                <p class="text-dark-muted-foreground text-sm flex items-center gap-2 mt-1" data-ps="src/pages/security-services-pa.astro:q1yhk2">
                  <span class="w-2 h-2 rounded-full bg-[#dba400] inline-block" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfwa"></span>
                  24-hour emergency dispatch
                </p>
              </div>
            </div>

            <div class="space-y-3 mb-6" data-ps="src/pages/security-services-pa.astro:xd63cn">
              <a
                href="/act-67-certified-services/"
                class="flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/security-services-pa.astro:ir3hcx">
                <div class="flex items-center gap-3.5" data-ps="src/pages/security-services-pa.astro:xd63co">
                  <span class="w-9 h-9 rounded-[9px] bg-primary/10 text-[#dba400] flex items-center justify-center font-bold text-lg flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfw9">
                    ◇
                  </span>
                  <div data-ps="src/pages/security-services-pa.astro:xd63cp">
                    <strong class="block text-white text-sm font-semibold group-hover:text-primary transition-colors">Act 67 Training</strong>
                    <small class="block text-dark-muted-foreground text-xs">School security training and certification</small>
                  </div>
                </div>
                <span class="text-[#dba400] text-base group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfw8">↗</span>
              </a>

              <a
                href="/first-aid-training/"
                class="flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/security-services-pa.astro:ir3hcw">
                <div class="flex items-center gap-3.5" data-ps="src/pages/security-services-pa.astro:xd63cq">
                  <span class="w-9 h-9 rounded-[9px] bg-primary/10 text-[#dba400] flex items-center justify-center font-bold text-lg flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfw7">
                    +
                  </span>
                  <div data-ps="src/pages/security-services-pa.astro:xd63dc">
                    <strong class="block text-white text-sm font-semibold group-hover:text-primary transition-colors">First Aid Training</strong>
                    <small class="block text-dark-muted-foreground text-xs">Explore our first aid training programs</small>
                  </div>
                </div>
                <span class="text-[#dba400] text-base group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfw6">↗</span>
              </a>

              <a
                href="tel:610-562-0971"
                class="flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/security-services-pa.astro:ir3hcv">
                <div class="flex items-center gap-3.5" data-ps="src/pages/security-services-pa.astro:xd63dd">
                  <span class="w-9 h-9 rounded-[9px] bg-primary/10 text-[#dba400] flex items-center justify-center font-bold text-lg flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvk">
                    ◷
                  </span>
                  <div data-ps="src/pages/security-services-pa.astro:xd63de">
                    <strong class="block text-white text-sm font-semibold group-hover:text-primary transition-colors">24-hour emergency dispatch</strong>
                    <small class="block text-dark-muted-foreground text-xs">610-562-0971</small>
                  </div>
                </div>
                <span class="text-[#dba400] text-base group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvj">↗</span>
              </a>

              <a
                href="/employment/"
                class="flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/security-services-pa.astro:ir3hcu">
                <div class="flex items-center gap-3.5" data-ps="src/pages/security-services-pa.astro:xd63df">
                  <span class="w-9 h-9 rounded-[9px] bg-primary/10 text-[#dba400] flex items-center justify-center font-bold text-lg flex-shrink-0" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvi">
                    +
                  </span>
                  <div data-ps="src/pages/security-services-pa.astro:xd63dg">
                    <strong class="block text-white text-sm font-semibold group-hover:text-primary transition-colors">KRE Job Openings</strong>
                    <small class="block text-dark-muted-foreground text-xs">Explore careers with KRE Security</small>
                  </div>
                </div>
                <span class="text-[#dba400] text-base group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvh">↗</span>
              </a>
            </div>

            <p class="text-center text-dark-muted-foreground text-sm font-sans" data-ps="src/pages/security-services-pa.astro:q1yhk1">
              Your total security professional.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <!-- MANAGEMENT TEAM SECTION -->
    <section class="bg-surface py-20 border-b border-border" data-ps="src/pages/security-services-pa.astro:so7mkh">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/security-services-pa.astro:xd63dh">
        <div class="text-center mb-14" data-ps="src/pages/security-services-pa.astro:xd63di">
          <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/security-services-pa.astro:q1yhk0">
            [ Leadership & Operations ]
          </p>
          <h2 class="font-display font-bold uppercase tracking-tight text-foreground text-3xl sm:text-4xl lg:text-[42px] leading-tight" data-ps="src/pages/security-services-pa.astro:jlw2b7">
            KRE Security Management Team
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-4" data-ps="src/pages/security-services-pa.astro:xd63dj">
          <!-- Kandice Pyles -->
          <div class="relative bg-background flex gap-5 p-6 border border-border" data-ps="src/pages/security-services-pa.astro:xd63dk">
            <span class="absolute -top-px -left-px w-2.5 h-2.5 border-t-2 border-l-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvg"></span>
            <span class="absolute -bottom-px -right-px w-2.5 h-2.5 border-b-2 border-r-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvf"></span>
            
            <div class="flex-shrink-0" data-ps="src/pages/security-services-pa.astro:xd63dl">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/63861c_1140176b21f944f687d5a4673411f71b-mv2-230-679172-230.webp"
                alt="Kandice Pyles finance & scheduling mgr"
                class="max-w-[80px] w-full h-24 object-cover object-top"
                loading="lazy" data-ps="src/pages/security-services-pa.astro:uuwyzc" />
            </div>
            <div class="flex-1 min-w-0" data-ps="src/pages/security-services-pa.astro:xd63e7">
              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-1" data-ps="src/pages/security-services-pa.astro:q1yhje">
                Executive Director of Finance
              </p>
              <h3 class="font-display font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-services-pa.astro:4xh52t">
                Kandice Pyles
              </h3>
              <p class="text-muted-foreground text-xs leading-relaxed" data-ps="src/pages/security-services-pa.astro:q1yhjd">
                Miss Pyles holds a Bachelor's degree in Sports Administration with a Minor in Business Administration from Indiana University of Pennsylvania. She is primarily responsible for overseeing and managing the financial, payroll, and billing departments at KRE Security, working closely with clients to address billing concerns.
              </p>
              <details class="group mt-4">
                <summary class="cursor-pointer font-semibold text-foreground hover:text-primary transition-colors flex items-center gap-1.5 list-none">
                  <span class="text-[10px] inline-block transition-transform group-open:rotate-90" data-ps="src/pages/security-services-pa.astro:sbxfve">▶</span> Read Full Biography
                </summary>
                <div class="space-y-4 mt-4 text-muted-foreground text-base leading-relaxed" data-ps="src/pages/security-services-pa.astro:xd63e8">
                  <p data-ps="src/pages/security-services-pa.astro:q1yhjc">
                    Kandice’s expertise has been instrumental in implementing an updated employee tracking, scheduling, and payroll management system within our office. She works closely with clients to ensure that all billing and time management reports are generated and prepared weekly, contributing to the financial stability of KRE Security LLC.
                  </p>
                  <p data-ps="src/pages/security-services-pa.astro:q1yhjb">
                    Kandice's educational background offers significant value to KRE Security, as she has a strong understanding of the financial budgeting needs of both school districts and commercial clients. Her focus on financial stability and integrity is central to the services KRE provides. Kandice is also responsible for handling all client invoicing needs.
                  </p>
                </div>
              </details>
            </div>
          </div>

          <!-- Matthew Peters -->
          <div class="relative bg-background flex gap-5 p-6 border border-border" data-ps="src/pages/security-services-pa.astro:xd63e9">
            <span class="absolute -top-px -left-px w-2.5 h-2.5 border-t-2 border-l-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvd"></span>
            <span class="absolute -bottom-px -right-px w-2.5 h-2.5 border-b-2 border-r-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfvc"></span>
            
            <div class="flex-shrink-0" data-ps="src/pages/security-services-pa.astro:xd63ea">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/profile-picture-237-0f51c7-237.webp"
                alt="Matthew Peters - Executive Director"
                class="max-w-[80px] w-full h-24 object-cover object-top"
                loading="lazy" data-ps="src/pages/security-services-pa.astro:uuwyzd" />
            </div>
            <div class="flex-1 min-w-0" data-ps="src/pages/security-services-pa.astro:xd63eb">
              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-1" data-ps="src/pages/security-services-pa.astro:q1yhja">
                Executive Director / Client & Staff Relations / Operations
              </p>
              <h3 class="font-display font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-services-pa.astro:4xh52u">
                Matthew Peters
              </h3>
              <p class="text-muted-foreground text-xs leading-relaxed" data-ps="src/pages/security-services-pa.astro:q1yhj9">
                Matt brings a very diverse skill set to the company. One of his standout qualities is his leadership. With a Communications degree from Penn State University, Matt also completed the prestigious Marsh and McLennan Management & Leadership Training Course in Dallas, TX. He has been a two-time guest at the Vitals National Leadership Conference, attending seminars in both Chicago and Cleveland. These conferences focus on advanced sales, marketing, customer service, and leadership for operations managers.
              </p>
              <details class="group mt-4">
                <summary class="cursor-pointer font-semibold text-foreground hover:text-primary transition-colors flex items-center gap-1.5 list-none">
                  <span class="text-[10px] inline-block transition-transform group-open:rotate-90" data-ps="src/pages/security-services-pa.astro:sbxfvb">▶</span> Read Full Biography
                </summary>
                <div class="space-y-4 mt-4 text-muted-foreground text-base leading-relaxed" data-ps="src/pages/security-services-pa.astro:xd63ec">
                  <p data-ps="src/pages/security-services-pa.astro:q1yhj8">
                    A United States Marine Corps veteran, Matt served multiple combat tours in Iraq and held a Secret Clearance during his time in service. He led numerous overseas operations, including cross-training exercises with the Republic of Korea Marines, the Royal Thai Marines, and Iraqi security forces. As a MCMAP instructor, Matt also led hand-to-hand combat training for his platoon. In addition, he is a silver medalist in jiu-jitsu at the North American NAGA tournament.
                  </p>
                  <p data-ps="src/pages/security-services-pa.astro:q1yhj7">
                    Matt has a wealth of experience in security management, having worked as a supervisor at Southern California nightclubs, professional sporting events, and live music venues. He also managed transportation, regulations, and security for the Department of Health in the Pennsylvania Medical Marijuana Program. Before stepping into his current role as Executive Director, Matt served as the Senior Director of Client & Staff Relations, and as East Coast Operations Manager for KRE.
                  </p>
                </div>
              </details>
            </div>
          </div>

          <!-- Rachael Dalton -->
          <div class="relative bg-background flex gap-5 p-6 border border-border" data-ps="src/pages/security-services-pa.astro:xd63ed">
            <span class="absolute -top-px -left-px w-2.5 h-2.5 border-t-2 border-l-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfup"></span>
            <span class="absolute -bottom-px -right-px w-2.5 h-2.5 border-b-2 border-r-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfuo"></span>
            
            <div class="flex-shrink-0" data-ps="src/pages/security-services-pa.astro:xd63ee">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/1000017319-237-1cd1f8-237.webp"
                alt="Rachael Dalton - Senior Director of Administration"
                class="max-w-[80px] w-full h-24 object-cover object-top"
                loading="lazy" data-ps="src/pages/security-services-pa.astro:uuwyze" />
            </div>
            <div class="flex-1 min-w-0" data-ps="src/pages/security-services-pa.astro:xd63ef">
              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-1" data-ps="src/pages/security-services-pa.astro:q1yhj6">
                Senior Director of Administration
              </p>
              <h3 class="font-display font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-services-pa.astro:4xh53g">
                Rachael Dalton
              </h3>
              <p class="text-muted-foreground text-xs leading-relaxed" data-ps="src/pages/security-services-pa.astro:q1yhj5">
                Ms. Dalton joined KRE Security in August 2021, initially serving as a Dispatcher before quickly advancing to the role of Scheduling Manager. She then transitioned into Operations Manager before assuming her current position as the Director of Administration. With over 25 years of experience in Administration, Human Resources, and Scheduling, Rachael brings a wealth of expertise to her role. Prior to joining KRE Security, she held similar positions in the Healthcare and Insurance sectors.
              </p>
              <details class="group mt-4">
                <summary class="cursor-pointer font-semibold text-foreground hover:text-primary transition-colors flex items-center gap-1.5 list-none">
                  <span class="text-[10px] inline-block transition-transform group-open:rotate-90" data-ps="src/pages/security-services-pa.astro:sbxfun">▶</span> Read Full Biography
                </summary>
                <div class="space-y-4 mt-4 text-muted-foreground text-base leading-relaxed" data-ps="src/pages/security-services-pa.astro:xd63eg">
                  <p data-ps="src/pages/security-services-pa.astro:q1yhij">
                    Rachael has a Liberal Arts background from Northampton Area Community College and holds her Act 235 Lethal Weapons Certification through the Commonwealth of Pennsylvania.
                  </p>
                  <p data-ps="src/pages/security-services-pa.astro:q1yhii">
                    As Director of Administration, Rachael is responsible for providing direct support to KRE President Jarrod Emes and overseeing the day-to-day operations of the business. Her key responsibilities include staff management, field operations, ensuring adherence to KRE’s Best Business Practices, and addressing client concerns, contract compliance, and site-specific needs.
                  </p>
                  <p data-ps="src/pages/security-services-pa.astro:q1yhih">
                    A vital member of the KRE Security Business Development Team, Rachael works tirelessly to ensure that KRE Security not only meets, but consistently exceeds client expectations. She is dedicated to ensuring that our security personnel are always prepared to provide the highest level of service to our valued clients.
                  </p>
                  <p data-ps="src/pages/security-services-pa.astro:q1yhig">
                    Rachael is always available to collaborate with clients and community members, looking forward to delivering tailored security solutions that address unique needs and ensure peace of mind.
                  </p>
                </div>
              </details>
            </div>
          </div>

          <!-- Amanda Ahmed -->
          <div class="relative bg-background flex gap-5 p-6 border border-border" data-ps="src/pages/security-services-pa.astro:xd63f2">
            <span class="absolute -top-px -left-px w-2.5 h-2.5 border-t-2 border-l-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxfum"></span>
            <span class="absolute -bottom-px -right-px w-2.5 h-2.5 border-b-2 border-r-2 border-primary" aria-hidden="true" data-ps="src/pages/security-services-pa.astro:sbxful"></span>
            
            <div class="flex-shrink-0" data-ps="src/pages/security-services-pa.astro:xd63f3">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/image-237-ca4a79-237.webp"
                alt="Amanda Ahmed - Hiring Recruitment Supervisor"
                class="max-w-[80px] w-full h-24 object-cover object-top"
                loading="lazy" data-ps="src/pages/security-services-pa.astro:uuwyzf" />
            </div>
            <div class="flex-1 min-w-0" data-ps="src/pages/security-services-pa.astro:xd63f4">
              <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-1" data-ps="src/pages/security-services-pa.astro:q1yhif">
                Hiring Recruitment Supervisor
              </p>
              <h3 class="font-display font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-services-pa.astro:4xh53h">
                Amanda Ahmed, M.A.
