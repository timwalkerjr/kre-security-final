---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Home Security Systems in Pennsylvania | KRE Security";
const description = "Explore customizable home security systems from KRE Security in Pennsylvania. Discuss protection options tailored to your home, property, and needs.";
---

<BaseLayout
  title={title}
  description={description}
  headerVariant="solid"
>
  <main data-ps="src/pages/in-home-security.astro:8bj9vk">
    {/* Hero Section */}
    <section id="in-home-hero" class="bg-surface py-16 lg:py-24" data-ps="src/pages/in-home-security.astro:3xttrl">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/in-home-security.astro:nsh778">
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/in-home-security.astro:nsh76m">
          <div class="reveal-left active" data-ps="src/pages/in-home-security.astro:nsh76l">
            <div class="mb-4" data-ps="src/pages/in-home-security.astro:nsh76k">
              <span class="text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/in-home-security.astro:zhzf65">
                [ Home &amp; Business Protection ]
              </span>
            </div>
            <h1 class="font-display font-bold uppercase tracking-tight text-foreground mb-6 text-[40px] sm:text-[48px] lg:text-[56px] leading-[1.05]" data-ps="src/pages/in-home-security.astro:75xkv1">
              In-Home Security<br />Systems
            </h1>
            <p class="text-muted-foreground leading-relaxed mb-6" data-ps="src/pages/in-home-security.astro:e1g41f">
              KRE Security LLC. can secure your home or business in the best possible way. We are community oriented and always willing to help you in any situation.
            </p>
            <p class="text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/in-home-security.astro:e1g41e">
              We work with a variety of wireless alarm systems with multiple features. All systems are user friendly and easy to install. We can customize the system to your particular needs for your home, business, etc.
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/in-home-security.astro:nsh76j">
              <a
                href="/contact/"
                class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150 bg-secondary border-secondary text-secondary-foreground hover:bg-secondary-hover hover:border-secondary-hover"
               data-ps="src/pages/in-home-security.astro:1rbzx3">
                Contact Us Today
              </a>
              <a
                href="/security-checks/"
                class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150 border-border text-foreground hover:bg-black/5"
               data-ps="src/pages/in-home-security.astro:1rbzwh">
                Home Security Checks
              </a>
            </div>
          </div>

          {/* Support Panel */}
          <aside class="kre-support bg-[#102032] border border-[rgba(219,171,0,0.25)] rounded-[20px] p-6 lg:p-8 shadow-xl" aria-labelledby="support-title" data-ps="src/pages/in-home-security.astro:p1omi3">
            <div class="flex items-start gap-4 mb-6" data-ps="src/pages/in-home-security.astro:nsh76i">
              <div class="w-12 h-14 flex-shrink-0 flex items-center justify-center" data-ps="src/pages/in-home-security.astro:nsh76h">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="1024"
                  height="1226"
                  class="w-full h-full object-contain" data-ps="src/pages/in-home-security.astro:qaqbjk" />
              </div>
              <div class="flex-1" data-ps="src/pages/in-home-security.astro:nsh76g">
                <span class="block text-xs font-bold uppercase tracking-[1.28px] text-primary mb-1" data-ps="src/pages/in-home-security.astro:zhzf66">
                  KRE SECURITY, LLC
                </span>
                <h2 id="support-title" class="font-display font-bold text-2xl lg:text-[28px] text-white tracking-[-0.84px] leading-tight mb-1" data-ps="src/pages/in-home-security.astro:luci2p">
                  How can we help?
                </h2>
                <p class="flex items-center gap-2 text-sm text-[#d5dbe3]" data-ps="src/pages/in-home-security.astro:e1g40s">
                  <span class="w-2 h-2 rounded-full bg-primary inline-block flex-shrink-0" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf67"></span>
                  24-hour emergency dispatch
                </p>
              </div>
            </div>

            <div class="space-y-3 mb-6" data-ps="src/pages/in-home-security.astro:nsh76f">
              <a
                href="/act-67-certified-services/"
                class="flex items-center justify-between p-3.5 rounded-xl border border-white/[0.086] bg-white/[0.02] hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/in-home-security.astro:1rbzwg">
                <span class="w-8 h-8 rounded-[9px] bg-[rgba(219,171,0,0.094)] text-primary flex items-center justify-center font-bold text-sm flex-shrink-0" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf68">
                  ◇
                </span>
                <span class="flex-1 ml-3 mr-2" data-ps="src/pages/in-home-security.astro:zhzf6u">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">Act 67 Training</strong>
                  <small class="block text-xs text-[#d5dbe3]">School security training and certification</small>
                </span>
                <span class="text-primary text-sm flex-shrink-0 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf6v">↗</span>
              </a>

              <a
                href="/first-aid-training/"
                class="flex items-center justify-between p-3.5 rounded-xl border border-white/[0.086] bg-white/[0.02] hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/in-home-security.astro:1rbzwf">
                <span class="w-8 h-8 rounded-[9px] bg-[rgba(219,171,0,0.094)] text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf6w">
                  +
                </span>
                <span class="flex-1 ml-3 mr-2" data-ps="src/pages/in-home-security.astro:zhzf6x">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">First Aid Training</strong>
                  <small class="block text-xs text-[#d5dbe3]">Explore our first aid training programs</small>
                </span>
                <span class="text-primary text-sm flex-shrink-0 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf6y">↗</span>
              </a>

              <a
                href="tel:610-562-0971"
                class="flex items-center justify-between p-3.5 rounded-xl border border-white/[0.086] bg-white/[0.02] hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/in-home-security.astro:1rbzwe">
                <span class="w-8 h-8 rounded-[9px] bg-[rgba(219,171,0,0.094)] text-primary flex items-center justify-center font-bold text-sm flex-shrink-0" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf6z">
                  ◷
                </span>
                <span class="flex-1 ml-3 mr-2" data-ps="src/pages/in-home-security.astro:zhzf70">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">24-hour emergency dispatch</strong>
                  <small class="block text-xs text-[#d5dbe3]">610-562-0971</small>
                </span>
                <span class="text-primary text-sm flex-shrink-0 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf71">↗</span>
              </a>

              <a
                href="/employment/"
                class="flex items-center justify-between p-3.5 rounded-xl border border-white/[0.086] bg-white/[0.02] hover:bg-primary/[0.06] hover:border-primary/50 transition-all group"
               data-ps="src/pages/in-home-security.astro:1rbzwd">
                <span class="w-8 h-8 rounded-[9px] bg-[rgba(219,171,0,0.094)] text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/in-home-security.astro:zhzf72">
                  +
                </span>
                <span class="flex-1 ml-3 mr-2" data-ps="src/pages/in-home-security.astro:zhzf73">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">KRE Job Openings</strong>
                  <small class="block text-xs text-[#d5dbe3]">Explore careers with KRE Security</small>
                </span>
                <span class="text-primary text-sm flex-shrink-0 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/in-home-security.astro:jh4i80">↗</span>
              </a>
            </div>

            <p class="text-center text-xs text-[#d5dbe3] font-sans" data-ps="src/pages/in-home-security.astro:e1g40r">
              Your total security professional.
            </p>
          </aside>
        </div>
      </div>
    </section>

    {/* System Specs & Reasons Section */}
    <section id="in-home-features" class="bg-dark-background py-16 lg:py-24 text-dark-foreground" data-ps="src/pages/in-home-security.astro:3xttrm">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/in-home-security.astro:nsh76e">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16" data-ps="src/pages/in-home-security.astro:nsh76d">
          {/* Left Column: What's Included */}
          <div class="reveal-left active" data-ps="src/pages/in-home-security.astro:nsh75r">
            <div class="mb-3" data-ps="src/pages/in-home-security.astro:nsh75q">
              <span class="inline-flex items-center gap-2 text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/in-home-security.astro:jh4i81">
                <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block" aria-hidden="true" data-ps="src/pages/in-home-security.astro:jh4i82"></span>
                [ System Specs ]
              </span>
            </div>
            <h2 class="font-display font-bold uppercase tracking-tight text-white mb-4 text-[32px] sm:text-[40px] lg:text-[52px] leading-[1.1]" data-ps="src/pages/in-home-security.astro:luci2o">
              What's Included
            </h2>
            <p class="text-dark-muted-foreground mb-6 leading-relaxed" data-ps="src/pages/in-home-security.astro:e1g40q">
              Our systems are homeowner/businessowner owned and have a small monthly or yearly service fee.
            </p>
            <ul class="space-y-3 mb-6">
              <li class="flex items-center gap-3 border border-dark-border p-3 bg-secondary" data-ps="src/pages/in-home-security.astro:emozg3">
                <span class="w-2 h-2 flex-shrink-0 rounded-full bg-primary" aria-hidden="true" data-ps="src/pages/in-home-security.astro:jh4i83"></span>
                <span class="text-dark-foreground text-sm font-sans" data-ps="src/pages/in-home-security.astro:jh4i84">Standard touch screen</span>
              </li>
              <li class="flex items-center gap-3 border border-dark-border p-3 bg-secondary" data-ps="src/pages/in-home-security.astro:emozg2">
                <span class="w-2 h-2 flex-shrink-0 rounded-full bg-primary" aria-hidden="true" data-ps="src/pages/in-home-security.astro:jh4i85"></span>
                <span class="text-dark-foreground text-sm font-sans" data-ps="src/pages/in-home-security.astro:jh4i86">Three door or window sensors</span>
              </li>
              <li class="flex items-center gap-3 border border-dark-border p-3 bg-secondary" data-ps="src/pages/in-home-security.astro:emozg1">
                <span class="w-2 h-2 flex-shrink-0 rounded-full bg-primary" aria-hidden="true" data-ps="src/pages/in-home-security.astro:jh4i87"></span>
                <span class="text-dark-foreground text-sm font-sans" data-ps="src/pages/in-home-security.astro:jh4i88">One pet proof motion detector</span>
              </li>
              <li class="flex items-center gap-3 border border-dark-border p-3 bg-secondary" data-ps="src/pages/in-home-security.astro:emozg0">
                <span class="w-2 h-2 flex-shrink-0 rounded-full bg-primary" aria-hidden="true" data-ps="src/pages/in-home-security.astro:jh4i89"></span>
                <span class="text-dark-foreground text-sm font-sans" data-ps="src/pages/in-home-security.astro:jh4i8v">One four button key fob</span>
              </li>
            </ul>
            <div class="border-l-2 border-primary pl-4" data-ps="src/pages/in-home-security.astro:nsh75p">
              <p class="text-sm text-dark-muted-foreground leading-relaxed" data-ps="src/pages/in-home-security.astro:e1g40p">
                * Additional equipment such as wireless smoke or carbon monoxide detectors can be added at a small fee.
              </p>
            </div>
            <p class="text-dark-muted-foreground text-sm mt-4 leading-relaxed" data-ps="src/pages/in-home-security.astro:e1g40o">
              You can control your system using a simple, easy-to-use application on your smartphone, tablet, and more.
            </p>
          </div>

          {/* Right Column: 5 Reasons */}
          <div class="reveal-right active" data-ps="src/pages/in-home-security.astro:nsh75o">
            <div class="mb-3" data-ps="src/pages/in-home-security.astro:nsh75n">
              <span class="text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/in-home-security.astro:jh4i8w">
                [ Why Install a System ]
              </span>
            </div>
            <h2 class="font-display font-bold uppercase tracking-tight text-white mb-6 text-[32px] sm:text-[40px] lg:text-[52px] leading-[1.1]" data-ps="src/pages/in-home-security.astro:luci2n">
              5 Reasons to Install a Home Security System
            </h2>
            <div class="space-y-4" data-ps="src/pages/in-home-security.astro:nsh75m">
              <div class="flex gap-4 items-start border-b border-dark-border pb-4" data-ps="src/pages/in-home-security.astro:nsh75l">
                <span class="font-display font-bold text-2xl flex-shrink-0 text-primary" data-ps="src/pages/in-home-security.astro:jh4i8x">
                  01
                </span>
                <div data-ps="src/pages/in-home-security.astro:nsh75k">
                  <h3 class="font-display font-bold uppercase tracking-wide text-white text-sm mb-1" data-ps="src/pages/in-home-security.astro:yicmo5">
                    Sense of Security
                  </h3>
                  <p class="text-sm leading-relaxed text-dark-muted-foreground" data-ps="src/pages/in-home-security.astro:e1g40n">
                    Even just the presence of a security system can make a business more effective and efficient by giving owners and employees peace of mind.
                  </p>
                </div>
              </div>

              <div class="flex gap-4 items-start border-b border-dark-border pb-4" data-ps="src/pages/in-home-security.astro:nsh75j">
                <span class="font-display font-bold text-2xl flex-shrink-0 text-primary" data-ps="src/pages/in-home-security.astro:jh4i8y">
                  02
                </span>
                <div data-ps="src/pages/in-home-security.astro:nsh75i">
                  <h3 class="font-display font-bold uppercase tracking-wide text-white text-sm mb-1" data-ps="src/pages/in-home-security.astro:yicmo6">
                    Prevention
                  </h3>
                  <p class="text-sm leading-relaxed text-dark-muted-foreground" data-ps="src/pages/in-home-security.astro:e1g40m">
                    A thief will think twice when a security system is present. It lets them know that you are serious about your security and will deter them from targeting you.
                  </p>
                </div>
              </div>

              <div class="flex gap-4 items-start border-b border-dark-border pb-4" data-ps="src/pages/in-home-security.astro:nsh74w">
                <span class="font-display font-bold text-2xl flex-shrink-0 text-primary" data-ps="src/pages/in-home-security.astro:jh4i8z">
                  03
                </span>
                <div data-ps="src/pages/in-home-security.astro:nsh74v">
                  <h3 class="font-display font-bold uppercase tracking-wide text-white text-sm mb-1" data-ps="src/pages/in-home-security.astro:yicmos">
                    Customer Service
                  </h3>
                  <p class="text-sm leading-relaxed text-dark-muted-foreground" data-ps="src/pages/in-home-security.astro:e1g40l">
                    Not only does a sense of security put your employees at ease but also your customers — creating a safer, more welcoming environment.
                  </p>
                </div>
              </div>

              <div class="flex gap-4 items-start border-b border-dark-border pb-4" data-ps="src/pages/in-home-security.astro:nsh74u">
                <span class="font-display font-bold text-2xl flex-shrink-0 text-primary" data-ps="src/pages/in-home-security.astro:jh4i90">
                  04
                </span>
                <div data-ps="src/pages/in-home-security.astro:nsh74t">
                  <h3 class="font-display font-bold uppercase tracking-wide text-white text-sm mb-1" data-ps="src/pages/in-home-security.astro:yicmot">
                    Handling Crime
                  </h3>
                  <p class="text-sm leading-relaxed text-dark-muted-foreground" data-ps="src/pages/in-home-security.astro:e1g40k">
                    Having security measures in place will allow police to solve a crime quickly and get you back to business in no time.
                  </p>
                </div>
              </div>

              <div class="flex gap-4 items-start pb-0" data-ps="src/pages/in-home-security.astro:nsh74s">
                <span class="font-display font-bold text-2xl flex-shrink-0 text-primary" data-ps="src/pages/in-home-security.astro:jh4i91">
                  05
                </span>
                <div data-ps="src/pages/in-home-security.astro:nsh74r">
                  <h3 class="font-display font-bold uppercase tracking-wide text-white text-sm mb-1" data-ps="src/pages/in-home-security.astro:yicmou">
                    Monitoring
                  </h3>
                  <p class="text-sm leading-relaxed text-dark-muted-foreground" data-ps="src/pages/in-home-security.astro:e1g40j">
                    Take this responsibility off your shoulders and leave your home or business security to a professional security system.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Wireless Advantage Section */}
    <section id="in-home-wireless" class="bg-background py-16 lg:py-24" data-ps="src/pages/in-home-security.astro:3xttrn">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/in-home-security.astro:nsh74q">
        <div class="mb-3" data-ps="src/pages/in-home-security.astro:nsh74p">
          <span class="text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/in-home-security.astro:jh4i92">
            [ Wireless Advantage ]
          </span>
        </div>
        <h2 class="font-display font-bold uppercase tracking-tight text-foreground mb-8 text-[32px] sm:text-[40px] lg:text-[52px] leading-[1.1]" data-ps="src/pages/in-home-security.astro:luci2m">
          Why Go Wireless for Your<br />Home Security System?
        </h2>

        <div class="grid lg:grid-cols-3 gap-8 mb-12" data-ps="src/pages/in-home-security.astro:nsh74o">
          <div class="border border-border p-6" data-ps="src/pages/in-home-security.astro:nsh74n">
            <p class="text-xs font-display font-bold uppercase tracking-widest mb-3 text-primary" data-ps="src/pages/in-home-security.astro:e1g3zx">
              [ Real-Time Awareness ]
            </p>
            <p class="text-muted-foreground leading-relaxed text-sm" data-ps="src/pages/in-home-security.astro:e1g3zw">
              Wireless systems are more secure and allow you to have real-time awareness and alerts from your home via your mobile app. These systems are increasingly tamper proof because there are no exposed lines that can be cut from outside.
            </p>
          </div>

          <div class="border border-border p-6" data-ps="src/pages/in-home-security.astro:gt1gxt">
            <p class="text-xs font-display font-bold uppercase tracking-widest mb-3 text-primary" data-ps="src/pages/in-home-security.astro:e1g3zv">
              [ Remote Monitoring ]
            </p>
            <p class="text-muted-foreground leading-relaxed text-sm" data-ps="src/pages/in-home-security.astro:e1g3zu">
              Your wireless system comes with a phone app you can use to monitor surveillance footage live. Check who's at the door, monitor kids in the backyard, or check on pets while at work — from wherever you are.
            </p>
          </div>

          <div class="border border-border p-6" data-ps="src/pages/in-home-security.astro:gt1gxs">
            <p class="text-xs font-display font-bold uppercase tracking-widest mb-3 text-primary" data-ps="src/pages/in-home-security.astro:e1g3zt">
              [ Easy Expansion ]
            </p>
            <p class="text-muted-foreground leading-relaxed text-sm" data-ps="src/pages/in-home-security.astro:e1g3zs">
              As your family grows and evolves, your security needs may as well. It's easy to add new cameras with a wireless system. Let us know what you're looking to protect and we'll help create a system that's just right for you.
            </p>
          </div>
        </div>

        {/* Equipment Gallery Images */}
        <div class="flex flex-wrap gap-4 items-center justify-start mb-10" data-ps="src/pages/in-home-security.astro:gt1gxr">
          <div class="border border-border overflow-hidden" data-ps="src/pages/in-home-security.astro:gt1gxq">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_43eab39063f74cca917dd0648078034d-mv2-184-47d504-184.webp"
              alt="Wireless home security device"
              width="184"
              class="max-w-[184px] h-auto object-cover"
              loading="lazy" data-ps="src/pages/in-home-security.astro:qaqbjj" />
          </div>
          <div class="border border-border overflow-hidden" data-ps="src/pages/in-home-security.astro:gt1gxp">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_9e8dce94da104095b6cf86e34e32c8de-mv2-184-2183be-184.webp"
              alt="Home security panel"
              width="184"
              class="max-w-[184px] h-auto object-cover"
              loading="lazy" data-ps="src/pages/in-home-security.astro:qaqbix" />
          </div>
          <div class="border border-border overflow-hidden" data-ps="src/pages/in-home-security.astro:gt1gxo">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_87063351514d41efb6ef1dddf67510f3-mv2-184-7a5103-184.webp"
              alt="Security sensor"
              width="184"
              class="max-w-[184px] h-auto object-cover"
              loading="lazy" data-ps="src/pages/in-home-security.astro:qaqbiw" />
          </div>
          <div class="border border-border overflow-hidden" data-ps="src/pages/in-home-security.astro:gt1gxn">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_ed2a42e00c18406a905836f2db8b6160-mv2-184-c9cb08-184.webp"
              alt="Smart security device"
              width="184"
              class="max-w-[184px] h-auto object-cover"
              loading="lazy" data-ps="src/pages/in-home-security.astro:qaqbiv" />
          </div>
