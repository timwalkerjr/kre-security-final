---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Security Vehicle Patrols in Pennsylvania | KRE Security';
const description =
  'KRE Security offers marked and unmarked vehicle patrols and venue-specific patrol options in Pennsylvania. Plan a patrol service around your property.';
---

<BaseLayout
  headerVariant="transparent"
  title={title}
  description={description}
>
  <main data-ps="src/pages/vehicle-patrol.astro:yfm7oq">
    <!-- HERO SECTION -->
    <section class="bg-dark-background pt-32 pb-20 lg:pt-36 lg:pb-24" data-ps="src/pages/vehicle-patrol.astro:8x6ip1">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/vehicle-patrol.astro:kk096">
        <div class="flex items-center gap-3 mb-6" data-ps="src/pages/vehicle-patrol.astro:kk097">
          <span class="status-dot" data-ps="src/pages/vehicle-patrol.astro:baki13">[ Marked &amp; Unmarked Fleet — Fully Insured &amp; Licensed ]</span>
        </div>
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/vehicle-patrol.astro:kk098">
          <div data-ps="src/pages/vehicle-patrol.astro:kk099">
            <h1 class="font-heading font-bold uppercase tracking-tight text-dark-foreground mb-6 text-4xl sm:text-5xl lg:text-[56px] leading-[1.05]" data-ps="src/pages/vehicle-patrol.astro:zg51cp">
              Security Vehicle Patrol
            </h1>
            <p class="text-dark-muted-foreground text-base leading-relaxed mb-8 max-w-lg" data-ps="src/pages/vehicle-patrol.astro:fx11wv">
              KRE Security has a fleet of Marked Security Patrol Vehicles, Unmarked Patrol, Covert Vehicles, and Security Patrol Golf Carts for venue specific areas. KRE provides a custom patrol service based on the client's needs and venue.
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/vehicle-patrol.astro:kk09a">
              <a
                href="/contact/"
                class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
               data-ps="src/pages/vehicle-patrol.astro:b2qvax">
                Request a Quote
              </a>
              <a
                href="tel:16105620971"
                class="inline-block bg-transparent text-dark-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
               data-ps="src/pages/vehicle-patrol.astro:b2qvay">
                610-562-0971
              </a>
            </div>
          </div>

          <aside class="kre-support" aria-labelledby="support-title" data-ps="src/pages/vehicle-patrol.astro:5wpfun">
            <div class="kre-support-heading" data-ps="src/pages/vehicle-patrol.astro:kk09b">
              <div class="kre-support-brand" data-ps="src/pages/vehicle-patrol.astro:kk09c">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="1024"
                  height="1226"
                  loading="eager" data-ps="src/pages/vehicle-patrol.astro:1xp430" />
              </div>
              <div class="kre-support-heading-copy" data-ps="src/pages/vehicle-patrol.astro:kk09d">
                <span class="kre-panel-label" data-ps="src/pages/vehicle-patrol.astro:baki14">KRE SECURITY, LLC</span>
                <h2 id="support-title" data-ps="src/pages/vehicle-patrol.astro:kwk3er">How can we help?</h2>
                <p data-ps="src/pages/vehicle-patrol.astro:fx11wu">
                  <span class="kre-status" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki15"></span>24-hour emergency dispatch
                </p>
              </div>
            </div>
            <div class="kre-support-links" data-ps="src/pages/vehicle-patrol.astro:kk09e">
              <a href="/act-67-certified-services/" class="kre-support-link" data-ps="src/pages/vehicle-patrol.astro:b2qvaz">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki1r">◇</span>
                <span data-ps="src/pages/vehicle-patrol.astro:baki1s">
                  <strong>Act 67 Training</strong>
                  <small>School security training and certification</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki1t">↗</span>
              </a>
              <a href="/first-aid-training/" class="kre-support-link" data-ps="src/pages/vehicle-patrol.astro:b2qvb0">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki1u">+</span>
                <span data-ps="src/pages/vehicle-patrol.astro:baki1v">
                  <strong>First Aid Training</strong>
                  <small>Explore our first aid training programs</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki1w">↗</span>
              </a>
              <a href="tel:610-562-0971" class="kre-support-link" data-ps="src/pages/vehicle-patrol.astro:b2qvb1">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki1x">◷</span>
                <span data-ps="src/pages/vehicle-patrol.astro:baki1y">
                  <strong>24-hour emergency dispatch</strong>
                  <small>610-562-0971</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki1z">↗</span>
              </a>
              <a href="/employment/" class="kre-support-link" data-ps="src/pages/vehicle-patrol.astro:b2qvb2">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:baki20">+</span>
                <span data-ps="src/pages/vehicle-patrol.astro:8su26x">
                  <strong>KRE Job Openings</strong>
                  <small>Explore careers with KRE Security</small>
                </span>
                <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/vehicle-patrol.astro:8su26w">↗</span>
              </a>
            </div>
            <p class="kre-support-note" data-ps="src/pages/vehicle-patrol.astro:fx11wt">Your total security professional.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- CONTENT SECTION -->
    <section class="bg-surface py-20" data-ps="src/pages/vehicle-patrol.astro:8x6iof">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/vehicle-patrol.astro:kk0a0">
        <!-- Division banner card -->
        <div class="mb-20" data-ps="src/pages/vehicle-patrol.astro:kk0a1">
          <div class="bg-dark-background p-8 lg:p-12 tactical-frame" data-ps="src/pages/vehicle-patrol.astro:kk0a2">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/vehicle-patrol.astro:fx11ws">
              [ Marked Security Patrol Vehicles Division ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-dark-foreground mb-4 text-3xl sm:text-4xl lg:text-[40px] leading-[1.1]" data-ps="src/pages/vehicle-patrol.astro:kwk3es">
              KRE Security Vehicle Patrol Division
            </h2>
            <p class="text-dark-muted-foreground text-sm leading-relaxed max-w-3xl" data-ps="src/pages/vehicle-patrol.astro:fx11w6">
              KRE provides a custom patrol service based on the client's needs and venue. Our fleet is fully insured and licensed for vehicle use at facility grounds. Each vehicle is configured and equipped to meet the operational demands of the client's site.
            </p>
          </div>
        </div>

        <!-- Fleet overview -->
        <div class="mb-20" data-ps="src/pages/vehicle-patrol.astro:kk0a3">
          <div class="text-center mb-12" data-ps="src/pages/vehicle-patrol.astro:kk0a4">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/vehicle-patrol.astro:fx11w5">
              [ Fleet Options ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-foreground text-3xl sm:text-4xl lg:text-[42px] leading-[1.1]" data-ps="src/pages/vehicle-patrol.astro:kwk3et">
              Vehicle Fleet Overview
            </h2>
          </div>
          <div class="grid md:grid-cols-2 gap-6" data-ps="src/pages/vehicle-patrol.astro:kk0a5">
            <div class="tactical-frame bg-background p-6" data-ps="src/pages/vehicle-patrol.astro:kk0a6">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/vehicle-patrol.astro:fx11w4">
                [ Marked Fleet ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/vehicle-patrol.astro:68566i">
                Marked Patrol Vehicles
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/vehicle-patrol.astro:fx11w3">
                High-visibility branded patrol vehicles providing a deterrent presence and active patrol of client facilities. Fully insured and licensed for facility grounds.
              </p>
            </div>
            <div class="tactical-frame bg-background p-6" data-ps="src/pages/vehicle-patrol.astro:kk0a7">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/vehicle-patrol.astro:fx11w2">
                [ Covert Fleet ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/vehicle-patrol.astro:68566j">
                Unmarked / Covert Vehicles
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/vehicle-patrol.astro:fx11w1">
                Discreet, unmarked patrol vehicles for covert surveillance and undercover security operations — indistinguishable from standard civilian vehicles.
              </p>
            </div>
            <div class="tactical-frame bg-background p-6" data-ps="src/pages/vehicle-patrol.astro:kk0a8">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/vehicle-patrol.astro:fx11w0">
                [ All-Terrain ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/vehicle-patrol.astro:68566k">
                4x4 &amp; All-Wheel Drive
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/vehicle-patrol.astro:fx11vz">
                4x4 and all-wheel drive capable vehicles can be stationed for the client's specific environmental needs, including off-road and challenging terrain environments.
              </p>
            </div>
            <div class="tactical-frame bg-background p-6" data-ps="src/pages/vehicle-patrol.astro:kk0a9">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/vehicle-patrol.astro:fx11vy">
                [ Venue Specific ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/vehicle-patrol.astro:685676">
                Security Patrol Golf Carts
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/vehicle-patrol.astro:fx11vx">
                Golf carts can be utilized on venue-specific areas, offering a cost savings for the facility. Available during warmer conditions and marked for visibility. Can reduce fuel expenses at facilities.
              </p>
            </div>
          </div>
        </div>

        <!-- Equipment standard loadout & custom configuration -->
        <div class="grid lg:grid-cols-2 gap-16 items-start mb-20" data-ps="src/pages/vehicle-patrol.astro:kk0av">
          <div data-ps="src/pages/vehicle-patrol.astro:kk0aw">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/vehicle-patrol.astro:fx11vb">
              [ Standard Loadout ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-foreground mb-6 text-3xl sm:text-4xl leading-[1.1]" data-ps="src/pages/vehicle-patrol.astro:kwk3eu">
              Each Vehicle is Equipped With:
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-ps="src/pages/vehicle-patrol.astro:kk0ax">
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:kk0ay">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su26v"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su26u">Flashlight</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:kk0az">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su26t"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su26s">Spot Lights</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:kk0b0">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su26r"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su26q">Guard Accountability Wand</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:kk0b1">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su26p"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su26o">Incident and Daily Reports</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:kk0b2">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su262"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su261">Medical Response Bag</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:kk0b3">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su260"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su25z">Jumper Cables</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:kk0b4">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su25y"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su25x">KRE and Client Vehicle Policy</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:tt00u0">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su25w"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su25v">Vehicle Log</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:tt00u1">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su25u"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su25t">Traffic Safety Cones</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:tt00u2">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su257"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su256">AAA Membership</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:tt00u3">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su255"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su254">Traffic Hand Wand</span>
              </div>
              <div class="flex items-start gap-3 tactical-frame bg-background p-3" data-ps="src/pages/vehicle-patrol.astro:tt00u4">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/vehicle-patrol.astro:8su253"></span>
                <span class="text-muted-foreground text-xs leading-tight font-medium" data-ps="src/pages/vehicle-patrol.astro:8su252">UHF or VHF Radio (Programmable to client sites)</span>
              </div>
            </div>
          </div>

          <div class="space-y-4" data-ps="src/pages/vehicle-patrol.astro:tt00u5">
            <div class="border border-border bg-background p-5" data-ps="src/pages/vehicle-patrol.astro:tt00u6">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/vehicle-patrol.astro:fx11va">
                [ Custom Configuration ]
              </p>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/vehicle-patrol.astro:fx11v9">
                KRE provides a custom patrol service based on the client's needs and venue. Each assignment is assessed and the appropriate vehicle type is assigned.
              </p>
            </div>
            <div class="border border-border bg-background p-5" data-ps="src/pages/vehicle-patrol.astro:tt00u7">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/vehicle-patrol.astro:fx11v8">
                [ UHF / VHF Radio ]
              </p>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/vehicle-patrol.astro:fx11v7">
                All patrol vehicles are equipped with UHF or VHF radios programmable to the client's specific site frequencies for seamless communication.
              </p>
            </div>
            <div class="border border-border bg-background p-5" data-ps="src/pages/vehicle-patrol.astro:tt00u8">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/vehicle-patrol.astro:fx11v6">
                [ Golf Cart Option ]
              </p>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/vehicle-patrol.astro:fx11v5">
                Golf Carts can be discussed to reduce fuel expenses at facilities. Available and marked during warmer conditions for venue-specific areas.
              </p>
            </div>
          </div>
        </div>

        <!-- Bottom CTA -->
        <div class="text-center" data-ps="src/pages/vehicle-patrol.astro:tt00u9">
          <a
            href="/contact/"
            class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-10 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Contact Us Today to Get Started
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-dot {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-flex;
  }
  .status-dot::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .tactical-frame {
    border: 1px solid var(--color-border);
    position: relative;
  }
  .tactical-frame::before {
    content: '';
    border-top: 3px solid var(--color-primary);
    border-left: 3px solid var(--color-primary);
    width: 12px;
    height: 12px;
    position: absolute;
    top: -2px;
    left: -2px;
  }
  .tactical-frame::after {
    content: '';
    border-bottom: 3px solid var(--color-primary);
    border-right: 3px solid var(--color-primary);
    width: 12px;
    height: 12px;
    position: absolute;
    bottom: -2px;
    right: -2px;
  }
  .bg-dark-background.tactical-frame,
  .bg-dark-background .tactical-frame {
    border-color: var(--color-dark-border);
  }

  .kre-support {
    --panel-gold: #dba400;
    color: rgb(250, 250, 250);
    background: #102032;
    border: 1px solid rgba(219, 171, 0, 0.25);
    border-radius: 20px;
    justify-self: end;
    width: 100%;
    max-width: 520px;
    padding: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }
  .kre-support-heading {
    text-align: left;
    grid-template-columns: 76px minmax(0px, 1fr);
    align-items: stretch;
    gap: 24px;
    margin-bottom: 22px;
    display: grid;
  }
  .kre-support-brand {
    position: relative;
    width: 76px;
    height: 76px;
  }
  .kre-support-brand img {
    object-fit: contain;
    object-position: left center;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0px;
  }
  .kre-support-heading-copy {
    min-width: 0;
  }
  .kre-panel-label {
    display: block;
    color: #dba400;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.28px;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .kre-support-heading-copy h2 {
    color: #fafafa;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-family: var(--font-heading);
    margin-bottom: 4px;
  }
  .kre-support-heading-copy p {
    color: var(--color-dark-muted-foreground);
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .kre-status {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #dba400;
  }
  .kre-support-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 18px;
  }
  .kre-support-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.086);
    border-radius: 12px;
    text-decoration: none;
    color: #fafafa;
    transition: all 0.2s ease;
  }
  .kre-support-link:hover {
    background: rgba(219, 164, 0, 0.06);
    border-color: rgba(219, 164, 0, 0.5);
  }
  .kre-support-link > span:nth-child(2) {
    flex: 1;
    min-width: 0;
  }
  .kre-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
