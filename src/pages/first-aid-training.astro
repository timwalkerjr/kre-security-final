            <a
              href="/contact/"
              class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 text-center transition-colors duration-150 border-primary text-primary hover:bg-primary hover:text-primary-foreground"
             data-ps="src/pages/first-aid-training.astro:o8zb2d">
              Contact Us Today to Get Started
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import 'altcha';

    const form = document.getElementById('training-quote-form') as HTMLFormElement | null;
    const status = document.getElementById('first-aid-status') as HTMLDivElement | null;
    const submitBtn = document.getElementById('fa-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !status) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const formData = new FormData(form);
      const firstName = formData.get('first_name') as string || '';
      const lastName = formData.get('last_name') as string || '';
      const fullName = [firstName, lastName].filter(Boolean).join(' ');

      try {
        const response = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _formId: formData.get('_formId'),
            name: fullName || undefined,
            first_name: firstName,
            last_name: lastName,
            phone: formData.get('phone'),
            email: formData.get('email'),
            message: formData.get('message'),
            subject: formData.get('subject'),
            altcha: formData.get('altcha'),
          }),
        });

        const result = await response.json();

        if (result.success) {
          status.className = 'mb-6 px-4 py-3 rounded-md text-sm bg-green-950/80 border border-green-700 text-green-200';
          status.textContent = 'Thank you! Your quote request has been sent. We will contact you shortly.';
          form.reset();
        } else {
          throw new Error(result.error || 'Failed to send quote request');
        }
      } catch (err) {
        status.className = 'mb-6 px-4 py-3 rounded-md text-sm bg-red-950/80 border border-red-700 text-red-200';
        status.textContent = err instanceof Error ? err.message : 'Failed to send. Please try again or call us directly.';
      } finally {
        status.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    });
  </script>
</BaseLayout>
