                    &diamondsuit;
                  </span>
                  <div data-ps="src/pages/first-aid-training.astro:316z2q">
                    <strong class="block text-sm font-semibold text-white group-hover:text-primary transition-colors">
                      Act 67 Training
                    </strong>
                    <small class="block text-xs text-dark-muted-foreground">
                      School security training and certification
                    </small>
                  </div>
                </div>
                <span class="text-primary text-base font-bold flex-shrink-0" data-ps="src/pages/first-aid-training.astro:wa48ex">&nearr;</span>
              </a>

              <a
                href="/first-aid-training/"
                class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.086] hover:bg-white/[0.05] hover:border-primary/40 transition-colors group"
               data-ps="src/pages/first-aid-training.astro:o8zb27">
                <div class="flex items-center gap-3" data-ps="src/pages/first-aid-training.astro:316z2p">
                  <span class="w-8 h-8 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" data-ps="src/pages/first-aid-training.astro:wa48ew">
                    +
                  </span>
                  <div data-ps="src/pages/first-aid-training.astro:316z23">
                    <strong class="block text-sm font-semibold text-white group-hover:text-primary transition-colors">
                      First Aid Training
                    </strong>
                    <small class="block text-xs text-dark-muted-foreground">
                      Explore our first aid training programs
                    </small>
                  </div>
                </div>
                <span class="text-primary text-base font-bold flex-shrink-0" data-ps="src/pages/first-aid-training.astro:wa48ev">&nearr;</span>
              </a>

              <a
