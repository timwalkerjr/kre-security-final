              <li class="flex items-center gap-3 border border-border p-3 bg-background" data-ps="src/pages/first-aid-training.astro:n4jdfz">
                <span class="w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/first-aid-training.astro:wa48ep"></span>
                <span class="font-display font-bold text-sm uppercase tracking-wide text-foreground" data-ps="src/pages/first-aid-training.astro:wa48e3">Heartsaver First Aid</span>
              </li>
              <li class="flex items-center gap-3 border border-border p-3 bg-background" data-ps="src/pages/first-aid-training.astro:n4jdfy">
