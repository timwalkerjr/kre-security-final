              <p class="text-xs font-display font-bold uppercase tracking-widest mb-4 text-primary" data-ps="src/pages/first-aid-training.astro:onoj4f">
                [ Approved By ]
              </p>
              <div class="flex flex-wrap gap-6 items-center" data-ps="src/pages/first-aid-training.astro:316z1v">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc-mv2-110-474ca0-110.webp"
                  alt="American Red Cross training"
                  class="h-10 w-auto object-contain"
                  loading="eager" data-ps="src/pages/first-aid-training.astro:5jg3f9" />
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_83d9d70bec11400db248ad3e6c07da4b-mv2-ba4c58.gif"
                  alt="American Heart Association training"
                  class="h-10 w-auto object-contain"
                  loading="eager" data-ps="src/pages/first-aid-training.astro:5jg3f8" />
              </div>
              <p class="text-sm mt-4 leading-relaxed text-dark-muted-foreground" data-ps="src/pages/first-aid-training.astro:onoj3t">
                Courses approved by the American Heart Association and American Red Cross for healthcare providers and lay rescuers.
              </p>
            </div>

            <div class="border-l-2 pl-4 border-primary" data-ps="src/pages/first-aid-training.astro:316z1u">
