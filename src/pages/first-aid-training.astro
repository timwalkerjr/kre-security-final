                <span class="font-display font-bold text-sm uppercase tracking-wide text-foreground" data-ps="src/pages/first-aid-training.astro:wa48dx">BLS for the Healthcare Provider</span>
              </li>
              <li class="flex items-center gap-3 border border-border p-3 bg-background" data-ps="src/pages/first-aid-training.astro:n4jdfa">
                <span class="w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/first-aid-training.astro:wa48dw"></span>
                <span class="font-display font-bold text-sm uppercase tracking-wide text-foreground" data-ps="src/pages/first-aid-training.astro:wa48dv">Heartsaver Bloodborne Pathogens</span>
              </li>
              <li class="flex items-center gap-3 border border-border p-3 bg-background" data-ps="src/pages/first-aid-training.astro:n4jdf9">
                <span class="w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/first-aid-training.astro:wa48du"></span>
                <span class="font-display font-bold text-sm uppercase tracking-wide text-foreground" data-ps="src/pages/first-aid-training.astro:wa48d8">Pediatric First Aid</span>
