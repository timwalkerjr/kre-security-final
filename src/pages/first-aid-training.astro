                <li data-ps="src/pages/first-aid-training.astro:n4jdf8">&bull; In-classroom instruction on basic fire extinguisher use and operation</li>
                <li data-ps="src/pages/first-aid-training.astro:n4jdf7">&bull; Blood Borne Pathogens training per OSHA standard 1910.1030</li>
              </ul>
            </div>
          </div>

          <!-- Right Col: Service Locations & Info -->
          <div class="flex flex-col gap-6" data-ps="src/pages/first-aid-training.astro:316z13">
            <div data-ps="src/pages/first-aid-training.astro:316z12">
              <div class="mb-3" data-ps="src/pages/first-aid-training.astro:316z11">
