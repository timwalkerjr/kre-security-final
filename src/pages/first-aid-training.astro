---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'CPR, First Aid & AED Training in PA | KRE Security';
const pageDescription = 'Arrange CPR, first aid, and AED training with KRE Security for your Pennsylvania business, facility, or group. Explore courses and request training.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  headerVariant="transparent"
>
  <main data-ps="src/pages/first-aid-training.astro:jo754t">
    <!-- Hero Section -->
    <section id="first-aid-hero" class="bg-dark-background py-20 lg:py-28" data-ps="src/pages/first-aid-training.astro:kwdzt8">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/first-aid-training.astro:316z3l">
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/first-aid-training.astro:316z3k">
          <div data-ps="src/pages/first-aid-training.astro:316z2y">
            <div class="mb-6" data-ps="src/pages/first-aid-training.astro:316z2x">
              <span class="text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/first-aid-training.astro:wa48fm">
                [ Certification Programs: Active ]
              </span>
            </div>
            <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 text-h1 leading-[1.05]" data-ps="src/pages/first-aid-training.astro:hrkap4">
              First Aid, CPR<br />&amp; AED Training
            </h1>
            <p class="text-lg text-dark-muted-foreground leading-relaxed mb-8" data-ps="src/pages/first-aid-training.astro:onoj4j">
              KRE Security LLC. offers custom based CPR/First Aid and AED Training for your business, facility, or civic and private groups. We can get you or your group certified!
            </p>
            <p class="text-dark-muted-foreground text-base mb-6" data-ps="src/pages/first-aid-training.astro:onoj4i">
              Explore training with <a href="https://www.easternpaeducators.com/" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4 hover:text-primary-hover transition-colors" data-ps="src/pages/first-aid-training.astro:o8zb1i">Eastern PA Educators &rarr;</a>
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/first-aid-training.astro:316z2w">
              <a
                href="#first-aid-form"
                class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150 border-primary bg-primary text-primary-foreground hover:bg-primary-hover hover:border-primary-hover"
               data-ps="src/pages/first-aid-training.astro:o8zb1j">
                Request a Training Quote
              </a>
              <a
                href="tel:6105620971"
                class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-6 py-3 transition-colors duration-150 border-dark-border text-dark-foreground hover:border-primary hover:text-primary"
               data-ps="src/pages/first-aid-training.astro:o8zb1k">
                610-562-0971
              </a>
            </div>
          </div>

          <!-- Support Sidebar Card -->
          <aside class="p-6 lg:p-8 rounded-[20px] bg-dark-surface border border-primary/25 relative" aria-labelledby="support-title" data-ps="src/pages/first-aid-training.astro:4ojqfs">
            <div class="flex items-center gap-4 mb-6" data-ps="src/pages/first-aid-training.astro:316z2v">
              <div class="w-12 h-14 flex-shrink-0" data-ps="src/pages/first-aid-training.astro:316z2u">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="1024"
                  height="1226"
                  class="w-full h-full object-contain" data-ps="src/pages/first-aid-training.astro:5jg3fv" />
              </div>
              <div data-ps="src/pages/first-aid-training.astro:316z2t">
