                </div>
                <div class="border border-border px-3 py-2 text-center bg-background" data-ps="src/pages/first-aid-training.astro:316z07">
                  <span class="text-xs font-display font-bold uppercase tracking-wide text-foreground" data-ps="src/pages/first-aid-training.astro:wa48cz">Pottstown</span>
