            <div id="first-aid-status" class="hidden mb-6 px-4 py-3 rounded-md text-sm" data-ps="src/pages/first-aid-training.astro:316yzb"></div>

            <form id="training-quote-form" class="space-y-4">
              <input type="hidden" name="_formId" value="first-aid-training" />
              <input type="hidden" name="subject" value="KRE Security — First Aid Training Inquiry" />

              <div class="grid sm:grid-cols-2 gap-4" data-ps="src/pages/first-aid-training.astro:316yza">
                <div data-ps="src/pages/first-aid-training.astro:316yz9">
                  <label for="fa-first-name" class="block text-xs font-display font-bold uppercase tracking-widest text-dark-muted-foreground mb-1" data-ps="src/pages/first-aid-training.astro:a9plcx">
                    First Name *
                  </label>
                  <input
                    type="text"
                    id="fa-first-name"
                    name="first_name"
                    required
                    class="w-full border border-dark-border px-4 py-3 text-sm font-sans bg-secondary text-dark-foreground focus:outline-none focus:border-primary transition-colors"
                  />
                </div>
                <div data-ps="src/pages/first-aid-training.astro:pavuv7">
                  <label for="fa-last-name" class="block text-xs font-display font-bold uppercase tracking-widest text-dark-muted-foreground mb-1" data-ps="src/pages/first-aid-training.astro:a9plcw">
                    Last Name
                  </label>
                  <input
                    type="text"
                    id="fa-last-name"
                    name="last_name"
                    class="w-full border border-dark-border px-4 py-3 text-sm font-sans bg-secondary text-dark-foreground focus:outline-none focus:border-primary transition-colors"
                  />
                </div>
              </div>

              <div data-ps="src/pages/first-aid-training.astro:pavuv6">
                <label for="fa-phone" class="block text-xs font-display font-bold uppercase tracking-widest text-dark-muted-foreground mb-1" data-ps="src/pages/first-aid-training.astro:a9plcv">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="fa-phone"
                  name="phone"
                  class="w-full border border-dark-border px-4 py-3 text-sm font-sans bg-secondary text-dark-foreground focus:outline-none focus:border-primary transition-colors"
                />
              </div>

              <div data-ps="src/pages/first-aid-training.astro:pavuv5">
                <label for="fa-email" class="block text-xs font-display font-bold uppercase tracking-widest text-dark-muted-foreground mb-1" data-ps="src/pages/first-aid-training.astro:a9plcu">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="fa-email"
                  name="email"
                  required
                  class="w-full border border-dark-border px-4 py-3 text-sm font-sans bg-secondary text-dark-foreground focus:outline-none focus:border-primary transition-colors"
                />
              </div>

              <div data-ps="src/pages/first-aid-training.astro:pavuv4">
                <label for="fa-message" class="block text-xs font-display font-bold uppercase tracking-widest text-dark-muted-foreground mb-1">
                  Message
                </label>
                <textarea
                  id="fa-message"
                  name="message"
                  rows="4"
                  class="w-full border border-dark-border px-4 py-3 text-sm font-sans bg-secondary text-dark-foreground focus:outline-none focus:border-primary transition-colors resize-none"
                ></textarea>
              </div>

              <altcha-widget
                challenge="/psapi-internal-v1/altcha/challenge"
                display="invisible"
                auto="onfocus"
              ></altcha-widget>

              <button
                type="submit"
                id="fa-submit"
                class="w-full border-2 font-display font-bold uppercase tracking-wider text-sm px-8 py-3 transition-colors duration-150 border-primary bg-primary text-primary-foreground hover:bg-primary-hover hover:border-primary-hover cursor-pointer"
