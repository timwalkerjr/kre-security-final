---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seoTitle = "Security Guard Services in Pennsylvania | KRE Security";
const seoDescription = "KRE Security offers armed and unarmed security guards for businesses, private events, and public venues across Pennsylvania. Discuss your staffing needs.";
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  headerVariant="transparent"
>
  <main data-ps="src/pages/security-guards-pa.astro:nbh2u4">
    {/* Hero Section */}
    <section class="bg-dark-background pt-28 pb-20 lg:pt-36 lg:pb-24" data-ps="src/pages/security-guards-pa.astro:uhd9jh">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/security-guards-pa.astro:i52cd5">
        <div class="flex items-center gap-3 mb-6" data-ps="src/pages/security-guards-pa.astro:i52cd4">
          <span class="status-dot font-heading font-bold text-xs tracking-[1.2px] text-primary uppercase" data-ps="src/pages/security-guards-pa.astro:jwz71f">
            [ Guard Pro Accountability System Active ]
          </span>
        </div>

        <div class="grid lg:grid-cols-12 gap-12 items-center" data-ps="src/pages/security-guards-pa.astro:i52cci">
          <div class="lg:col-span-7" data-ps="src/pages/security-guards-pa.astro:i52cch">
            <h1 class="font-heading font-bold uppercase tracking-tight text-dark-foreground text-h1 leading-[1.05] mb-6" data-ps="src/pages/security-guards-pa.astro:4o0r27">
              Security Guard Services Eastern Pennsylvania
            </h1>
            <p class="text-dark-muted-foreground text-base leading-relaxed mb-4 max-w-xl" data-ps="src/pages/security-guards-pa.astro:wbde4i">
              KRE Security LLC. provides a variety of both public and private event, unarmed or armed security guard services across Pennsylvania. We provide short term, long term, and permanent security guard services to our clients 24/7.
            </p>
            <p class="text-dark-muted-foreground text-sm leading-relaxed mb-8 max-w-xl" data-ps="src/pages/security-guards-pa.astro:wbde4j">
              Our security officers provide a public security presence which allows our customers the peace of mind knowing that their property is protected at all hours.
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/security-guards-pa.astro:i52ccg">
              <a
                href="/contact/"
                class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
               data-ps="src/pages/security-guards-pa.astro:vlsr7a">
                Contact Us Today
              </a>
              <a
                href="/armed-security-pa/"
                class="inline-block bg-transparent text-dark-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
               data-ps="src/pages/security-guards-pa.astro:vlsr79">
                Armed Security
              </a>
            </div>
          </div>

          <aside class="lg:col-span-5 kre-support" aria-labelledby="support-title" data-ps="src/pages/security-guards-pa.astro:l1hdqn">
            <div class="kre-support-heading flex items-center gap-4 mb-6" data-ps="src/pages/security-guards-pa.astro:i52ccf">
              <div class="kre-support-brand w-16 h-16 flex-shrink-0" data-ps="src/pages/security-guards-pa.astro:i52cce">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="1024"
                  height="1226"
                  class="w-full h-full object-contain" data-ps="src/pages/security-guards-pa.astro:knbgpg" />
              </div>
              <div class="kre-support-heading-copy" data-ps="src/pages/security-guards-pa.astro:i52ccd">
                <span class="kre-panel-label block text-xs uppercase font-bold tracking-[1.28px] text-primary mb-1" data-ps="src/pages/security-guards-pa.astro:jwz71e">
                  KRE SECURITY, LLC
                </span>
                <h2 id="support-title" class="font-heading font-bold text-2xl lg:text-[28px] text-white tracking-[-0.84px] leading-tight" data-ps="src/pages/security-guards-pa.astro:a0e65h">
                  How can we help?
                </h2>
                <p class="text-dark-muted-foreground text-xs lg:text-sm flex items-center gap-2 mt-1" data-ps="src/pages/security-guards-pa.astro:wbde4k">
                  <span class="kre-status w-2 h-2 rounded-full bg-primary inline-block" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz71d"></span>
                  24-hour emergency dispatch
                </p>
              </div>
            </div>

            <div class="kre-support-links space-y-3" data-ps="src/pages/security-guards-pa.astro:i52ccc">
              <a href="/act-67-certified-services/" class="kre-support-link group" data-ps="src/pages/security-guards-pa.astro:vlsr78">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz71c">◇</span>
                <span class="flex-1 min-w-0" data-ps="src/pages/security-guards-pa.astro:jwz71b">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">Act 67 Training</strong>
                  <small class="block text-xs text-dark-muted-foreground">School security training and certification</small>
                </span>
                <span class="kre-arrow text-primary text-sm font-bold" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz71a">↗</span>
              </a>

              <a href="/first-aid-training/" class="kre-support-link group" data-ps="src/pages/security-guards-pa.astro:vlsr77">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz719">+</span>
                <span class="flex-1 min-w-0" data-ps="src/pages/security-guards-pa.astro:jwz718">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">First Aid Training</strong>
                  <small class="block text-xs text-dark-muted-foreground">Explore our first aid training programs</small>
                </span>
                <span class="kre-arrow text-primary text-sm font-bold" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz717">↗</span>
              </a>

              <a href="tel:610-562-0971" class="kre-support-link group" data-ps="src/pages/security-guards-pa.astro:vlsr76">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz70l">◷</span>
                <span class="flex-1 min-w-0" data-ps="src/pages/security-guards-pa.astro:jwz70k">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">24-hour emergency dispatch</strong>
                  <small class="block text-xs text-dark-muted-foreground">610-562-0971</small>
                </span>
                <span class="kre-arrow text-primary text-sm font-bold" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz70j">↗</span>
              </a>

              <a href="/employment/" class="kre-support-link group" data-ps="src/pages/security-guards-pa.astro:vlsr6k">
                <span class="kre-icon" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz70i">+</span>
                <span class="flex-1 min-w-0" data-ps="src/pages/security-guards-pa.astro:jwz70h">
                  <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">KRE Job Openings</strong>
                  <small class="block text-xs text-dark-muted-foreground">Explore careers with KRE Security</small>
                </span>
                <span class="kre-arrow text-primary text-sm font-bold" aria-hidden="true" data-ps="src/pages/security-guards-pa.astro:jwz70g">↗</span>
              </a>
            </div>

            <p class="kre-support-note text-center text-xs text-dark-muted-foreground mt-6 pt-4 border-t border-white/10" data-ps="src/pages/security-guards-pa.astro:wbde4l">
              Your total security professional.
            </p>
          </aside>
        </div>
      </div>
    </section>

    {/* Benefits of Outsourcing Section */}
    <section class="bg-surface py-20" data-ps="src/pages/security-guards-pa.astro:uhd9ji">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/security-guards-pa.astro:i52ccb">
        <div class="mb-20" data-ps="src/pages/security-guards-pa.astro:i52cca">
          <div class="text-center mb-12" data-ps="src/pages/security-guards-pa.astro:i52cc9">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/security-guards-pa.astro:wbde4m">
              [ Why Outsource? ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-foreground text-h2 leading-tight" data-ps="src/pages/security-guards-pa.astro:a0e65g">
              Benefits of Outsourcing Security Guard Services
            </h2>
          </div>

          <div class="grid md:grid-cols-2 gap-6" data-ps="src/pages/security-guards-pa.astro:i52cbn">
            <div class="tactical-frame bg-background p-7" data-ps="src/pages/security-guards-pa.astro:i52cbm">
              <span class="text-primary font-heading font-bold text-3xl block mb-3" data-ps="src/pages/security-guards-pa.astro:jwz70f">01</span>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-guards-pa.astro:oot3dq">
                Focus on What You Do Best
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-guards-pa.astro:wbde4n">
                When you leave the security function up to someone else, you and your company can concentrate your resources on the business. Having a security guard company control the security duties, you can get back to taking care of your customers.
              </p>
            </div>

            <div class="tactical-frame bg-background p-7" data-ps="src/pages/security-guards-pa.astro:i52cbl">
              <span class="text-primary font-heading font-bold text-3xl block mb-3" data-ps="src/pages/security-guards-pa.astro:jwz70e">02</span>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-guards-pa.astro:oot3d4">
                Leave It to the Experts
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-guards-pa.astro:wbde4o">
                By contracting our security guard service, you can rest assured that we have invested copious amounts of time training our staff, researching the best equipment to use, and making sure all of our (and your) bases are covered.
              </p>
            </div>

            <div class="tactical-frame bg-background p-7" data-ps="src/pages/security-guards-pa.astro:i52cbk">
              <span class="text-primary font-heading font-bold text-3xl block mb-3" data-ps="src/pages/security-guards-pa.astro:jwz70d">03</span>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-guards-pa.astro:oot3d3">
                Free Up Your Resources
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-guards-pa.astro:wbde4p">
                Outsourcing the security function of your company will allow you to free up your personnel that are serving this duty to perform other, potentially more important, actions. Keep your focus on efficiency of your process, customer service and the final product.
              </p>
            </div>

            <div class="tactical-frame bg-background p-7" data-ps="src/pages/security-guards-pa.astro:i52cbj">
              <span class="text-primary font-heading font-bold text-3xl block mb-3" data-ps="src/pages/security-guards-pa.astro:jwz70c">04</span>
              <h3 class="font-heading font-bold uppercase text-foreground text-base mb-3" data-ps="src/pages/security-guards-pa.astro:oot3d2">
                Reduce Risk
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-guards-pa.astro:wbde5b">
                Once a contract is signed, we are accountable for the security of your company and/or the details outlined in the contract. Breathe a sigh of relief when that worry is off your plate and know you are in good hands.
              </p>
            </div>
          </div>
        </div>

        {/* Guard Pro System Box */}
        <div class="bg-dark-background p-8 lg:p-12 tactical-frame mb-20" data-ps="src/pages/security-guards-pa.astro:i52cbi">
          <div class="grid lg:grid-cols-2 gap-10 items-center" data-ps="src/pages/security-guards-pa.astro:i52cbh">
            <div data-ps="src/pages/security-guards-pa.astro:i52cbg">
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/security-guards-pa.astro:wbde5c">
                [ KRE Accountability Technology ]
              </p>
              <h2 class="font-heading font-bold uppercase tracking-tight text-dark-foreground text-h2 leading-tight mb-4" data-ps="src/pages/security-guards-pa.astro:a0e65f">
                The Guard Pro System
              </h2>
              <p class="text-dark-muted-foreground text-sm leading-relaxed mb-4" data-ps="src/pages/security-guards-pa.astro:wbde5d">
                The Guard Pro System insures quality control and accountability of the guards and the client that their needs are being met by our security guard professionals.
              </p>
              <p class="text-dark-muted-foreground text-sm leading-relaxed mb-4" data-ps="src/pages/security-guards-pa.astro:wbde5e">
                Guard Pro systems allow our managers to meet with both the client and the security guard to ensure proper rounds are conducted at each shift. KRE managers will provide written reports to the client in order to provide better manager-client relations.
              </p>
              <p class="text-dark-muted-foreground text-sm leading-relaxed" data-ps="src/pages/security-guards-pa.astro:wbde5f">
                This is part of KRE Security's customer service satisfaction guarantee. We are willing to meet any needs that the client may have while knowing their property is protected.
              </p>
            </div>

            <div class="space-y-4" data-ps="src/pages/security-guards-pa.astro:i52cbf">
              <p class="text-dark-muted-foreground text-sm leading-relaxed border-l-2 border-primary pl-4" data-ps="src/pages/security-guards-pa.astro:wbde5g">
                Our security guard service staff maintains a professional demeanor at all times. Our officers hold current emergency services training, such as CPR and First Aid.
              </p>
              <p class="text-dark-muted-foreground text-sm leading-relaxed border-l-2 border-primary pl-4" data-ps="src/pages/security-guards-pa.astro:wbde5h">
                KRE Security officers have an ongoing relationship with local level police, fire and EMS agencies throughout the area.
              </p>
              <p class="text-dark-muted-foreground text-sm leading-relaxed border-l-2 border-primary pl-4" data-ps="src/pages/security-guards-pa.astro:wbde5i">
                KRE Security employs top quality security professionals who have extensive experience working in the criminal and public safety fields.
              </p>
            </div>
          </div>
        </div>

        {/* Full Spectrum Coverage Services List */}
        <div class="mb-20" data-ps="src/pages/security-guards-pa.astro:i52cbe">
          <div class="text-center mb-12" data-ps="src/pages/security-guards-pa.astro:561hy6">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/security-guards-pa.astro:wbde5j">
              [ Full Spectrum Coverage ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-foreground text-h2 leading-tight" data-ps="src/pages/security-guards-pa.astro:a0e65e">
              Providing Security Guard Services for:
            </h2>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2" data-ps="src/pages/security-guards-pa.astro:561hy5">
            {[
              "Agriculture",
              "Apartment Complexes",
              "Armed/Unarmed Security Guards",
              "Asset Protection",
              "Bar/Nightclub Security",
              "College/Universities",
              "Commercial Real Estate",
              "Construction Security",
              "Distribution Facilities",
              "Energy & Utilities",
              "Emergency Storm Response Security",
              "Facility Security",
              "Film Production Site Security",
              "Fire Watch Security Services",
              "Government Services",
              "Healthcare Facilities",
              "Industrial Park Security (24/7)",
              "Large Event Security",
              "Long Term Contracts",
              "Malls",
              "Manufacturing & Industrial",
              "Mobile Security Patrol",
              "National Security Contracts",
              "Night Watchmen",
              "Office Buildings",
              "On-site Security",
              "Personal Protection",
              "Private Parking Enforcement",
              "Residential Communities",
              "Restaurant Maintenance",
              "Retail Security",
              "School Events",
              "Shopping Centers",
              "Special Event Parking Security",
              "Temporary and Long-term Security",
              "Uniformed Patrol Services",
              "Warehouse Security (24/7)"
            ].map((service, __psIdx) => (
              <div class="flex items-center gap-2.5 border border-border bg-background p-2.5" data-ps={`src/pages/security-guards-pa.astro:561hy4-${__psIdx}`}>
                <span class="w-1.5 h-1.5 bg-primary flex-shrink-0" data-ps={`src/pages/security-guards-pa.astro:jwz6zq-${__psIdx}`}></span>
                <span class="text-muted-foreground text-xs leading-tight" data-ps={`src/pages/security-guards-pa.astro:jwz6zp-${__psIdx}`}>{service}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Gallery Grid */}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-16" data-ps="src/pages/security-guards-pa.astro:561hy3">
          <div class="tactical-frame overflow-hidden bg-background" data-ps="src/pages/security-guards-pa.astro:561hy2">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_57d30354f75c459a8ff7493a8ed2e778-mv2-239-329705-239.webp"
              alt="Security companies in PA"
              class="w-full h-32 object-cover"
              loading="lazy"
              width="239"
              height="128" data-ps="src/pages/security-guards-pa.astro:knbgpf" />
          </div>
          <div class="tactical-frame overflow-hidden bg-background" data-ps="src/pages/security-guards-pa.astro:561hy1">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_6af31e81bf8740d4b966aa8251765f40-mv2-225-50b11a-225.webp"
              alt="Security guard companies in Reading"
              class="w-full h-32 object-cover"
              loading="lazy"
              width="225"
              height="128" data-ps="src/pages/security-guards-pa.astro:knbgot" />
          </div>
          <div class="tactical-frame overflow-hidden bg-background" data-ps="src/pages/security-guards-pa.astro:561hy0">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_0e10faf1585c4f2c8fbd4262dc8e6a54-mv2-225-7bec78-225.webp"
              alt="Armed & unarmed security services Philadelphia PA"
              class="w-full h-32 object-cover"
              loading="lazy"
              width="225"
              height="128" data-ps="src/pages/security-guards-pa.astro:knbgos" />
          </div>
          <div class="tactical-frame overflow-hidden bg-background" data-ps="src/pages/security-guards-pa.astro:561hxz">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_41f7dc4afc7d4747817dba023b4d5ddd-mv2-225-0a7407-225.webp"
              alt="Best private investigator eastern PA"
              class="w-full h-32 object-cover"
              loading="lazy"
              width="225"
              height="128" data-ps="src/pages/security-guards-pa.astro:knbgor" />
          </div>
          <div class="tactical-frame overflow-hidden bg-background" data-ps="src/pages/security-guards-pa.astro:561hxy">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_cdcbaf3497194856a579bc8bfbcfe3c2-mv2-225-4b6cba-225.webp"
              alt="Armed security guard Lehigh Valley"
              class="w-full h-32 object-cover"
              loading="lazy"
              width="225"
              height="128" data-ps="src/pages/security-guards-pa.astro:knbgoq" />
          </div>
        </div>

        {/* Bottom CTA */}
        <div class="text-center" data-ps="src/pages/security-guards-pa.astro:561hxx">
          <a
            href="/contact/"
            class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-10 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
          >
            Contact Us Today to Get Started
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .kre-support {
    background-color: #102032;
    border: 1px solid rgba(219, 171, 0, 0.25);
    border-radius: 20px;
    padding: 2rem;
  }

  .kre-support-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.086);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .kre-support-link:hover {
    background-color: rgba(219, 171, 0, 0.06);
    border-color: rgba(219, 171, 0, 0.4);
    transform: translateX(4px);
  }

  .kre-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9px;
    background-color: rgba(219, 171, 0, 0.094);
    color: var(--color-primary);
    font-size: 1.125rem;
    font-weight: bold;
    flex-shrink: 0;
  }

  /* Tactical corner brackets on all 4 corners */
  .tactical-frame {
    position: relative;
    border: 1px solid var(--color-border);
  }

  .bg-dark-background.tactical-frame {
    border-color: var(--color-dark-border);
  }

  .tactical-frame::before {
    content: '';
    position: absolute;
    inset: -1px;
    pointer-events: none;
    z-index: 2;
    background:
      linear-gradient(to right, var(--color-primary) 8px, transparent 8px) top left / 8px 2px no-repeat,
      linear-gradient(to bottom, var(--color-primary) 8px, transparent 8px) top left / 2px 8px no-repeat,
      linear-gradient(to left, var(--color-primary) 8px, transparent 8px) top right / 8px 2px no-repeat,
      linear-gradient(to bottom, var(--color-primary) 8px, transparent 8px) top right / 2px 8px no-repeat,
      linear-gradient(to right, var(--color-primary) 8px, transparent 8px) bottom left / 8px 2px no-repeat,
      linear-gradient(to top, var(--color-primary) 8px, transparent 8px) bottom left / 2px 8px no-repeat,
      linear-gradient(to left, var(--color-primary) 8px, transparent 8px) bottom right / 8px 2px no-repeat,
      linear-gradient(to top, var(--color-primary) 8px, transparent 8px) bottom right / 2px 8px no-repeat;
  }
</style>
