---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Security Jobs in Pennsylvania | KRE Security";
const description = "Explore full-time, part-time, and seasonal security jobs with KRE Security in Pennsylvania. Learn about our team and submit an employment application.";
---

<BaseLayout
  headerVariant="transparent"
  title={title}
  description={description}
>
  <main data-ps="src/pages/employment.astro:u7kkpt">
    <!-- Hero Section -->
    <section class="bg-dark-background py-20 border-b border-dark-border" data-ps="src/pages/employment.astro:hprv1q">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/employment.astro:lk3819">
        <div class="max-w-3xl" data-ps="src/pages/employment.astro:lk381a">
          <p class="status-dot mb-4" data-ps="src/pages/employment.astro:fiw14f">[ NOW HIRING ACROSS EASTERN PA ]</p>
          <p class="font-heading text-xs uppercase tracking-widest text-primary mb-4" data-ps="src/pages/employment.astro:fiw14g">
            "Your Total Security Professional"
          </p>
          <h1 class="font-heading font-bold uppercase tracking-tight text-dark-foreground text-h1 mb-6" data-ps="src/pages/employment.astro:7muyox">
            Security Company Employment
          </h1>
          <p class="font-sans text-dark-muted-foreground text-lg leading-relaxed" data-ps="src/pages/employment.astro:fiw14h">
            KRE Security LLC. is currently hiring for Full and Part Time Security agents and for Seasonal Security positions across Eastern Pennsylvania.
          </p>
          <div class="flex flex-wrap gap-4 mt-8" data-ps="src/pages/employment.astro:lk381b">
            <a
              href="https://na4.documents.adobe.com/public/esignWidget?wid=CBFCIBAA3AAABLblqZhDVu8TUeWmiMKm9oE1_hjixjqhIuSb3EtQyMD2mPlOX7QUF0PNlNIISYZ0f9woOk40*"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors"
             data-ps="src/pages/employment.astro:8ncazl">
              KRE Online Employment Application
            </a>
            <a
              href="mailto:employment@kresecurity.com"
              class="inline-block bg-transparent text-dark-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors"
             data-ps="src/pages/employment.astro:8ncazk">
              Email Us
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Join Our Team Section -->
    <section class="bg-surface py-20" data-ps="src/pages/employment.astro:hprv1p">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/employment.astro:lk381c">
        <div class="max-w-3xl mb-16" data-ps="src/pages/employment.astro:lk381y">
          <p class="font-heading text-xs uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/employment.astro:fiw14i">
            [ Join Our Team ]
          </p>
          <h2 class="font-heading font-bold uppercase tracking-tight text-foreground text-h2 mb-6" data-ps="src/pages/employment.astro:mb9vx4">
            Join the KRE Security Team
          </h2>
          <div class="space-y-4 font-sans text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/employment.astro:lk381z">
            <p data-ps="src/pages/employment.astro:fiw154">
              KRE Security LLC offers a supplemental benefits package with partial employer contribution to employees who average 30 hours or more per week. We are proud to support the officers who represent our company and the clients we serve.
            </p>
            <p data-ps="src/pages/employment.astro:fiw155">
              As our reputation continues to grow throughout Berks, Lancaster, Lehigh, and Schuylkill Counties and beyond, we are seeking professional security officers who demonstrate strong customer service skills, reliability, and sound security awareness.
            </p>
            <p data-ps="src/pages/employment.astro:fiw156">
              We are currently hiring part-time security officers for weekday, evening, overnight, and weekend shifts. At KRE Security, you're not just another number. As a locally owned company, we take pride in building a team of professionals who support each other and provide exceptional service to our clients.
            </p>
            <p data-ps="src/pages/employment.astro:fiw157">
              Officers may work at a consistent site or multiple client locations, depending on availability and preference. Whether you have prior security experience or are looking to start a new career, we're willing to train the right candidates.
            </p>
            <p class="font-semibold text-foreground" data-ps="src/pages/employment.astro:fiw158">
              Employees working 30+ hours per week who successfully complete our 60-day probationary period are eligible for Capital Blue Cross PPO health insurance with minimal employee contribution.
            </p>
          </div>
        </div>

        <!-- 3 Tactical Frame Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16" data-ps="src/pages/employment.astro:lk3820">
          <!-- Responsibilities -->
          <div class="tactical-frame bg-background p-6" data-ps="src/pages/employment.astro:lk3821">
            <p class="font-heading text-xs uppercase tracking-widest text-primary mb-4" data-ps="src/pages/employment.astro:fiw159">[ Responsibilities ]</p>
            <h3 class="font-heading font-bold text-foreground uppercase text-sm mb-4" data-ps="src/pages/employment.astro:y1f8ua">Typical Responsibilities</h3>
            <ul class="space-y-2">
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9o">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdslc">▸</span> Access control and point-of-entry security
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9n">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdsld">▸</span> Greeting and directing visitors
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9m">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdsle">▸</span> CCTV and camera monitoring
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9l">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdslf">▸</span> Routine security patrols to support site safety
              </li>
            </ul>
          </div>

          <!-- Requirements -->
          <div class="tactical-frame bg-background p-6" data-ps="src/pages/employment.astro:lk3822">
            <p class="font-heading text-xs uppercase tracking-widest text-primary mb-4" data-ps="src/pages/employment.astro:fiw15a">[ Requirements ]</p>
            <h3 class="font-heading font-bold text-foreground uppercase text-sm mb-4" data-ps="src/pages/employment.astro:y1f8ub">Basic Qualifications</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9k">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdslg">▸</span> Stable work history
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9j">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdslh">▸</span> Clean background
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9i">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdsli">▸</span> Valid Pennsylvania Driver's License
              </li>
            </ul>
            <p class="font-heading text-xs uppercase tracking-widest text-primary mb-4 mt-6" data-ps="src/pages/employment.astro:fiw15b">[ Encouraged to Apply ]</p>
            <ul class="space-y-2">
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9h">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdslj">▸</span> Retiree
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy9g">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdslk">▸</span> Law Enforcement
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8u">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:mfdsll">▸</span> Corrections
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8t">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp7e">▸</span> Security
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8s">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp7d">▸</span> Public Safety
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8r">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp7c">▸</span> Veterans
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8q">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp7b">▸</span> College Students
              </li>
            </ul>
          </div>

          <!-- Compensation -->
          <div class="tactical-frame bg-background p-6" data-ps="src/pages/employment.astro:lk3823">
            <p class="font-heading text-xs uppercase tracking-widest text-primary mb-4" data-ps="src/pages/employment.astro:fiw15c">[ Compensation ]</p>
            <h3 class="font-heading font-bold text-foreground uppercase text-sm mb-4" data-ps="src/pages/employment.astro:y1f8uc">Why Work With KRE Security?</h3>
            <ul class="space-y-2">
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8p">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp7a">▸</span> Bi-weekly direct deposit
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8o">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp79">▸</span> Paid uniforms
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8n">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp78">▸</span> Paid training and holiday pay
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8m">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp77">▸</span> Veteran pay differential
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy8l">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp76">▸</span> 24/7 management and staffing support
              </li>
              <li class="flex items-start gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy7z">
                <span class="text-primary mt-0.5 shrink-0" data-ps="src/pages/employment.astro:d0vp75">▸</span> Family-owned company that values its employees
              </li>
            </ul>
          </div>
        </div>

        <!-- 2 Grid Cards: Open Roles & Service Regions -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/employment.astro:lk3824">
          <div class="border border-border bg-background p-6" data-ps="src/pages/employment.astro:lk3825">
            <p class="font-heading text-xs uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/employment.astro:fiw15d">[ Open Roles ]</p>
            <h3 class="font-heading font-bold text-foreground uppercase text-sm mb-4" data-ps="src/pages/employment.astro:y1f8ud">Current Positions</h3>
            <ul class="space-y-2">
              <li class="flex items-center gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy7y">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp6j"></span> Armed Act 235 Security Agent
              </li>
              <li class="flex items-center gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy7x">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp6i"></span> School Security Agent
              </li>
              <li class="flex items-center gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy7w">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp6h"></span> Seasonal Security Agent
              </li>
              <li class="flex items-center gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy7v">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp6g"></span> Retail Security Agent
              </li>
              <li class="flex items-center gap-2 font-sans text-muted-foreground text-sm" data-ps="src/pages/employment.astro:t7fy7u">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp6f"></span> Weekend Commercial Security Agents
              </li>
            </ul>
          </div>

          <div class="border border-border bg-background p-6" data-ps="src/pages/employment.astro:lk3826">
            <p class="font-heading text-xs uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/employment.astro:fiw15z">[ Service Regions ]</p>
            <h3 class="font-heading font-bold text-foreground uppercase text-sm mb-4" data-ps="src/pages/employment.astro:y1f8ue">Areas of Employment</h3>
            <div class="grid grid-cols-2 gap-2" data-ps="src/pages/employment.astro:lk3827">
              <span class="font-sans text-muted-foreground text-sm flex items-center gap-2" data-ps="src/pages/employment.astro:d0vp6e">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp6d"></span> Berks
              </span>
              <span class="font-sans text-muted-foreground text-sm flex items-center gap-2" data-ps="src/pages/employment.astro:d0vp6c">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp6b"></span> Schuylkill
              </span>
