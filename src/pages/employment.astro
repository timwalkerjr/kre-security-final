            <div class="tactical-frame border-dark-border bg-secondary p-6" data-ps="src/pages/employment.astro:vdsfq7">
              <p class="font-heading text-xs uppercase tracking-widest text-primary mb-3" data-ps="src/pages/employment.astro:fiw16u">[ Hiring Office ]</p>
