              <span class="font-sans text-muted-foreground text-sm flex items-center gap-2" data-ps="src/pages/employment.astro:d0vp5n">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp5m"></span> Carbon
              </span>
              <span class="font-sans text-muted-foreground text-sm flex items-center gap-2" data-ps="src/pages/employment.astro:d0vp5l">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp5k"></span> Lancaster
              </span>
              <span class="font-sans text-muted-foreground text-sm flex items-center gap-2" data-ps="src/pages/employment.astro:d0vp5j">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp5i"></span> Lebanon
              </span>
              <span class="font-sans text-muted-foreground text-sm flex items-center gap-2" data-ps="src/pages/employment.astro:d0vp5h">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp5g"></span> Montgomery
              </span>
              <span class="font-sans text-muted-foreground text-sm flex items-center gap-2" data-ps="src/pages/employment.astro:d0vp5f">
                <span class="w-1.5 h-1.5 bg-primary rounded-full shrink-0" data-ps="src/pages/employment.astro:d0vp4t"></span> Pottsville
              </span>
            </div>
            <p class="font-sans text-muted-foreground text-xs mt-4 italic" data-ps="src/pages/employment.astro:fiw160">And many more surrounding counties.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Application / Hiring Office Section -->
    <section class="bg-dark-background py-20" data-ps="src/pages/employment.astro:hprv1o">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/employment.astro:vdsfqf">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start" data-ps="src/pages/employment.astro:vdsfqe">
          <!-- Left: Apply Now -->
          <div data-ps="src/pages/employment.astro:vdsfqd">
