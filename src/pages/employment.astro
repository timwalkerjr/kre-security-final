                <div class="space-y-2 pl-4" data-ps="src/pages/employment.astro:vdsfqa">
                  <p data-ps="src/pages/employment.astro:fiw165"><span class="text-primary font-bold" data-ps="src/pages/employment.astro:d0vp4s">Email:</span> <a href="mailto:employment@kresecurity.com" class="hover:text-primary transition-colors">employment@kresecurity.com</a></p>
