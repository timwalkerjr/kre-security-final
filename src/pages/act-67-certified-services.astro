---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Act 67 School Security Services in PA | KRE Security";
const description = "Explore KRE Security’s Act 67 school security services in Pennsylvania, including trained security personnel and support for protecting students and staff.";

const logoImage = "https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp";
const img2754 = "https://pagesmith-cdn.com/fe6bcc20/images/IMG_2754-320-c67a8e-320.webp";
const imgTraining = "https://pagesmith-cdn.com/fe6bcc20/images/Training-course-320-bd4330-320.webp";
const imgSchool = "https://pagesmith-cdn.com/fe6bcc20/images/Modern-School-Building-320-81d438-320.webp";
const imgClassroom = "https://pagesmith-cdn.com/fe6bcc20/images/Classroom-768-0537b2-768.webp";
---

<BaseLayout
  title={title}
  description={description}
  headerVariant="transparent"
>
  <main data-ps="src/pages/act-67-certified-services.astro:eimogt">
    {/* HERO SECTION */}
    <section class="bg-dark-background pt-32 pb-20 lg:pt-36 lg:pb-24 border-b border-dark-border/40" data-ps="src/pages/act-67-certified-services.astro:p1drn6">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/act-67-certified-services.astro:h5ctk">
        <div class="flex items-center gap-2.5 mb-6" data-ps="src/pages/act-67-certified-services.astro:h5ctl">
          <span class="inline-flex items-center gap-2 text-primary font-heading font-bold text-xs uppercase tracking-[1.2px]" data-ps="src/pages/act-67-certified-services.astro:x5zffx">
            <span class="w-2 h-2 rounded-full bg-primary inline-block" data-ps="src/pages/act-67-certified-services.astro:x5zfgj"></span>
            [ Authorized Vendor: ACT 67 Compliance ]
          </span>
        </div>

        <div class="grid lg:grid-cols-12 gap-12 items-center" data-ps="src/pages/act-67-certified-services.astro:h5ctm">
          <div class="lg:col-span-7" data-ps="src/pages/act-67-certified-services.astro:h5ctn">
            <h1 class="font-heading font-bold uppercase tracking-tight text-dark-foreground mb-6 text-[36px] sm:text-[46px] lg:text-[56px] leading-[1.05]" data-ps="src/pages/act-67-certified-services.astro:pblo3j">
              KRE Security:<br />Authorized Vendor for ACT 67 Compliance
            </h1>
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-sm mb-4" data-ps="src/pages/act-67-certified-services.astro:w8pez7">
              Ensuring School Safety with Certified Expertise
            </p>
            <p class="text-dark-muted-foreground text-base leading-relaxed mb-8 max-w-xl font-sans" data-ps="src/pages/act-67-certified-services.astro:w8pez6">
              KRE Security is proud to announce that we are now an approved and authorized vendor for ACT 67 compliance. This designation allows us to provide top-tier security services tailored to meet the stringent requirements of Pennsylvania's school safety laws.
            </p>
            <a
              href="/contact/"
              class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150 rounded-[4px]"
             data-ps="src/pages/act-67-certified-services.astro:28k04f">
              Get Started Today
            </a>
          </div>

          <div class="lg:col-span-5" data-ps="src/pages/act-67-certified-services.astro:h5cto">
            <aside class="kre-support bg-dark-surface border border-primary/25 rounded-[20px] p-6 sm:p-7 shadow-2xl" aria-labelledby="support-title" data-ps="src/pages/act-67-certified-services.astro:qckc6b">
              <div class="kre-support-heading flex items-center gap-4 mb-6" data-ps="src/pages/act-67-certified-services.astro:h5ctp">
                <div class="kre-support-brand w-14 h-14 flex-shrink-0 flex items-center justify-center" data-ps="src/pages/act-67-certified-services.astro:h5ctq">
                  <img src={logoImage} alt="KRE Security" width="1024" height="1226" class="w-12 h-auto object-contain" data-ps="src/pages/act-67-certified-services.astro:213riq" />
                </div>
                <div class="kre-support-heading-copy" data-ps="src/pages/act-67-certified-services.astro:h5cuc">
                  <span class="kre-panel-label block text-xs font-bold uppercase tracking-[1.28px] text-primary mb-0.5" data-ps="src/pages/act-67-certified-services.astro:x5zfgk">KRE SECURITY, LLC</span>
                  <h2 id="support-title" class="text-2xl sm:text-[28px] font-bold text-white tracking-[-0.84px] font-heading leading-tight" data-ps="src/pages/act-67-certified-services.astro:v13gnc">How can we help?</h2>
                  <p class="text-xs sm:text-sm text-dark-muted-foreground flex items-center gap-2 mt-1" data-ps="src/pages/act-67-certified-services.astro:w8pez5">
                    <span class="kre-status w-2 h-2 rounded-full bg-primary inline-block flex-shrink-0" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgl"></span>
                    24-hour emergency dispatch
                  </p>
                </div>
              </div>

              <div class="kre-support-links flex flex-col gap-2.5" data-ps="src/pages/act-67-certified-services.astro:h5cud">
                <a href="/act-67-certified-services/" class="kre-support-link group bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 px-4 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all" data-ps="src/pages/act-67-certified-services.astro:28k04g">
                  <div class="flex items-center gap-3.5" data-ps="src/pages/act-67-certified-services.astro:h5cue">
                    <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgm">◇</span>
                    <div data-ps="src/pages/act-67-certified-services.astro:h5cuf">
                      <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">Act 67 Training</strong>
                      <small class="block text-xs text-dark-muted-foreground">School security training and certification</small>
                    </div>
                  </div>
                  <span class="kre-arrow text-primary text-base transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgn">↗</span>
                </a>

                <a href="/first-aid-training/" class="kre-support-link group bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 px-4 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all" data-ps="src/pages/act-67-certified-services.astro:28k04h">
                  <div class="flex items-center gap-3.5" data-ps="src/pages/act-67-certified-services.astro:h5cug">
                    <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgo">+</span>
                    <div data-ps="src/pages/act-67-certified-services.astro:h5cuh">
                      <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">First Aid Training</strong>
                      <small class="block text-xs text-dark-muted-foreground">Explore our first aid training programs</small>
                    </div>
                  </div>
                  <span class="kre-arrow text-primary text-base transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgp">↗</span>
                </a>

                <a href="tel:610-562-0971" class="kre-support-link group bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 px-4 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all" data-ps="src/pages/act-67-certified-services.astro:28k04i">
                  <div class="flex items-center gap-3.5" data-ps="src/pages/act-67-certified-services.astro:h5cui">
                    <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgq">◷</span>
                    <div data-ps="src/pages/act-67-certified-services.astro:h5cuj">
                      <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">24-hour emergency dispatch</strong>
                      <small class="block text-xs text-dark-muted-foreground">610-562-0971</small>
                    </div>
                  </div>
                  <span class="kre-arrow text-primary text-base transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgr">↗</span>
                </a>

                <a href="/employment/" class="kre-support-link group bg-white/[0.02] border border-white/[0.086] rounded-xl p-3.5 px-4 flex items-center justify-between hover:bg-primary/[0.06] hover:border-primary/50 transition-all" data-ps="src/pages/act-67-certified-services.astro:28k04j">
                  <div class="flex items-center gap-3.5" data-ps="src/pages/act-67-certified-services.astro:h5cuk">
                    <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:x5zfgs">+</span>
                    <div data-ps="src/pages/act-67-certified-services.astro:h5cul">
                      <strong class="block text-sm font-bold text-white group-hover:text-primary transition-colors">KRE Job Openings</strong>
                      <small class="block text-xs text-dark-muted-foreground">Explore careers with KRE Security</small>
                    </div>
                  </div>
                  <span class="kre-arrow text-primary text-base transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" data-ps="src/pages/act-67-certified-services.astro:sptlfh">↗</span>
                </a>
              </div>

              <p class="kre-support-note text-xs text-dark-muted-foreground mt-5 text-center font-sans" data-ps="src/pages/act-67-certified-services.astro:w8pez4">
                Your total security professional.
              </p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="bg-surface py-20 lg:py-24" data-ps="src/pages/act-67-certified-services.astro:p1drn5">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/act-67-certified-services.astro:h5cv7">
        {/* WHAT IS ACT 67 */}
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mb-24 items-start" data-ps="src/pages/act-67-certified-services.astro:h5cv8">
          <div data-ps="src/pages/act-67-certified-services.astro:h5cv9">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/act-67-certified-services.astro:w8peyi">
              [ Pennsylvania Law ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-foreground mb-6 text-3xl sm:text-4xl lg:text-[44px] leading-[1.1]" data-ps="src/pages/act-67-certified-services.astro:v13gny">
              What is ACT 67?
            </h2>
            <p class="text-muted-foreground text-base leading-relaxed mb-6 font-sans" data-ps="src/pages/act-67-certified-services.astro:w8peyh">
              ACT 67 of 2019 is a Pennsylvania law that enhances school safety by establishing clear training and credentialing requirements for school security personnel, including:
            </p>

            <ul class="space-y-4 mb-6">
              <li class="flex gap-3 items-start" data-ps="src/pages/act-67-certified-services.astro:99jcl8">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/act-67-certified-services.astro:sptlfg"></span>
                <div data-ps="src/pages/act-67-certified-services.astro:h5cva">
                  <span class="font-heading font-bold text-foreground text-sm uppercase tracking-wide" data-ps="src/pages/act-67-certified-services.astro:sptlff">School Police Officers (SPOs):</span>
                  <span class="text-muted-foreground text-sm ml-1 font-sans" data-ps="src/pages/act-67-certified-services.astro:sptlfe">Law enforcement officers employed or contracted by schools.</span>
                </div>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/act-67-certified-services.astro:99jcl7">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/act-67-certified-services.astro:sptlfd"></span>
                <div data-ps="src/pages/act-67-certified-services.astro:h5cvb">
                  <span class="font-heading font-bold text-foreground text-sm uppercase tracking-wide" data-ps="src/pages/act-67-certified-services.astro:sptlfc">School Resource Officers (SROs):</span>
                  <span class="text-muted-foreground text-sm ml-1 font-sans" data-ps="src/pages/act-67-certified-services.astro:sptlfb">Officers stationed in schools through agreements with law enforcement agencies.</span>
                </div>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/act-67-certified-services.astro:99jcl6">
                <span class="mt-1.5 w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/act-67-certified-services.astro:sptlfa"></span>
                <div data-ps="src/pages/act-67-certified-services.astro:h5cvc">
                  <span class="font-heading font-bold text-foreground text-sm uppercase tracking-wide" data-ps="src/pages/act-67-certified-services.astro:sptlf9">School Security Guards:</span>
                  <span class="text-muted-foreground text-sm ml-1 font-sans" data-ps="src/pages/act-67-certified-services.astro:sptlf8">Personnel responsible for routine safety and security duties in schools.</span>
                </div>
              </li>
            </ul>

            <p class="text-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/act-67-certified-services.astro:w8peyg">
              ACT 67 ensures that only qualified and trained individuals are authorized to carry firearms and perform security duties in educational settings.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4" data-ps="src/pages/act-67-certified-services.astro:h5cvd">
            <div class="tactical-frame overflow-hidden" data-ps="src/pages/act-67-certified-services.astro:h5cve">
              <img src={img2754} alt="ACT 67 training" class="w-full h-40 object-cover" loading="lazy" data-ps="src/pages/act-67-certified-services.astro:213rip" />
            </div>
            <div class="tactical-frame overflow-hidden" data-ps="src/pages/act-67-certified-services.astro:h5cvf">
              <img src={imgTraining} alt="Training course" class="w-full h-40 object-cover" loading="lazy" data-ps="src/pages/act-67-certified-services.astro:213rio" />
            </div>
            <div class="tactical-frame overflow-hidden col-span-2" data-ps="src/pages/act-67-certified-services.astro:h5cvg">
              <img src={imgSchool} alt="Modern School Building" class="w-full h-40 object-cover" loading="lazy" data-ps="src/pages/act-67-certified-services.astro:213rin" />
            </div>
          </div>
        </div>

        {/* OUR ACT 67 SERVICES */}
        <div class="mb-24" data-ps="src/pages/act-67-certified-services.astro:bfvu3o">
          <div class="text-center mb-12" data-ps="src/pages/act-67-certified-services.astro:bfvu3n">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/act-67-certified-services.astro:w8peyf">
              [ Authorized Vendor ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-foreground mb-4 text-3xl sm:text-4xl lg:text-[44px] leading-[1.1]" data-ps="src/pages/act-67-certified-services.astro:v13gnz">
              Our ACT 67 Services
            </h2>
            <p class="text-muted-foreground text-base max-w-2xl mx-auto font-sans" data-ps="src/pages/act-67-certified-services.astro:w8peye">
              As an authorized vendor, KRE Security offers comprehensive services to help schools comply with ACT 67 requirements.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6" data-ps="src/pages/act-67-certified-services.astro:bfvu3m">
            {/* Card 1 */}
            <div class="tactical-card relative bg-background p-7 border border-border/80 rounded-sm shadow-sm transition-transform duration-300 hover:-translate-y-1" data-ps="src/pages/act-67-certified-services.astro:bfvu3l">
              <span class="corner-bracket top-left" data-ps="src/pages/act-67-certified-services.astro:sptlem"></span>
              <span class="corner-bracket top-right" data-ps="src/pages/act-67-certified-services.astro:sptlel"></span>
              <span class="corner-bracket bottom-left" data-ps="src/pages/act-67-certified-services.astro:sptlek"></span>
              <span class="corner-bracket bottom-right" data-ps="src/pages/act-67-certified-services.astro:sptlej"></span>
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/act-67-certified-services.astro:w8peyd">
                [ Training ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-lg mb-3" data-ps="src/pages/act-67-certified-services.astro:gcojfo">
                Certified Training Programs
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/act-67-certified-services.astro:w8peyc">
                We provide the Basic School Resource Officer Course of Instruction approved by the National Association of School Resource Officers (NASRO) or equivalent courses.
              </p>
            </div>

            {/* Card 2 */}
            <div class="tactical-card relative bg-background p-7 border border-border/80 rounded-sm shadow-sm transition-transform duration-300 hover:-translate-y-1" data-ps="src/pages/act-67-certified-services.astro:bfvu3k">
              <span class="corner-bracket top-left" data-ps="src/pages/act-67-certified-services.astro:sptlei"></span>
              <span class="corner-bracket top-right" data-ps="src/pages/act-67-certified-services.astro:sptleh"></span>
              <span class="corner-bracket bottom-left" data-ps="src/pages/act-67-certified-services.astro:sptleg"></span>
              <span class="corner-bracket bottom-right" data-ps="src/pages/act-67-certified-services.astro:sptlef"></span>
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/act-67-certified-services.astro:w8peyb">
                [ Compliance ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-lg mb-3" data-ps="src/pages/act-67-certified-services.astro:gcojfp">
                Credential Verification
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/act-67-certified-services.astro:w8peya">
                Assistance with background checks and certifications under the Lethal Weapons Training Act (Act 235).
              </p>
            </div>

            {/* Card 3 */}
            <div class="tactical-card relative bg-background p-7 border border-border/80 rounded-sm shadow-sm transition-transform duration-300 hover:-translate-y-1" data-ps="src/pages/act-67-certified-services.astro:bfvu3j">
              <span class="corner-bracket top-left" data-ps="src/pages/act-67-certified-services.astro:sptlee"></span>
              <span class="corner-bracket top-right" data-ps="src/pages/act-67-certified-services.astro:sptled"></span>
              <span class="corner-bracket bottom-left" data-ps="src/pages/act-67-certified-services.astro:sptldr"></span>
              <span class="corner-bracket bottom-right" data-ps="src/pages/act-67-certified-services.astro:sptldq"></span>
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/act-67-certified-services.astro:w8pey9">
                [ Tailored ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-lg mb-3" data-ps="src/pages/act-67-certified-services.astro:gcojfq">
                Customized Security Solutions
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/act-67-certified-services.astro:w8pexn">
                Tailored security plans to meet the unique needs of your school or district.
              </p>
            </div>

            {/* Card 4 */}
            <div class="tactical-card relative bg-background p-7 border border-border/80 rounded-sm shadow-sm transition-transform duration-300 hover:-translate-y-1" data-ps="src/pages/act-67-certified-services.astro:bfvu3i">
              <span class="corner-bracket top-left" data-ps="src/pages/act-67-certified-services.astro:sptldp"></span>
              <span class="corner-bracket top-right" data-ps="src/pages/act-67-certified-services.astro:sptldo"></span>
              <span class="corner-bracket bottom-left" data-ps="src/pages/act-67-certified-services.astro:sptldn"></span>
              <span class="corner-bracket bottom-right" data-ps="src/pages/act-67-certified-services.astro:sptldm"></span>
              <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-2" data-ps="src/pages/act-67-certified-services.astro:w8pexm">
                [ Continuous ]
              </p>
              <h3 class="font-heading font-bold uppercase text-foreground text-lg mb-3" data-ps="src/pages/act-67-certified-services.astro:gcojfr">
                Ongoing Support
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/act-67-certified-services.astro:w8pexl">
                Annual in-service training and compliance updates to ensure your security personnel remain certified and prepared.
              </p>
            </div>
          </div>
        </div>

        {/* BOTTOM CTA WITH CLASSROOM PHOTO */}
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/act-67-certified-services.astro:bfvu3h">
          <div class="tactical-frame overflow-hidden" data-ps="src/pages/act-67-certified-services.astro:bfvu3g">
            <img src={imgClassroom} alt="Classroom" class="w-full max-w-[768px] h-auto object-cover" loading="lazy" data-ps="src/pages/act-67-certified-services.astro:213rim" />
          </div>
          <div data-ps="src/pages/act-67-certified-services.astro:bfvu3f">
            <p class="text-primary font-heading font-bold uppercase tracking-widest text-xs mb-4" data-ps="src/pages/act-67-certified-services.astro:w8pexk">
              [ Get Started Today ]
            </p>
            <h2 class="font-heading font-bold uppercase tracking-tight text-foreground mb-4 text-3xl sm:text-4xl lg:text-[44px] leading-[1.1]" data-ps="src/pages/act-67-certified-services.astro:v13go0">
              Ensure Your School is ACT 67 Compliant
            </h2>
            <p class="text-muted-foreground text-base leading-relaxed mb-8 font-sans" data-ps="src/pages/act-67-certified-services.astro:w8pexj">
              Contact us to learn more about our ACT 67 services or to schedule a consultation. KRE Security is your trusted partner for certified school safety.
            </p>
            <a
              href="/contact/"
              class="inline-block bg-primary text-primary-foreground font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
             data-ps="src/pages/act-67-certified-services.astro:28k04k">
              Contact Us Today to Get Started
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tactical-card {
    position: relative;
  }

  .corner-bracket {
    position: absolute;
    width: 10px;
