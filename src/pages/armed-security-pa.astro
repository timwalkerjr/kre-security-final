---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Armed Security Guards in Eastern PA | KRE Security";
const description = "Hire trained armed security officers for your Pennsylvania business or event. KRE Security offers uniformed and plainclothes protection tailored to your needs.";
---

<BaseLayout
  headerVariant="transparent"
  title={title}
  description={description}
  canonicalUrl="https://kre-security.netlify.app/armed-security-pa/"
>
  <main data-ps="src/pages/armed-security-pa.astro:e0msmi">
    {/* Hero Section */}
    <section class="bg-dark-background pt-36 pb-20 lg:pt-44 lg:pb-24" data-ps="src/pages/armed-security-pa.astro:35gekn">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/armed-security-pa.astro:hypkbl">
        <div class="flex items-center gap-2 mb-6" data-ps="src/pages/armed-security-pa.astro:hypkbm">
          <span class="w-2 h-2 rounded-full bg-primary inline-block flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0zi8"></span>
          <span class="text-primary font-display font-bold uppercase tracking-widest text-xs" data-ps="src/pages/armed-security-pa.astro:ds0ziu">
            [ NASRO Certified — PA State License No. 84 ]
          </span>
        </div>
        <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 max-w-3xl text-4xl sm:text-5xl lg:text-6xl leading-[1.05]" data-ps="src/pages/armed-security-pa.astro:m76tm5">
          Armed Security Guard Services
        </h1>
        <p class="text-dark-muted-foreground text-base sm:text-lg leading-relaxed mb-8 max-w-2xl font-sans" data-ps="src/pages/armed-security-pa.astro:kgmg80">
          When a situation arises that may require special security services, our Armed Security guard service can help. Our full-time armed security guards are all certified by the NASRO and trained in the use of firearms and are fully belted.
        </p>
        <div class="flex flex-wrap gap-4" data-ps="src/pages/armed-security-pa.astro:hypkbn">
          <a
            href="/contact/"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
           data-ps="src/pages/armed-security-pa.astro:rkkcw5">
            Contact Us Today
          </a>
          <a
            href="tel:16105620971"
            class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
           data-ps="src/pages/armed-security-pa.astro:rkkcw6">
            610-562-0971
          </a>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="bg-surface py-20 lg:py-24" data-ps="src/pages/armed-security-pa.astro:35geko">
      <div class="max-w-7xl mx-auto px-6 lg:px-12" data-ps="src/pages/armed-security-pa.astro:hypkbo">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mb-20 items-start" data-ps="src/pages/armed-security-pa.astro:hypkca">
          {/* Left Column: Equipment Loadout */}
          <div data-ps="src/pages/armed-security-pa.astro:hypkcb">
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/armed-security-pa.astro:kgmg81">
              [ Full Equipment Loadout ]
            </p>
            <h2 class="font-display font-bold uppercase tracking-tight text-foreground mb-6 text-3xl sm:text-4xl lg:text-5xl leading-[1.1]" data-ps="src/pages/armed-security-pa.astro:y5ib4s">
              Our Armed Security Officers Carry:
            </h2>

            <div class="grid grid-cols-2 gap-3 mb-8" data-ps="src/pages/armed-security-pa.astro:hypkcc">
              <div class="flex items-center gap-3 tactical-frame bg-background p-3.5" data-ps="src/pages/armed-security-pa.astro:hypkcd">
                <span class="w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0ziv"></span>
                <span class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-pa.astro:ds0ziw">Firearm</span>
              </div>
              <div class="flex items-center gap-3 tactical-frame bg-background p-3.5" data-ps="src/pages/armed-security-pa.astro:hypkce">
                <span class="w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0zix"></span>
                <span class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-pa.astro:ds0ziy">Taser Gun</span>
              </div>
              <div class="flex items-center gap-3 tactical-frame bg-background p-3.5" data-ps="src/pages/armed-security-pa.astro:hypkcf">
                <span class="w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0ziz"></span>
                <span class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-pa.astro:ds0zj0">Expandable Baton</span>
              </div>
              <div class="flex items-center gap-3 tactical-frame bg-background p-3.5" data-ps="src/pages/armed-security-pa.astro:hypkcg">
                <span class="w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0zj1"></span>
                <span class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-pa.astro:ds0zj2">Flashlight</span>
              </div>
              <div class="flex items-center gap-3 tactical-frame bg-background p-3.5" data-ps="src/pages/armed-security-pa.astro:hypkch">
                <span class="w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0zj3"></span>
                <span class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-pa.astro:ds0zjp">Handcuffs</span>
              </div>
              <div class="flex items-center gap-3 tactical-frame bg-background p-3.5" data-ps="src/pages/armed-security-pa.astro:hypkci">
                <span class="w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0zjq"></span>
                <span class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-pa.astro:ds0zjr">O.C. Spray</span>
              </div>
              <div class="flex items-center gap-3 tactical-frame bg-background p-3.5" data-ps="src/pages/armed-security-pa.astro:hypkcj">
                <span class="w-2 h-2 bg-primary flex-shrink-0" data-ps="src/pages/armed-security-pa.astro:ds0zjs"></span>
                <span class="font-display font-bold uppercase text-foreground text-sm" data-ps="src/pages/armed-security-pa.astro:ds0zjt">Cell Phone</span>
              </div>
            </div>

            <p class="text-muted-foreground text-sm sm:text-base leading-relaxed font-sans" data-ps="src/pages/armed-security-pa.astro:kgmg82">
              Our armed security officers are fully trained and certified in the use of all the equipment they carry. We offer plain clothes officers for an inconspicuous presence or black class A dress uniforms that give an authoritative visual appearance. Our armed security guard services can be employed for many uses from access control to personal protection.
            </p>
          </div>

          {/* Right Column: Imagery */}
          <div class="space-y-6" data-ps="src/pages/armed-security-pa.astro:ebsbhh">
            <div class="tactical-frame bg-background p-4 flex items-center justify-center min-h-[130px]" data-ps="src/pages/armed-security-pa.astro:ebsbhi">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/pastedImage-249-3cb168-249.webp"
                alt="National Association of School Resource Officers"
                class="max-w-[249px] w-auto h-auto object-contain"
                loading="lazy" data-ps="src/pages/armed-security-pa.astro:fggg00" />
            </div>
            <div class="tactical-frame bg-background overflow-hidden flex items-center justify-center py-2" data-ps="src/pages/armed-security-pa.astro:ebsbhj">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_5cd7e3e1e5d84cc6a46b497a37fc813c-mv2-320-0f1ebd-320.webp"
                alt="Armed security service companies PA"
                class="w-full max-w-[320px] mx-auto h-auto object-cover"
                loading="lazy" data-ps="src/pages/armed-security-pa.astro:fggg01" />
            </div>
          </div>
        </div>

        {/* Deployment Options Dark Banner */}
        <div class="bg-dark-background p-8 lg:p-12 tactical-frame mb-16" data-ps="src/pages/armed-security-pa.astro:ebsbhk">
          <div class="text-center mb-10" data-ps="src/pages/armed-security-pa.astro:ebsbhl">
            <p class="text-primary font-display font-bold uppercase tracking-widest text-xs mb-3" data-ps="src/pages/armed-security-pa.astro:kgmg83">
              [ Deployment Options ]
            </p>
            <h2 class="font-display font-bold uppercase tracking-tight text-dark-foreground text-3xl sm:text-4xl lg:text-5xl leading-[1.1]" data-ps="src/pages/armed-security-pa.astro:y5ib4t">
              Armed Security for Any Situation
            </h2>
          </div>
          <div class="grid md:grid-cols-3 gap-6" data-ps="src/pages/armed-security-pa.astro:ebsbhm">
            <div class="border border-dark-border p-5" data-ps="src/pages/armed-security-pa.astro:ebsbhn">
              <p class="text-primary font-display font-bold uppercase text-xs tracking-widest mb-2" data-ps="src/pages/armed-security-pa.astro:kgmg84">[ Active ]</p>
              <h3 class="font-display font-bold uppercase text-dark-foreground text-base mb-3" data-ps="src/pages/armed-security-pa.astro:jh3dx5">Access Control</h3>
              <p class="text-dark-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/armed-security-pa.astro:kgmg8q">
                Professional armed presence at entry points and secured facilities.
              </p>
            </div>
            <div class="border border-dark-border p-5" data-ps="src/pages/armed-security-pa.astro:ebsbho">
              <p class="text-primary font-display font-bold uppercase text-xs tracking-widest mb-2" data-ps="src/pages/armed-security-pa.astro:kgmg8r">[ Active ]</p>
              <h3 class="font-display font-bold uppercase text-dark-foreground text-base mb-3" data-ps="src/pages/armed-security-pa.astro:jh3dx6">Personal Protection</h3>
              <p class="text-dark-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/armed-security-pa.astro:kgmg8s">
                Dedicated armed officers for executive and personal protection assignments.
              </p>
            </div>
            <div class="border border-dark-border p-5" data-ps="src/pages/armed-security-pa.astro:ebsbhp">
              <p class="text-primary font-display font-bold uppercase text-xs tracking-widest mb-2" data-ps="src/pages/armed-security-pa.astro:kgmg8t">[ Active ]</p>
              <h3 class="font-display font-bold uppercase text-dark-foreground text-base mb-3" data-ps="src/pages/armed-security-pa.astro:jh3dx7">Plain Clothes Officers</h3>
              <p class="text-dark-muted-foreground text-sm leading-relaxed font-sans" data-ps="src/pages/armed-security-pa.astro:kgmg8u">
                Inconspicuous armed security presence for sensitive or low-profile situations.
              </p>
            </div>
          </div>
        </div>

        {/* Bottom CTA */}
        <div class="text-center" data-ps="src/pages/armed-security-pa.astro:ebsbhq">
          <a
            href="/contact/"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-10 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
           data-ps="src/pages/armed-security-pa.astro:rkkcw7">
            Contact Us Today to Get Started
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tactical-frame {
    position: relative;
    border: 1px solid var(--color-border);
  }

  .bg-dark-background.tactical-frame {
    border-color: var(--color-dark-border);
  }

  .tactical-frame::before,
  .tactical-frame::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    pointer-events: none;
  }

  .tactical-frame::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
  }

  .tactical-frame::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
  }
</style>
