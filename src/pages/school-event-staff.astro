---
import BaseLayout from '@/layouts/BaseLayout.astro';

const services = [
  'School Event Services',
  'Fair Grounds Employees',
  'Party Event Staffing',
  'Stadium Staff',
  'Concert Employees',
  'School & Venue Based Sporting Game Ushers',
  'Convention Staffing and Security',
  'Sports Events Staffing and Security',
  'Trade Show Event Staffing and Security',
  'And Much More',
];

const capabilities = [
  'Crowd Management',
  'Access Control',
  'VIP Security',
  'Guest Services',
  'Personal Protection',
  'Parking Lot Attendants',
  'Traffic Control Services',
  'Event Ushers',
];
---

<BaseLayout
  title="School & Event Security Staff in PA | KRE Security"
  description="Plan security staffing for school functions and community events with KRE Security. Explore event protection services throughout Eastern Pennsylvania."
  headerVariant="transparent"
>
  <main data-ps="src/pages/school-event-staff.astro:9tfenk">
    <!-- Hero Section -->
    <section class="bg-dark-background pt-28 pb-20 lg:pt-36 lg:pb-24" id="event-staff-hero" data-ps="src/pages/school-event-staff.astro:isd4nz">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/school-event-staff.astro:i7l30w">
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/school-event-staff.astro:i7l30x">
          <div data-ps="src/pages/school-event-staff.astro:i7l30y">
            <div class="flex items-center gap-2 mb-6" data-ps="src/pages/school-event-staff.astro:i7l30z">
              <span class="w-2 h-2 rounded-full bg-primary inline-block" data-ps="src/pages/school-event-staff.astro:xf0v64"></span>
              <span class="font-display text-xs font-bold uppercase tracking-widest text-primary" data-ps="src/pages/school-event-staff.astro:xf0v5i">
                [ Dispatch Status: Active ]
              </span>
            </div>
            <h1 class="font-display font-bold text-h1 text-dark-foreground uppercase tracking-tight leading-tight mb-6" data-ps="src/pages/school-event-staff.astro:spc6j8">
              Event Staffing &amp; Security Guard Services
            </h1>
            <p class="font-sans text-dark-muted-foreground text-lg leading-relaxed mb-6" data-ps="src/pages/school-event-staff.astro:fy2dck">
              KRE has over 30 years of specialized event staffing services we bring to our clients — a separate division from our security protection team.
            </p>
            <p class="font-sans text-dark-muted-foreground leading-relaxed mb-8" data-ps="src/pages/school-event-staff.astro:fy2dcl">
              We are a local, well trusted, respected security company who has been providing a vast portion of security needs to schools, businesses and residences in eastern PA. Any large or small scale event needs can be handled by KRE with custom services tailored to our clients 24/7.
            </p>
            <div class="flex flex-wrap gap-4" data-ps="src/pages/school-event-staff.astro:i7l310">
              <a
                href="/#contact"
                class="inline-block bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
               data-ps="src/pages/school-event-staff.astro:n20a0l">
                Contact Us to Get Started
              </a>
              <a
                href="tel:6105620971"
                class="inline-block bg-transparent text-dark-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
               data-ps="src/pages/school-event-staff.astro:n20a0m">
                610-562-0971
              </a>
            </div>
          </div>

          <!-- Support Card -->
          <aside class="kre-support bg-dark-surface border border-primary/25 rounded-[20px] p-8" aria-labelledby="support-title" data-ps="src/pages/school-event-staff.astro:2vi2it">
            <div class="kre-support-heading flex items-center gap-4 mb-6" data-ps="src/pages/school-event-staff.astro:i7l311">
              <div class="kre-support-brand flex-shrink-0" data-ps="src/pages/school-event-staff.astro:i7l312">
                <img
                  src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                  alt="KRE Security"
                  width="56"
                  height="67"
                  class="w-14 h-auto" data-ps="src/pages/school-event-staff.astro:fpbyop" />
              </div>
              <div class="kre-support-heading-copy" data-ps="src/pages/school-event-staff.astro:i7l313">
                <span class="kre-panel-label text-xs font-bold tracking-widest text-primary uppercase block" data-ps="src/pages/school-event-staff.astro:xf0v5h">
                  KRE SECURITY, LLC
                </span>
                <h2 id="support-title" class="font-display font-bold text-2xl text-dark-foreground" data-ps="src/pages/school-event-staff.astro:rncy8a">
                  How can we help?
                </h2>
                <p class="text-sm text-dark-muted-foreground flex items-center gap-2 mt-1" data-ps="src/pages/school-event-staff.astro:fy2dcm">
                  <span class="kre-status w-2 h-2 rounded-full bg-primary inline-block" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v5g"></span>
                  24-hour emergency dispatch
                </p>
              </div>
            </div>

            <div class="kre-support-links flex flex-col gap-3 mb-6" data-ps="src/pages/school-event-staff.astro:i7l314">
              <a
                href="/act-67-certified-services/"
                class="kre-support-link group flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all"
               data-ps="src/pages/school-event-staff.astro:n20a0n">
                <div class="flex items-center gap-3" data-ps="src/pages/school-event-staff.astro:i7l31q">
                  <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v5f">◇</span>
                  <div data-ps="src/pages/school-event-staff.astro:i7l31r">
                    <strong class="block text-dark-foreground text-sm font-bold group-hover:text-primary transition-colors">Act 67 Training</strong>
                    <small class="block text-xs text-dark-muted-foreground">School security training and certification</small>
                  </div>
                </div>
                <span class="kre-arrow text-primary text-sm transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v5e">↗</span>
              </a>

              <a
                href="/first-aid-training/"
                class="kre-support-link group flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all"
               data-ps="src/pages/school-event-staff.astro:n20a0o">
                <div class="flex items-center gap-3" data-ps="src/pages/school-event-staff.astro:i7l31s">
                  <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v5d">+</span>
                  <div data-ps="src/pages/school-event-staff.astro:i7l31t">
                    <strong class="block text-dark-foreground text-sm font-bold group-hover:text-primary transition-colors">First Aid Training</strong>
                    <small class="block text-xs text-dark-muted-foreground">Explore our first aid training programs</small>
                  </div>
                </div>
                <span class="kre-arrow text-primary text-sm transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v5c">↗</span>
              </a>

              <a
                href="tel:610-562-0971"
                class="kre-support-link group flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all"
               data-ps="src/pages/school-event-staff.astro:n20a0p">
                <div class="flex items-center gap-3" data-ps="src/pages/school-event-staff.astro:i7l31u">
                  <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v5b">◷</span>
                  <div data-ps="src/pages/school-event-staff.astro:i7l31v">
                    <strong class="block text-dark-foreground text-sm font-bold group-hover:text-primary transition-colors">24-hour emergency dispatch</strong>
                    <small class="block text-xs text-dark-muted-foreground">610-562-0971</small>
                  </div>
                </div>
                <span class="kre-arrow text-primary text-sm transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v5a">↗</span>
              </a>

              <a
                href="/employment/"
                class="kre-support-link group flex items-center justify-between p-3.5 bg-white/[0.02] border border-white/[0.086] rounded-xl hover:bg-primary/[0.06] hover:border-primary/50 transition-all"
               data-ps="src/pages/school-event-staff.astro:n20a0q">
                <div class="flex items-center gap-3" data-ps="src/pages/school-event-staff.astro:i7l31w">
                  <span class="kre-icon w-9 h-9 rounded-[9px] bg-primary/10 text-primary flex items-center justify-center font-bold text-base flex-shrink-0" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v59">+</span>
                  <div data-ps="src/pages/school-event-staff.astro:i7l31x">
                    <strong class="block text-dark-foreground text-sm font-bold group-hover:text-primary transition-colors">KRE Job Openings</strong>
                    <small class="block text-xs text-dark-muted-foreground">Explore careers with KRE Security</small>
                  </div>
                </div>
                <span class="kre-arrow text-primary text-sm transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" data-ps="src/pages/school-event-staff.astro:xf0v4n">↗</span>
              </a>
            </div>

            <p class="kre-support-note text-center text-xs text-dark-muted-foreground pt-4 border-t border-white/[0.08]" data-ps="src/pages/school-event-staff.astro:fy2dcn">
              Your total security professional.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <!-- Services Division Section -->
    <section class="bg-surface py-20" id="event-staff-services" data-ps="src/pages/school-event-staff.astro:isd4nd">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/school-event-staff.astro:i7l31y">
        <div class="grid lg:grid-cols-2 gap-16 items-start" data-ps="src/pages/school-event-staff.astro:i7l31z">
          <!-- Left Column: Service List -->
          <div data-ps="src/pages/school-event-staff.astro:psidkh">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/school-event-staff.astro:fy2dco">
              [ Event Staffing Division ]
            </p>
            <h2 class="font-display font-bold text-h2 text-foreground uppercase tracking-tight leading-tight mb-6" data-ps="src/pages/school-event-staff.astro:rncy8b">
              Our Event Staffing Company Can Provide:
            </h2>
            <p class="font-sans text-foreground leading-relaxed mb-8" data-ps="src/pages/school-event-staff.astro:fy2dda">
              We provide the staffing for large and small events. If there will be a large gathering of people, we can make sure there are enough bodies to manage and control the flow of traffic, ensure safety, provide assistance, or manage the crowds.
            </p>
            <div class="space-y-2 mb-10" data-ps="src/pages/school-event-staff.astro:psidki">
              {services.map((service, __psIdx) => (
                <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps={`src/pages/school-event-staff.astro:psidkj-${__psIdx}`}>
                  <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)] transition-shadow" data-ps={`src/pages/school-event-staff.astro:xf0v4m-${__psIdx}`}></span>
                  <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps={`src/pages/school-event-staff.astro:xf0v4l-${__psIdx}`}>
                    {service}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Right Column: Capabilities & Image -->
          <div class="space-y-6" data-ps="src/pages/school-event-staff.astro:psidkk">
            <!-- Capabilities Box -->
            <div class="bg-dark-background p-8 relative" data-ps="src/pages/school-event-staff.astro:psidkl">
              <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px" data-ps="src/pages/school-event-staff.astro:psidkm"></div>
              <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px" data-ps="src/pages/school-event-staff.astro:psidkn"></div>
              <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-4" data-ps="src/pages/school-event-staff.astro:fy2ddb">
                [ Staff Capabilities ]
              </p>
              <div class="grid grid-cols-2 gap-3" data-ps="src/pages/school-event-staff.astro:psidko">
                {capabilities.map((cap, __psIdx) => (
                  <div class="flex items-center gap-2" data-ps={`src/pages/school-event-staff.astro:psidkp-${__psIdx}`}>
                    <span class="text-primary text-xs flex-shrink-0" data-ps={`src/pages/school-event-staff.astro:xf0v4k-${__psIdx}`}>●</span>
                    <span class="font-sans text-xs text-dark-muted-foreground" data-ps={`src/pages/school-event-staff.astro:xf0v4j-${__psIdx}`}>{cap}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Image Frame -->
            <div class="tactical-frame overflow-hidden" data-ps="src/pages/school-event-staff.astro:psidkq">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_3ba4109b5877408ba9c2e259be148c43-mv2-768-ca0ee1-768.webp"
                alt="Event staff security eastern PA"
                class="w-full max-w-[768px] h-auto object-cover block"
                loading="lazy"
                width="768"
                height="414" data-ps="src/pages/school-event-staff.astro:fpbyoq" />
            </div>

            <!-- CTA Button -->
            <a
              href="/#contact"
              class="inline-block w-full text-center bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
             data-ps="src/pages/school-event-staff.astro:n20a0r">
              Contact Us to Get Started
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
