---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "School Security Guards in Pennsylvania | KRE Security";
const description = "KRE Security provides armed and unarmed school security guards in Pennsylvania. Discuss staffing to help protect students, staff, and visitors.";
---

<BaseLayout
  title={title}
  description={description}
  headerVariant="transparent"
>
  <main data-ps="src/pages/school-security.astro:ch4q53">
    <!-- Hero Section -->
    <section class="bg-dark-background pt-28 pb-20 md:pt-36 md:pb-24" id="school-security-hero" data-ps="src/pages/school-security.astro:tjwzyy">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/school-security.astro:3bkfp2">
        <div class="grid lg:grid-cols-12 gap-12 items-center" data-ps="src/pages/school-security.astro:3bkfp1">
          <div class="lg:col-span-7" data-ps="src/pages/school-security.astro:3bkfp0">
            <span class="status-dot mb-6 block" data-ps="src/pages/school-security.astro:fbj1yj">[ Dispatch Status: Active ]</span>
            <h1 class="font-display font-bold text-h1 text-dark-foreground uppercase tracking-tight leading-tight mb-6" data-ps="src/pages/school-security.astro:rat2jn">
              School Security Guard Services
            </h1>
            <p class="font-sans text-dark-muted-foreground text-lg leading-relaxed mb-4" data-ps="src/pages/school-security.astro:6wplsj">
              KRE Security LLC. is a local, well trusted and respected security company who has been providing a vast portion of security and protection needs to school districts across the region.
            </p>
            <p class="font-sans text-dark-muted-foreground leading-relaxed mb-8" data-ps="src/pages/school-security.astro:6wplsi">
              Our high standard of performance and professionalism has allowed our firm to provide ongoing services for over 25 years throughout Berks, Schuylkill, Lehigh, &amp; Montgomery Counties.
            </p>

            <div class="bg-dark-border/30 border border-dark-border p-4 mb-8 relative inline-flex items-center gap-4" data-ps="src/pages/school-security.astro:3bkfoz">
              <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px" data-ps="src/pages/school-security.astro:3bkfoy"></div>
              <div class="w-2 h-2 bg-primary rounded-full animate-pulse shrink-0" data-ps="src/pages/school-security.astro:3bkfox"></div>
              <div data-ps="src/pages/school-security.astro:3bkfow">
                <p class="font-display text-xs font-bold uppercase tracking-widest text-primary" data-ps="src/pages/school-security.astro:6wplsh">[ Certified ]</p>
                <p class="font-sans text-sm text-dark-foreground font-bold" data-ps="src/pages/school-security.astro:6wplsg">Our Full-Time Staff are all certified by the NASRO</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-4" data-ps="src/pages/school-security.astro:3bkfov">
              <a
                href="/#contact"
                class="inline-block bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
               data-ps="src/pages/school-security.astro:685ihp">
                Contact Us to Get Started
              </a>
              <a
                href="/armed-security-pa/"
                class="inline-block bg-transparent text-dark-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
               data-ps="src/pages/school-security.astro:685ihq">
                Armed Security Info
              </a>
            </div>
          </div>

          <!-- Support Sidebar / Panel -->
          <div class="lg:col-span-5" data-ps="src/pages/school-security.astro:3bkfou">
            <aside class="kre-support" aria-labelledby="support-title" data-ps="src/pages/school-security.astro:uc3a9q">
              <div class="kre-support-heading" data-ps="src/pages/school-security.astro:3bkfo8">
                <div class="kre-support-brand shrink-0" data-ps="src/pages/school-security.astro:3bkfo7">
                  <img
                    src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
                    alt="KRE Security"
                    width="64"
                    height="76"
                    class="h-16 w-auto object-contain" data-ps="src/pages/school-security.astro:5ttk1c" />
                </div>
                <div class="kre-support-heading-copy" data-ps="src/pages/school-security.astro:3bkfo6">
                  <span class="kre-panel-label" data-ps="src/pages/school-security.astro:fbj1yk">KRE SECURITY, LLC</span>
                  <h2 id="support-title" class="font-display font-bold text-2xl text-white tracking-tight leading-snug" data-ps="src/pages/school-security.astro:cme5bf">How can we help?</h2>
                  <p class="text-sm text-[#d5dbe3] flex items-center gap-2 mt-0.5" data-ps="src/pages/school-security.astro:6wplsf">
                    <span class="kre-status" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1yl"></span>
                    24-hour emergency dispatch
                  </p>
                </div>
              </div>

              <div class="kre-support-links" data-ps="src/pages/school-security.astro:3bkfo5">
                <a href="/act-67-certified-services/" class="kre-support-link group" data-ps="src/pages/school-security.astro:685ihr">
                  <span class="kre-icon" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1ym">◇</span>
                  <span class="flex-1 min-w-0" data-ps="src/pages/school-security.astro:fbj1yn">
                    <strong class="block font-bold text-sm text-white">Act 67 Training</strong>
                    <small class="block text-xs text-dark-muted-foreground truncate">School security training and certification</small>
                  </span>
                  <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1yo">↗</span>
                </a>

                <a href="/first-aid-training/" class="kre-support-link group" data-ps="src/pages/school-security.astro:685ihs">
                  <span class="kre-icon" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1za">+</span>
                  <span class="flex-1 min-w-0" data-ps="src/pages/school-security.astro:fbj1zb">
                    <strong class="block font-bold text-sm text-white">First Aid Training</strong>
                    <small class="block text-xs text-dark-muted-foreground truncate">Explore our first aid training programs</small>
                  </span>
                  <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1zc">↗</span>
                </a>

                <a href="tel:610-562-0971" class="kre-support-link group" data-ps="src/pages/school-security.astro:78aun">
                  <span class="kre-icon" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1zd">◷</span>
                  <span class="flex-1 min-w-0" data-ps="src/pages/school-security.astro:fbj1ze">
                    <strong class="block font-bold text-sm text-white">24-hour emergency dispatch</strong>
                    <small class="block text-xs text-dark-muted-foreground">610-562-0971</small>
                  </span>
                  <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1zf">↗</span>
                </a>

                <a href="/employment/" class="kre-support-link group" data-ps="src/pages/school-security.astro:78auo">
                  <span class="kre-icon" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1zg">+</span>
                  <span class="flex-1 min-w-0" data-ps="src/pages/school-security.astro:fbj1zh">
                    <strong class="block font-bold text-sm text-white">KRE Job Openings</strong>
                    <small class="block text-xs text-dark-muted-foreground truncate">Explore careers with KRE Security</small>
                  </span>
                  <span class="kre-arrow" aria-hidden="true" data-ps="src/pages/school-security.astro:fbj1zi">↗</span>
                </a>
              </div>

              <p class="kre-support-note" data-ps="src/pages/school-security.astro:6wplse">Your total security professional.</p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Provided Section -->
    <section class="bg-surface" id="school-security-services" data-ps="src/pages/school-security.astro:tjwzyz">
      <div class="max-w-7xl mx-auto px-6 py-20" data-ps="src/pages/school-security.astro:3bkfo4">
        <div class="grid lg:grid-cols-2 gap-16 items-start" data-ps="src/pages/school-security.astro:3bkfo3">
          <div data-ps="src/pages/school-security.astro:3bkfo2">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/school-security.astro:6wplsd">
              [ Services Provided ]
            </p>
            <h2 class="font-display font-bold text-h2 text-foreground uppercase tracking-tight leading-tight mb-6" data-ps="src/pages/school-security.astro:cme5bg">
              Comprehensive School Security Solutions
            </h2>
            <p class="font-sans text-foreground leading-relaxed mb-6" data-ps="src/pages/school-security.astro:6wplrr">
              Our school security officers are well diverse to perform services within the education setting, with our goal to promote the safety and well being while maintaining the academic setting for students, staff, and guests to the school districts and university campuses we provide services to.
            </p>

            <div class="space-y-2 mb-10" data-ps="src/pages/school-security.astro:3bkfo1">
              <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps="src/pages/school-security.astro:3bkfo0">
                <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps="src/pages/school-security.astro:fbj1zj"></span>
                <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps="src/pages/school-security.astro:fbj205">Special Events Security</span>
              </div>
              <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps="src/pages/school-security.astro:3bkfnz">
                <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps="src/pages/school-security.astro:fbj206"></span>
                <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps="src/pages/school-security.astro:fbj207">Sporting Event Security</span>
              </div>
              <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps="src/pages/school-security.astro:3bkfnd">
                <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps="src/pages/school-security.astro:fbj208"></span>
                <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps="src/pages/school-security.astro:fbj209">Proms &amp; School Events</span>
              </div>
              <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps="src/pages/school-security.astro:3bkfnc">
                <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps="src/pages/school-security.astro:fbj20a"></span>
                <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps="src/pages/school-security.astro:fbj20b">Traffic Direction</span>
              </div>
              <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps="src/pages/school-security.astro:3bkfnb">
                <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps="src/pages/school-security.astro:fbj20c"></span>
                <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps="src/pages/school-security.astro:fbj20d">Building Patrols</span>
              </div>
              <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps="src/pages/school-security.astro:3bkfna">
                <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps="src/pages/school-security.astro:fbj20e"></span>
                <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps="src/pages/school-security.astro:fbj210">Event Security Services</span>
              </div>
              <div class="flex items-center gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps="src/pages/school-security.astro:3bkfn9">
                <span class="w-2 h-2 bg-primary flex-shrink-0 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps="src/pages/school-security.astro:fbj211"></span>
                <span class="font-sans text-sm font-bold text-foreground uppercase tracking-wide" data-ps="src/pages/school-security.astro:fbj212">Security Consulting for Districts</span>
              </div>
            </div>
          </div>

          <div class="space-y-6" data-ps="src/pages/school-security.astro:3bkfn8">
            <div class="bg-dark-background p-8 relative" data-ps="src/pages/school-security.astro:3bkfn7">
              <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px" data-ps="src/pages/school-security.astro:3bkfn6"></div>
              <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px" data-ps="src/pages/school-security.astro:3bkfn5"></div>
              <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-3" data-ps="src/pages/school-security.astro:6wplrq">[ Armed School Security ]</p>
              <p class="font-sans text-dark-muted-foreground leading-relaxed mb-6" data-ps="src/pages/school-security.astro:6wplrp">
                KRE Security currently provides armed agents to service as a protection role in several districts across the region. Our professional armed security guard staff has prior backgrounds in law enforcement, public safety, and educational backgrounds, which allows for our agents to interact with students to gain the professional trust of a security presence daily in the schools.
              </p>
              <a
                href="/armed-security-pa/"
                class="inline-block bg-primary text-primary-foreground font-display font-bold text-xs uppercase tracking-widest px-6 py-3 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
               data-ps="src/pages/school-security.astro:78aup">
                Armed Security Services →
              </a>
            </div>

            <div class="tactical-frame overflow-hidden" data-ps="src/pages/school-security.astro:3bkfn4">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_797b9b116d42412dbbebab45c6dee4e0-mv2-320-10f288-320.webp"
                alt="School security guards"
                class="w-full max-w-[320px] h-auto object-cover"
                loading="lazy" data-ps="src/pages/school-security.astro:5ttk1b" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- NASRO / ACT 67 Section -->
    <section class="bg-background" id="school-security-training" data-ps="src/pages/school-security.astro:tjwzzl">
      <div class="max-w-7xl mx-auto px-6 py-16" data-ps="src/pages/school-security.astro:dus5jc">
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-ps="src/pages/school-security.astro:dus5jb">
          <div class="tactical-frame overflow-hidden" data-ps="src/pages/school-security.astro:dus5ja">
            <img
              src="https://pagesmith-cdn.com/fe6bcc20/images/KRE-NASRO-Class-Photo-320-200283-320.webp"
              alt="KRE NASRO Class Photo — ACT 67 Training"
              class="w-full h-auto object-cover"
              loading="lazy" data-ps="src/pages/school-security.astro:5ttk1a" />
          </div>
          <div data-ps="src/pages/school-security.astro:dus5j9">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/school-security.astro:6wplro">
              [ ACT 67 Training ]
            </p>
            <h2 class="font-display font-bold text-h2 text-foreground uppercase tracking-tight leading-tight mb-4" data-ps="src/pages/school-security.astro:cme5c2">
              NASRO Certified &amp; ACT 67 Compliant
            </h2>
            <p class="font-sans text-foreground leading-relaxed mb-6" data-ps="src/pages/school-security.astro:6wplrn">
              Six, including management, members of the KRE school Security Division just attended training at the BCIU Berks County Intermediate Unit — Reading, PA as part of the PA ACT 67 training for deployment as Armed Security in several districts KRE provides services to.
            </p>
            <p class="font-sans text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/school-security.astro:6wplrm">
              Photos Courtesy of Harold Hoch of the Reading Eagle.
            </p>
            <a
              href="/act-67-certified-services/"
              class="inline-block bg-foreground text-background font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-foreground hover:bg-primary hover:text-foreground hover:border-primary transition-colors duration-150"
             data-ps="src/pages/school-security.astro:78auq">
              ACT 67 Certified Services
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom Banner & CTA Section -->
    <section class="bg-surface">
      <div class="max-w-7xl mx-auto px-6 pb-16" data-ps="src/pages/school-security.astro:dus5j8">
        <div class="tactical-frame overflow-hidden mb-8" data-ps="src/pages/school-security.astro:dus5j7">
          <img
            src="https://pagesmith-cdn.com/fe6bcc20/images/39725c_3ba4109b5877408ba9c2e259be148c43-mv2-768-ca0ee1-768.webp"
            alt="School security guard services"
            class="w-full max-w-[768px] h-auto object-cover mx-auto block"
            loading="lazy" data-ps="src/pages/school-security.astro:5ttk19" />
        </div>

        <div class="bg-dark-background p-8 flex flex-col md:flex-row items-center justify-between gap-6 relative" data-ps="src/pages/school-security.astro:dus5j6">
          <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px" data-ps="src/pages/school-security.astro:dus5j5"></div>
          <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px" data-ps="src/pages/school-security.astro:dus5j4"></div>
          <div data-ps="src/pages/school-security.astro:dus5j3">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-1" data-ps="src/pages/school-security.astro:6wplrl">[ KRE Security LLC. ]</p>
            <p class="font-sans text-dark-foreground text-lg" data-ps="src/pages/school-security.astro:6wplrk">Ready to secure your school district? Contact us today.</p>
          </div>
          <a
            href="/#contact"
            class="inline-block bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover whitespace-nowrap transition-colors duration-150"
          >
            Contact Us to Get Started
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-dot {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .status-dot::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .tactical-frame {
    position: relative;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
  }

  .tactical-frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    border-top: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
    z-index: 10;
    pointer-events: none;
  }

  .tactical-frame::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 12px;
    height: 12px;
    border-bottom: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
    z-index: 10;
    pointer-events: none;
  }

  .kre-support {
    background-color: #102032;
    border: 1px solid rgba(219, 171, 0, 0.25);
    border-radius: 20px;
    padding: 2rem;
  }

  .kre-support-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .kre-panel-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
    font-family: var(--font-heading);
  }

  .kre-status {
    display: inline-block;
    width: 8px;
    height: 8px;
    background-color: var(--color-primary);
    border-radius: 50%;
  }

  .kre-support-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .kre-support-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.086);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .kre-support-link:hover {
    background-color: rgba(245, 189, 20, 0.08);
    border-color: rgba(245, 189, 20, 0.5);
  }

  .kre-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: rgba(219, 171, 0, 0.094);
    color: var(--color-primary);
    border-radius: 9px;
    font-size: 1.125rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .kre-arrow {
    color: var(--color-primary);
    font-size: 1.125rem;
    transition: transform 0.2s ease;
  }

  .kre-support-link:hover .kre-arrow {
    transform: translate(2px, -2px);
  }

  .kre-support-note {
    font-size: 0.875rem;
    color: var(--color-dark-muted-foreground);
    text-align: center;
    margin: 0;
  }
</style>
