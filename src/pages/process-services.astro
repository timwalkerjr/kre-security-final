---
import BaseLayout from '@/layouts/BaseLayout.astro';

const documentTypes = [
  'Letters of Civil Notice of Collection of a Debt',
  'Court Ordered Subpoenas',
  'Child Custody Paperwork',
  'Hearing Notices',
  'Landlord Tenant Dispute Notices',
  'And More',
];
---

<BaseLayout
  title="Legal Process Services in Pennsylvania | KRE Security"
  description="KRE Security delivers legal paperwork in Pennsylvania, including subpoenas, custody documents, and hearing notices. Contact our investigations team."
  headerVariant="transparent"
>
  <main data-ps="src/pages/process-services.astro:53nwr3">
    <!-- Hero Section -->
    <section class="bg-dark-background pt-32 md:pt-40 pb-20" id="process-hero" data-ps="src/pages/process-services.astro:r55qo0">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/process-services.astro:eybvoa">
        <div class="max-w-3xl" data-ps="src/pages/process-services.astro:eybvob">
          <span class="inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[1.2px] text-primary mb-6" data-ps="src/pages/process-services.astro:wwboxi">
            <span class="w-2 h-2 rounded-full bg-primary inline-block" data-ps="src/pages/process-services.astro:wwboxj"></span>
            [ Dispatch Status: Active ]
          </span>
          <h1 class="font-display font-bold text-h1 text-dark-foreground uppercase tracking-tight leading-tight mb-6" data-ps="src/pages/process-services.astro:wei64o">
            Process Services
          </h1>
          <p class="font-sans text-dark-muted-foreground text-xl leading-relaxed mb-8" data-ps="src/pages/process-services.astro:ggjxdh">
            We serve all court documents such as subpoenas, summons and complaints. When we serve subpoenas for your process of service action, you can be assured that all domestic and other legal documents are properly served in accordance with your local guidelines.
          </p>
          <div class="flex flex-wrap gap-4" data-ps="src/pages/process-services.astro:eybvoc">
            <a
              href="/#contact"
              class="inline-block bg-primary text-primary-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors duration-150"
             data-ps="src/pages/process-services.astro:nkhu2j">
              Contact Us to Get Started
            </a>
            <a
              href="tel:6105620971"
              class="inline-block bg-transparent text-dark-foreground font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors duration-150"
             data-ps="src/pages/process-services.astro:nkhu2k">
              610-562-0971
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <section class="bg-surface py-20" id="process-content" data-ps="src/pages/process-services.astro:r55qnz">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/process-services.astro:eybvod">
        <div class="grid lg:grid-cols-2 gap-16 items-start" data-ps="src/pages/process-services.astro:eybvoe">
          <!-- Left Column -->
          <div data-ps="src/pages/process-services.astro:eybvof">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/process-services.astro:ggjxdi">
              [ KRE Investigations Division ]
            </p>
            <h2 class="font-display font-bold text-h2 text-foreground uppercase tracking-tight leading-tight mb-6" data-ps="src/pages/process-services.astro:ny6ymv">
              Providing Process Services
            </h2>
            <p class="font-sans text-foreground leading-relaxed mb-8" data-ps="src/pages/process-services.astro:ggjxdj">
              KRE Security Investigation division offers process services by the delivery of legal paperwork. We always provide the appropriate documentation to our clients. KRE works with local and national based law firms and private clients for their needs 24/7.
            </p>

            <p class="font-display text-xs font-bold uppercase tracking-widest text-muted-foreground mb-4" data-ps="src/pages/process-services.astro:ggjxdk">
              [ Document Types We Serve ]
            </p>
            <div class="space-y-3 mb-10" data-ps="src/pages/process-services.astro:huj8s7">
              {documentTypes.map((doc, __psIdx) => (
                <div class="flex items-start gap-3 p-4 bg-background border border-border hover:border-primary transition-colors duration-150 group" data-ps={`src/pages/process-services.astro:huj8s6-${__psIdx}`}>
                  <span class="w-2 h-2 bg-primary flex-shrink-0 mt-1.5 group-hover:shadow-[0_0_6px_var(--color-primary)]" data-ps={`src/pages/process-services.astro:wwboxk-${__psIdx}`}></span>
                  <span class="font-sans text-sm text-foreground" data-ps={`src/pages/process-services.astro:wwboxl-${__psIdx}`}>{doc}</span>
                </div>
              ))}
            </div>

            <a
              href="/#contact"
              class="inline-block bg-foreground text-background font-display font-bold text-sm uppercase tracking-widest px-8 py-4 border-2 border-foreground hover:bg-primary hover:text-foreground hover:border-primary transition-colors duration-150"
             data-ps="src/pages/process-services.astro:nkhu2l">
              Contact Us to Get Started
            </a>
          </div>

          <!-- Right Column -->
          <div class="space-y-6" data-ps="src/pages/process-services.astro:huj8s5">
            <div class="tactical-frame relative overflow-hidden border border-border" data-ps="src/pages/process-services.astro:huj8s4">
              <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary z-10" data-ps="src/pages/process-services.astro:huj8s3"></div>
              <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary z-10" data-ps="src/pages/process-services.astro:huj8s2"></div>
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/Business-Meeting-320-29c2f8-320.webp"
                alt="Process services — business meeting"
                class="w-full h-auto object-cover"
                loading="lazy" data-ps="src/pages/process-services.astro:cg2rcq" />
            </div>

            <div class="bg-dark-background p-8 relative" data-ps="src/pages/process-services.astro:huj8s1">
              <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-primary -translate-x-px -translate-y-px" data-ps="src/pages/process-services.astro:huj8s0"></div>
              <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-primary translate-x-px translate-y-px" data-ps="src/pages/process-services.astro:huj8rz"></div>
              <p class="font-display text-xs font-bold uppercase tracking-widest text-primary mb-3" data-ps="src/pages/process-services.astro:ggjxdl">
                [ Service Guarantee ]
              </p>
              <p class="font-sans text-dark-muted-foreground leading-relaxed" data-ps="src/pages/process-services.astro:ggjxdm">
                All domestic and legal documents are properly served in accordance with your local guidelines. We ensure compliance and provide full documentation to every client.
              </p>
              <div class="mt-4 pt-4 border-t border-dark-border" data-ps="src/pages/process-services.astro:huj8ry">
                <p class="font-display text-xs font-bold uppercase tracking-widest text-dark-muted-foreground" data-ps="src/pages/process-services.astro:ggjxdn">
                  Available
                </p>
                <p class="font-display text-2xl font-bold text-primary mt-1" data-ps="src/pages/process-services.astro:ggjxdo">
                  24 / 7
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
