---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = "Fire Watch Services in Pennsylvania | KRE Security";
const description = "KRE Security provides fire watch patrols for Pennsylvania properties when commercial fire systems are out of service. Contact us to discuss coverage.";
---

<BaseLayout
  title={title}
  description={description}
  headerVariant="transparent"
>
  <main data-ps="src/pages/fire-watch.astro:n8hyib">
    <!-- Hero Section -->
    <section id="fire-watch-hero" class="bg-dark-background py-20 lg:py-28" data-ps="src/pages/fire-watch.astro:d1tjnm">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/fire-watch.astro:fakmft">
        <div class="mb-6" data-ps="src/pages/fire-watch.astro:fakmfu">
          <span class="status-dot inline-flex items-center gap-2 text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/fire-watch.astro:4k5tn3">
            <span class="w-2 h-2 rounded-full bg-primary inline-block" data-ps="src/pages/fire-watch.astro:4k5tn4"></span>
            [ Fire Watch: Active ]
          </span>
        </div>
        <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground mb-6 text-h1 leading-[1.05]" data-ps="src/pages/fire-watch.astro:q4be9h">
          KRE Fire Watch<br />Services Teams
        </h1>
        <p class="text-lg max-w-2xl text-dark-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:bjoqto">
          No two sites are the same. Our guards must be acutely aware of the unique needs of each client — meeting local codes enforcement and providing an extra layer of protection when commercial systems are not in operation.
        </p>
      </div>
    </section>

    <!-- Duties Section -->
    <section id="fire-watch-duties" class="bg-surface py-16 lg:py-24" data-ps="src/pages/fire-watch.astro:d1tjnl">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-ps="src/pages/fire-watch.astro:fakmfv">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start" data-ps="src/pages/fire-watch.astro:yv2mkt">
          <!-- Left Column -->
          <div data-ps="src/pages/fire-watch.astro:yv2mku">
            <div class="mb-3" data-ps="src/pages/fire-watch.astro:yv2mkv">
              <span class="text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/fire-watch.astro:4k5tn5">
                [ Guard Responsibilities ]
              </span>
            </div>
            <h2 class="font-display font-bold uppercase tracking-tight text-foreground mb-8 text-h2 leading-[1.1]" data-ps="src/pages/fire-watch.astro:u8dqhg">
              What Our Fire Watch Guards Will Do
            </h2>
            <ul class="space-y-4">
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxc">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5tn6"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5tn7">Watch for signs of a fire such as smoke, increased temperatures, flames or odors via hourly patrols of your property.</span>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxd">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5tn8"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5tn9">Identify other potential hazards that could pose safety issues or impede the ability of emergency response teams to combat a fire.</span>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxe">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5tna"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5tnw">Check exits to make sure there are no blockages or other hazards that would prevent an evacuation.</span>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxf">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5tnx"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5tny">Verify that fire extinguishers are present and in working order.</span>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxg">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5tnz"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5to0">Carry appropriate supplies that would allow them to combat a small fire or assist in evacuation procedures such as fire extinguishers, flashlights, building keys and communication devices.</span>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxh">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5to1"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5to2">Understand the building layout and evacuation procedures.</span>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxi">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5to3"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5to4">Possess pertinent contact information for business owners or other business contacts as well as local law enforcement and fire departments.</span>
              </li>
              <li class="flex gap-3 items-start" data-ps="src/pages/fire-watch.astro:uzcmxj">
                <span class="mt-[6px] w-2 h-2 flex-shrink-0 rounded-full bg-primary" data-ps="src/pages/fire-watch.astro:4k5to5"></span>
                <span class="text-muted-foreground leading-relaxed" data-ps="src/pages/fire-watch.astro:4k5tor">Call 911 and provide emergency assistance to reduce property loss.</span>
              </li>
            </ul>

            <div class="mt-8 pt-6 border-t border-border" data-ps="src/pages/fire-watch.astro:yv2mkw">
              <p class="text-muted-foreground leading-relaxed text-sm" data-ps="src/pages/fire-watch.astro:bjoqtn">
                Depending on the severity of the risk, KRE fire watch patrols will make their rounds at regular intervals until the danger is mitigated. Guards are required to keep a log of each patrol round, including date and time, name of the patrolling guard, status of the patrol, and record of any incident. Unless they are certain they can safely manage a situation, guards do not attempt to extinguish fires on the premises.
              </p>
            </div>
          </div>

          <!-- Right Column -->
          <div class="flex flex-col gap-6" data-ps="src/pages/fire-watch.astro:yv2mkx">
            <div class="overflow-hidden bg-background inline-block self-start border border-border" data-ps="src/pages/fire-watch.astro:yv2mky">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/Fire-260-f91422-260.webp"
                alt="Fire watch security services"
                width="260"
                height="195"
                class="max-w-[260px] h-auto object-cover"
                loading="lazy" data-ps="src/pages/fire-watch.astro:csbi48" />
            </div>

            <div class="border border-dark-border p-5 bg-dark-background" data-ps="src/pages/fire-watch.astro:yv2mkz">
              <p class="text-xs font-display font-bold uppercase tracking-widest mb-2 text-primary" data-ps="src/pages/fire-watch.astro:bjoqtm">
                [ Patrol Log Requirement ]
              </p>
              <p class="text-sm leading-relaxed text-dark-muted-foreground" data-ps="src/pages/fire-watch.astro:bjoqtl">
                Guards are required to keep a log of each patrol round that includes date and time, the name of the patrolling guard, status of the patrol, and a record of any incident observed.
              </p>
            </div>

            <div class="border-l-2 pl-4 border-primary" data-ps="src/pages/fire-watch.astro:yv2ml0">
              <p class="text-sm font-display font-bold uppercase tracking-wide text-foreground mb-1" data-ps="src/pages/fire-watch.astro:bjoqtk">
                24-Hour Emergency Dispatch
              </p>
              <a href="tel:6105620971" class="text-xl font-display font-bold text-primary hover:text-primary-hover transition-colors" data-ps="src/pages/fire-watch.astro:4fqu5n">
                610-562-0971
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="fire-watch-cta" class="py-16 lg:py-20 border-t border-dark-border bg-dark-background" data-ps="src/pages/fire-watch.astro:d1tjnk">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center" data-ps="src/pages/fire-watch.astro:yv2ml1">
        <div class="mb-4" data-ps="src/pages/fire-watch.astro:yv2ml2">
          <span class="status-dot inline-flex items-center gap-2 text-xs font-display font-bold uppercase tracking-widest text-primary" data-ps="src/pages/fire-watch.astro:4k5tos">
            <span class="w-2 h-2 rounded-full bg-primary inline-block" data-ps="src/pages/fire-watch.astro:4k5tot"></span>
            [ Ready to Respond ]
          </span>
        </div>
        <h2 class="font-display font-bold uppercase tracking-tight mb-4 text-dark-foreground text-h2 leading-[1.1]" data-ps="src/pages/fire-watch.astro:u8dqi2">
          Protect Your Property<br />with Fire Watch Services
        </h2>
        <p class="max-w-xl mx-auto mb-8 leading-relaxed text-dark-muted-foreground" data-ps="src/pages/fire-watch.astro:bjoqtj">
          Contact KRE Security today to schedule professional fire watch services for your facility in Eastern Pennsylvania.
        </p>
        <a
          href="/contact/"
          class="inline-block border-2 font-display font-bold uppercase tracking-wider text-sm px-8 py-3 transition-colors duration-150 border-primary bg-primary text-primary-foreground hover:bg-primary-hover hover:border-primary-hover"
         data-ps="src/pages/fire-watch.astro:4fqu5m">
          Contact Us Today to Get Started
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
