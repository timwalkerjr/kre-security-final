---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Contact KRE Security | Pennsylvania Security Services';
const description =
  'Contact KRE Security for security guards, investigations, and training in Pennsylvania. Call 610-562-0971 for our main office and 24-hour emergency dispatch.';
---

<BaseLayout
  title={title}
  description={description}
  headerVariant="transparent"
>
  <main data-ps="src/pages/contact.astro:5wycz7">
    <!-- Section 1: Hero -->
    <section class="bg-dark-background py-20 border-b border-dark-border" data-ps="src/pages/contact.astro:76y6m6">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/contact.astro:uoopcp">
        <div class="text-center" data-ps="src/pages/contact.astro:uoopdb">
          <p class="status-dot mb-4" data-ps="src/pages/contact.astro:wmga3y">[ Dispatch Status: Active ]</p>
          <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground text-h1 mb-4" data-ps="src/pages/contact.astro:xwwez0">
            24 Hour Service
          </h1>
          <p class="text-dark-muted-foreground text-lg font-sans mb-2" data-ps="src/pages/contact.astro:wmga3x">
            Meeting Your Security and Investigation Needs
          </p>
          <p class="text-dark-muted-foreground text-lg font-sans mb-8" data-ps="src/pages/contact.astro:wmga3w">
            All Hours of The Day!
          </p>
          <div class="inline-flex flex-col sm:flex-row items-center gap-4" data-ps="src/pages/contact.astro:uoopdc">
            <a
              href="tel:6105620971"
              class="inline-flex items-center gap-3 bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors"
             data-ps="src/pages/contact.astro:piidgj">
              <span class="status-dot before:w-2 before:h-2" data-ps="src/pages/contact.astro:lvpf63"></span>
              610-562-0971
            </a>
            <span class="text-dark-muted-foreground font-display text-xs uppercase tracking-widest" data-ps="src/pages/contact.astro:lvpf64">
              24/7 Scheduling Available
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Pennsylvania Offices -->
    <section class="bg-surface py-20 border-b border-border" data-ps="src/pages/contact.astro:76y6m7">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/contact.astro:uoopdd">
        <div class="mb-12" data-ps="src/pages/contact.astro:uoopde">
          <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-2" data-ps="src/pages/contact.astro:wmga3v">
            [ Office Locations ]
          </p>
          <h2 class="font-display font-bold uppercase tracking-tight text-foreground text-h2" data-ps="src/pages/contact.astro:j8hhre">
            Our Pennsylvania Offices
          </h2>
        </div>

        <!-- 3 Office Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16" data-ps="src/pages/contact.astro:uoopdf">
          <div class="tactical-frame p-6 bg-background" data-ps="src/pages/contact.astro:uoopdg">
            <p class="font-display text-xs uppercase tracking-widest text-primary mb-3" data-ps="src/pages/contact.astro:wmga3u">
              Emergency Security Guard Services
            </p>
            <h3 class="font-display font-bold text-foreground text-base uppercase mb-3 leading-tight" data-ps="src/pages/contact.astro:4k2kj5">
              KRE Security Main Office
            </h3>
            <address class="not-italic font-sans text-muted-foreground text-sm mb-4 leading-relaxed">
              16600 Pottsville Pike<br />
              Hamburg, PA 19526
            </address>
            <a
              href="tel:6105620971"
              class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm uppercase tracking-wide inline-block"
             data-ps="src/pages/contact.astro:piidgi">
              610-562-0971
            </a>
          </div>

          <div class="tactical-frame p-6 bg-background" data-ps="src/pages/contact.astro:uoopdh">
            <p class="font-display text-xs uppercase tracking-widest text-primary mb-3" data-ps="src/pages/contact.astro:wmga3t">
              Appointment Only
            </p>
            <h3 class="font-display font-bold text-foreground text-base uppercase mb-3 leading-tight" data-ps="src/pages/contact.astro:4k2kj6">
              KRE Security LLC — Reading Office
            </h3>
            <address class="not-italic font-sans text-muted-foreground text-sm mb-4 leading-relaxed">
              530 Walnut Street, 1st Floor Ste. 2<br />
              Reading, PA 19601
            </address>
            <a
              href="tel:6105620971"
              class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm uppercase tracking-wide inline-block"
             data-ps="src/pages/contact.astro:piidfw">
              610-562-0971
            </a>
          </div>

          <div class="tactical-frame p-6 bg-background" data-ps="src/pages/contact.astro:uoopdi">
            <p class="font-display text-xs uppercase tracking-widest text-primary mb-3" data-ps="src/pages/contact.astro:wmga3s">
              Walk-in Appointments Are Welcomed!
            </p>
            <h3 class="font-display font-bold text-foreground text-base uppercase mb-3 leading-tight" data-ps="src/pages/contact.astro:4k2kjs">
              Harrisburg / Susquehanna Valley Regional Office
            </h3>
            <address class="not-italic font-sans text-muted-foreground text-sm mb-4 leading-relaxed">
              3405 North 6th Street, Suite 204<br />
              Harrisburg, PA 17110
            </address>
            <a
              href="tel:7174802961"
              class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm uppercase tracking-wide inline-block"
             data-ps="src/pages/contact.astro:piidfv">
              717-480-2961
            </a>
            <p class="font-sans text-muted-foreground text-xs mt-1" data-ps="src/pages/contact.astro:wmga3r">
              Fax: 484-660-3571
            </p>
          </div>
        </div>

        <!-- Regional Dispatch Lines -->
        <div class="border border-border bg-background p-8" data-ps="src/pages/contact.astro:uoopdj">
          <div class="flex items-center gap-3 mb-6" data-ps="src/pages/contact.astro:uoopdk">
            <span class="status-dot" data-ps="src/pages/contact.astro:lvpf65">[ Regional Dispatch Lines ]</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-ps="src/pages/contact.astro:uoope6">
            <div class="flex items-center justify-between border-b border-border pb-3" data-ps="src/pages/contact.astro:uoope7">
              <span class="font-sans text-sm text-muted-foreground" data-ps="src/pages/contact.astro:lvpf66">Allentown / Bethlehem / Easton</span>
              <a
                href="tel:6105620971"
                class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm ml-4 shrink-0"
               data-ps="src/pages/contact.astro:piidfu">
                610-562-0971
              </a>
            </div>

            <div class="flex items-center justify-between border-b border-border pb-3" data-ps="src/pages/contact.astro:uoope8">
              <span class="font-sans text-sm text-muted-foreground" data-ps="src/pages/contact.astro:lvpf67">Lancaster / Lebanon County</span>
              <a
                href="tel:7174507632"
                class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm ml-4 shrink-0"
               data-ps="src/pages/contact.astro:piidft">
                717-450-7632
              </a>
            </div>

            <div class="flex items-center justify-between border-b border-border pb-3" data-ps="src/pages/contact.astro:uoope9">
              <span class="font-sans text-sm text-muted-foreground" data-ps="src/pages/contact.astro:lvpf68">Reading / Pottstown Office</span>
              <a
                href="tel:6105620971"
                class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm ml-4 shrink-0"
               data-ps="src/pages/contact.astro:piidfs">
                610-562-0971
              </a>
            </div>

            <div class="flex items-center justify-between border-b border-border pb-3" data-ps="src/pages/contact.astro:uoopea">
              <span class="font-sans text-sm text-muted-foreground" data-ps="src/pages/contact.astro:lvpf69">Schuylkill County</span>
              <a
                href="tel:5703991010"
                class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm ml-4 shrink-0"
               data-ps="src/pages/contact.astro:piidfr">
                570-399-1010
              </a>
            </div>

            <div class="flex items-center justify-between border-b border-border pb-3" data-ps="src/pages/contact.astro:uoopeb">
              <span class="font-sans text-sm text-muted-foreground" data-ps="src/pages/contact.astro:lvpf6a">Investigations</span>
              <a
                href="tel:6105620971"
                class="font-display font-bold text-foreground hover:text-primary transition-colors text-sm ml-4 shrink-0"
               data-ps="src/pages/contact.astro:piidfq">
                610-562-0971
              </a>
            </div>
          </div>

          <div class="mt-6 pt-6 border-t border-border text-center" data-ps="src/pages/contact.astro:uoopec">
            <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-2" data-ps="src/pages/contact.astro:wmga35">
              24-Hour Emergency Contact
            </p>
            <a
              href="tel:6105620971"
              class="font-display font-bold text-h3 text-primary hover:text-primary-hover transition-colors uppercase tracking-wide"
             data-ps="src/pages/contact.astro:piidfp">
              610-562-0971
            </a>
            <p class="font-sans text-xs text-muted-foreground mt-1 uppercase tracking-widest" data-ps="src/pages/contact.astro:wmga34">
              Free Consultations Available
            </p>
          </div>
        </div>

        <p class="text-center font-sans text-sm text-muted-foreground mt-6" data-ps="src/pages/contact.astro:wmga33">
          We accept Cash, Check, and major payment methods.
        </p>
      </div>
    </section>

    <!-- Section 3: Contact Form & Client Feedback -->
    <section id="contact-form" class="bg-dark-background py-20" data-ps="src/pages/contact.astro:76y6m8">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/contact.astro:uooped">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start" data-ps="src/pages/contact.astro:uoopee">
          <!-- Left Column: Form -->
          <div data-ps="src/pages/contact.astro:uoopef">
            <p class="font-display text-xs uppercase tracking-widest text-primary mb-3" data-ps="src/pages/contact.astro:wmga32">
              [ Get A Quote ]
            </p>
            <h2 class="font-display font-bold uppercase tracking-tight text-dark-foreground text-h2 mb-6" data-ps="src/pages/contact.astro:j8hhrf">
              Contact Us
            </h2>
            <p class="font-sans text-dark-muted-foreground mb-8 text-sm leading-relaxed" data-ps="src/pages/contact.astro:wmga31">
              Fill in your name, phone, email and we will contact you to discuss your security needs.
            </p>

            <div id="contact-status" class="hidden mb-6 px-4 py-3 rounded" data-ps="src/pages/contact.astro:lx8n1r"></div>

            <form id="contact-form-element" class="space-y-4">
              <input type="hidden" name="_formId" value="contact" />
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/contact.astro:lx8n1q">
                <div data-ps="src/pages/contact.astro:lx8n1p">
                  <label
                    for="first-name"
                    class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2"
                   data-ps="src/pages/contact.astro:zcrc3m">
                    First Name <span class="text-primary" data-ps="src/pages/contact.astro:lvpf6b">*</span>
                  </label>
                  <input
                    type="text"
                    id="first-name"
                    name="first-name"
                    required
                    class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground"
                    placeholder="First name"
                  />
                </div>
                <div data-ps="src/pages/contact.astro:lx8n1o">
                  <label
                    for="last-name"
                    class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2"
                   data-ps="src/pages/contact.astro:zcrc3l">
                    Last Name
                  </label>
                  <input
                    type="text"
                    id="last-name"
                    name="last-name"
                    class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground"
                    placeholder="Last name"
                  />
                </div>
              </div>

              <div data-ps="src/pages/contact.astro:lx8n1n">
                <label
                  for="email"
                  class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2"
                 data-ps="src/pages/contact.astro:zcrc3k">
                  Email <span class="text-primary" data-ps="src/pages/contact.astro:lvpf6c">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground"
                  placeholder="your@email.com"
                />
              </div>

              <div data-ps="src/pages/contact.astro:lx8n1m">
                <label
                  for="message"
                  class="block font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-2"
                 data-ps="src/pages/contact.astro:zcrc3j">
                  Message
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  class="w-full bg-transparent border border-dark-border text-dark-foreground font-sans text-sm px-4 py-3 focus:outline-none focus:border-primary transition-colors placeholder:text-dark-muted-foreground resize-none"
                  placeholder="Describe your security needs..."></textarea>
              </div>

              <!-- Invisible captcha widget -->
              <altcha-widget
                challenge="/psapi-internal-v1/altcha/challenge"
                display="invisible"
                auto="onfocus"
              ></altcha-widget>

              <button
                type="submit"
                id="contact-submit"
                class="w-full bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors cursor-pointer"
               data-ps="src/pages/contact.astro:qxoi6s">
                Submit Request
              </button>
            </form>
          </div>

          <!-- Right Column: Client Feedback & Main Office Info -->
          <div data-ps="src/pages/contact.astro:lx8n1l">
            <div class="tactical-frame border-dark-border p-8 bg-secondary" data-ps="src/pages/contact.astro:lx8n1k">
              <p class="font-display text-xs uppercase tracking-widest text-primary mb-3" data-ps="src/pages/contact.astro:wmga30">
                [ Client Feedback ]
              </p>
              <h3 class="font-display font-bold text-dark-foreground text-h3 uppercase mb-4" data-ps="src/pages/contact.astro:4k2kjt">
                Tell Us How We're Doing!
              </h3>
              <p class="font-sans text-dark-muted-foreground text-sm mb-8 leading-relaxed" data-ps="src/pages/contact.astro:wmga2z">
                We value our clients' opinions. Please take a moment to leave us a review on our Facebook or Google pages!
              </p>

              <div class="space-y-4" data-ps="src/pages/contact.astro:lx8n1j">
                <a
                  href="https://www.facebook.com/KREsecinvestigations/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 border border-dark-border px-5 py-4 hover:border-primary hover:bg-dark-background transition-colors group"
                 data-ps="src/pages/contact.astro:piidfo">
                  <svg
                    class="w-5 h-5 text-primary shrink-0"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                    ></path>
                  </svg>
                  <span class="font-display font-bold text-dark-foreground text-xs uppercase tracking-widest group-hover:text-primary transition-colors" data-ps="src/pages/contact.astro:lvpf6y">
                    Review on Facebook
                  </span>
                </a>

                <a
                  href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.986583,17z"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 border border-dark-border px-5 py-4 hover:border-primary hover:bg-dark-background transition-colors group"
                 data-ps="src/pages/contact.astro:piidfn">
                  <svg
                    class="w-5 h-5 text-primary shrink-0"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                    ></path>
                  </svg>
                  <span class="font-display font-bold text-dark-foreground text-xs uppercase tracking-widest group-hover:text-primary transition-colors" data-ps="src/pages/contact.astro:lvpf6z">
                    Review on Google
                  </span>
                </a>
              </div>

              <div class="mt-8 pt-8 border-t border-dark-border" data-ps="src/pages/contact.astro:lx8n1i">
                <p class="font-display text-xs uppercase tracking-widest text-dark-muted-foreground mb-3" data-ps="src/pages/contact.astro:wmga2y">
                  [ Main Office ]
                </p>
                <address class="not-italic font-sans text-dark-foreground text-sm leading-relaxed">
                  16600 Pottsville Pike<br />
                  Hamburg, PA 19526
                </address>
                <a
                  href="https://maps.google.com/?q=KRE+Security+LLC,+16600+Pottsville+Pike,+Hamburg,+PA+19526"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block mt-3 font-display text-xs uppercase tracking-widest text-primary hover:text-primary-hover transition-colors"
                >
                  Get Directions →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .font-display {
    font-family: var(--font-heading);
  }

  .status-dot {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .status-dot::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary);
  }

  .tactical-frame {
    position: relative;
    border: 1px solid var(--color-border);
  }

  .tactical-frame.border-dark-border {
    border-color: var(--color-dark-border);
  }

  .tactical-frame::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
    pointer-events: none;
  }

  .tactical-frame::after {
    content: '';
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    border-bottom: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
    pointer-events: none;
  }
</style>

<script>
  import 'altcha';

  const form = document.getElementById('contact-form-element') as HTMLFormElement | null;
  const status = document.getElementById('contact-status') as HTMLDivElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !status) return;

    submitBtn.disabled = true;
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Submitting...';

    const formData = new FormData(form);

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: formData.get('_formId') || 'contact',
          name: [formData.get('first-name'), formData.get('last-name')].filter(Boolean).join(' '),
          'first-name': formData.get('first-name'),
          'last-name': formData.get('last-name'),
          email: formData.get('email'),
          message: formData.get('message'),
          altcha: formData.get('altcha'),
        }),
      });

      const result = await response.json();

      if (result.success) {
        status.className = 'mb-6 px-4 py-3 rounded border bg-green-950/50 border-green-500/50 text-green-300 font-sans text-sm';
        status.textContent = 'Thank you! Your request has been sent. We will contact you shortly.';
        form.reset();
      } else {
        throw new Error(result.error || 'Failed to submit form');
      }
    } catch (err) {
      status.className = 'mb-6 px-4 py-3 rounded border bg-red-950/50 border-red-500/50 text-red-300 font-sans text-sm';
      status.textContent = err instanceof Error ? err.message : 'Failed to send. Please call us directly at 610-562-0971.';
    } finally {
      status.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
