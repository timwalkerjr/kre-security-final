---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = "Event Traffic Control in Pennsylvania | KRE Security";
const pageDescription = "Keep vehicles and guests moving safely with KRE Security’s event traffic control services in Pennsylvania. Plan staffing for events of all sizes.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  headerVariant="transparent"
>
  <main data-ps="src/pages/event-traffic-control.astro:w12akk">
    {/* Hero Section */}
    <section class="bg-dark-background py-20 border-b border-dark-border" data-ps="src/pages/event-traffic-control.astro:93y6vf">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/event-traffic-control.astro:s6mar5">
        <div class="max-w-3xl" data-ps="src/pages/event-traffic-control.astro:s6mar4">
          <p class="font-display font-bold uppercase tracking-widest text-xs text-primary mb-4 flex items-center gap-2.5" data-ps="src/pages/event-traffic-control.astro:3ox569">
            <span class="w-2 h-2 rounded-full bg-primary inline-block shrink-0" data-ps="src/pages/event-traffic-control.astro:b7dz98"></span>
            [ Public Safety Services ]
          </p>
          <h1 class="font-display font-bold uppercase tracking-tight text-dark-foreground text-h1 mb-4 leading-tight" data-ps="src/pages/event-traffic-control.astro:73fpj2">
            Event Traffic Control Services
          </h1>
          <p class="font-sans text-dark-muted-foreground text-lg leading-relaxed mb-8" data-ps="src/pages/event-traffic-control.astro:3ox568">
            KRE Security LLC. has been providing large and small scale traffic control services and safety across Pennsylvania — from 200 vehicles to events with 35,000+ attendees.
          </p>
          <a
            href="/contact/"
            class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors"
           data-ps="src/pages/event-traffic-control.astro:3f0rhw">
            Contact Us Today to Get Started
          </a>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="bg-background py-20" data-ps="src/pages/event-traffic-control.astro:93y6ve">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/event-traffic-control.astro:s6mar3">
        {/* Top Info Grid */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-16" data-ps="src/pages/event-traffic-control.astro:ennkh5">
          <div data-ps="src/pages/event-traffic-control.astro:ennkh4">
            <p class="font-display text-xs uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/event-traffic-control.astro:3ox567">
              [ Traffic Safety Specialists ]
            </p>
            <h2 class="font-display font-bold uppercase tracking-tight text-foreground text-h2 mb-6" data-ps="src/pages/event-traffic-control.astro:lrumqn">
              Professional Traffic Control Across Eastern PA
            </h2>
            <div class="space-y-4 font-sans text-muted-foreground text-sm leading-relaxed" data-ps="src/pages/event-traffic-control.astro:ennkh3">
              <p data-ps="src/pages/event-traffic-control.astro:3ox55l">
                KRE Security provides traffic control services for Concerts, High School/College sporting events, facility ingress and egress, to assist with traffic moving in and out of businesses, parking garages, churches, events, and more.
              </p>
              <p data-ps="src/pages/event-traffic-control.astro:3ox55k">
                Our officers comply with local and state traffic laws to keep traffic flow moving and keep drivers, cyclists, and pedestrians safe. KRE staff retain professional based instruction and certification to provide professional based services for any event across Eastern Pennsylvania.
              </p>
              <p data-ps="src/pages/event-traffic-control.astro:3ox55j">
                KRE works alongside Local and State Police in addition to numerous emergency service organizations during our events.
              </p>
              <p data-ps="src/pages/event-traffic-control.astro:3ox55i">
                Custom based traffic control service and safety plans are created with client based input and implementation. The safe and systematic parking of vehicles and event traffic management is crucial to the ultimate safety and enjoyment of an event. Done correctly, it will alleviate congestion and frustration, bringing a positive effect and potential for repeat business.
              </p>
            </div>
          </div>

          <div data-ps="src/pages/event-traffic-control.astro:ennkh2">
            <div class="tactical-frame overflow-hidden" data-ps="src/pages/event-traffic-control.astro:ennkh1">
              <img
                src="https://pagesmith-cdn.com/fe6bcc20/images/traffic-control_JPG-320-16d4bd-320.webp"
                alt="KRE Security traffic control services"
                class="max-w-[320px] w-full h-auto object-cover"
                loading="lazy"
                width="320"
                height="213" data-ps="src/pages/event-traffic-control.astro:uovf2p" />
            </div>
          </div>
        </div>

        {/* Feature Cards Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12" data-ps="src/pages/event-traffic-control.astro:ennkh0">
          {/* Events We Serve */}
          <div class="tactical-frame bg-surface p-8" data-ps="src/pages/event-traffic-control.astro:ennkgz">
            <p class="font-display text-xs uppercase tracking-widest text-primary mb-4" data-ps="src/pages/event-traffic-control.astro:3ox55h">
              [ Events We Serve ]
            </p>
            <h3 class="font-display font-bold text-foreground uppercase text-sm mb-5 tracking-tight" data-ps="src/pages/event-traffic-control.astro:ykui09">
              Event Types
            </h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqc8">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz97">▸</span>
                Concerts
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqc7">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz96">▸</span>
                High School &amp; College Sporting Events
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqc6">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz95">▸</span>
                Large-Scale Facility Ingress/Egress
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqc5">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz94">▸</span>
                Business Parking &amp; Traffic Management
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqc4">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz93">▸</span>
                Parking Garages
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqc3">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz92">▸</span>
                Churches &amp; Community Events
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqc2">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz91">▸</span>
                Events 200–15,000 Vehicles
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqbg">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz90">▸</span>
                Large-Scale Events 35,000+ Attendees
              </li>
            </ul>
          </div>

          {/* Field Equipment */}
          <div class="tactical-frame bg-surface p-8" data-ps="src/pages/event-traffic-control.astro:ennkgy">
            <p class="font-display text-xs uppercase tracking-widest text-primary mb-4" data-ps="src/pages/event-traffic-control.astro:3ox55g">
              [ Field Equipment ]
            </p>
            <h3 class="font-display font-bold text-foreground uppercase text-sm mb-5 tracking-tight" data-ps="src/pages/event-traffic-control.astro:ykui0a">
              Equipment Provided
            </h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqbf">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz8e">▸</span>
                Private radios for real-time coordination
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqbe">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz8d">▸</span>
                Traffic signal hand wands
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqbd">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz8c">▸</span>
                Traffic cones and DOT-approved signs
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqbc">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz8b">▸</span>
                ANSI and DOT approved reflective vests
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqbb">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz8a">▸</span>
                Portable lighting systems
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqba">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz89">▸</span>
                Roadway flairs
              </li>
              <li class="flex items-start gap-3 font-sans text-muted-foreground text-sm" data-ps="src/pages/event-traffic-control.astro:l0vqb9">
                <span class="text-primary mt-0.5 shrink-0 font-bold" data-ps="src/pages/event-traffic-control.astro:b7dz88">▸</span>
                Highly-visible uniformed staff
              </li>
            </ul>
          </div>
        </div>

        {/* Planning an Event CTA */}
        <div class="bg-dark-background border border-dark-border p-10 text-center" data-ps="src/pages/event-traffic-control.astro:ennkgx">
          <p class="font-display text-xs uppercase tracking-widest text-primary mb-3" data-ps="src/pages/event-traffic-control.astro:3ox55f">
            [ Request a Custom Traffic Plan ]
          </p>
          <h3 class="font-display font-bold text-dark-foreground uppercase text-h3 mb-4" data-ps="src/pages/event-traffic-control.astro:ykui0w">
            Planning an Event?
          </h3>
          <p class="font-sans text-dark-muted-foreground text-sm max-w-xl mx-auto mb-6 leading-relaxed" data-ps="src/pages/event-traffic-control.astro:3ox55e">
            Custom traffic control service and safety plans are created with client-based input and implementation. Contact us today to discuss your event needs.
          </p>
          <div class="flex flex-wrap justify-center gap-4" data-ps="src/pages/event-traffic-control.astro:ennkgw">
            <a
              href="/contact/"
              class="inline-block bg-primary text-primary-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-primary hover:bg-primary-hover transition-colors"
             data-ps="src/pages/event-traffic-control.astro:3f0rhx">
              Get a Free Consultation
            </a>
            <a
              href="tel:6105620971"
              class="inline-block bg-transparent text-dark-foreground font-display font-bold uppercase tracking-widest text-sm px-8 py-4 border-2 border-dark-border hover:border-primary hover:text-primary transition-colors"
             data-ps="src/pages/event-traffic-control.astro:3f0rij">
              610-562-0971
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tactical-frame {
    position: relative;
    border: 1px solid var(--color-border);
  }
  .tactical-frame::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 12px;
    height: 12px;
    border-top: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
    pointer-events: none;
  }
  .tactical-frame::after {
    content: '';
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 12px;
    height: 12px;
    border-bottom: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
    pointer-events: none;
  }
</style>
