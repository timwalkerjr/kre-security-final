---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = "Client Testimonials & Reviews | KRE Security";
const pageDescription = "Read client feedback about KRE Security’s security services, customer support, and training. Learn about experiences with our Pennsylvania team.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  headerVariant="transparent"
>
  <main data-ps="src/pages/testimonials.astro:9mjp2y">
    <!-- Hero Header -->
    <section class="bg-dark-background py-20 border-b border-dark-border" data-ps="src/pages/testimonials.astro:u0huo5">
      <div class="max-w-7xl mx-auto px-6 text-center" data-ps="src/pages/testimonials.astro:5h6ndh">
        <p class="status-dot justify-center mb-4" data-ps="src/pages/testimonials.astro:ozbzv8">[ Client Reviews ]</p>
        <h1 class="font-heading font-bold uppercase tracking-tight text-dark-foreground text-h1" data-ps="src/pages/testimonials.astro:bn5exc">
          Testimonials
        </h1>
        <p class="font-sans text-dark-muted-foreground mt-4 text-lg max-w-2xl mx-auto" data-ps="src/pages/testimonials.astro:ozbzv9">
          What our clients say about KRE Security's professional services across Eastern Pennsylvania.
        </p>
      </div>
    </section>

    <!-- Testimonials Grid -->
    <section class="bg-background py-20" data-ps="src/pages/testimonials.astro:u0huo4">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/pages/testimonials.astro:5h6ndi">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8" data-ps="src/pages/testimonials.astro:5h6ndj">
          <!-- Card 1 -->
          <div class="tactical-frame bg-surface p-8 flex flex-col" data-ps="src/pages/testimonials.astro:dkkb8v">
            <div class="text-primary font-heading text-5xl font-bold leading-none mb-4 select-none" aria-hidden="true" data-ps="src/pages/testimonials.astro:dkkb8u">"</div>
            <blockquote class="font-sans text-foreground text-sm leading-relaxed flex-1 mb-6">
              I have worked with KRE Security for over 15 years, as our facilities primary full time Security team. They helped us with securing over 200 hours per week of security guard services. Jarrod and Jim's team go above and beyond to meet our needs. We have used larger scale firms in past but KRE has been far been the best fit for our facility. I recommend any and all large scale projects to go with the KRE team here in Berks County.
            </blockquote>
            <footer class="border-t border-border pt-4" data-ps="src/pages/testimonials.astro:wpkwef">
              <p class="font-heading font-bold text-foreground text-sm uppercase tracking-wide" data-ps="src/pages/testimonials.astro:ozbzva">
                — John Lubas
              </p>
              <p class="font-sans text-muted-foreground text-xs mt-1" data-ps="src/pages/testimonials.astro:ozbzvb">
                Faculty Director, Community Out Reach
              </p>
            </footer>
          </div>

          <!-- Card 2 -->
          <div class="tactical-frame bg-surface p-8 flex flex-col" data-ps="src/pages/testimonials.astro:dkkb8t">
            <div class="text-primary font-heading text-5xl font-bold leading-none mb-4 select-none" aria-hidden="true" data-ps="src/pages/testimonials.astro:dkkb8s">"</div>
            <blockquote class="font-sans text-foreground text-sm leading-relaxed flex-1 mb-6">
              KRE Security/Investigations Inc. was contracted for a full-time, unarmed security guard for about a month during school hours, in 2015, after a heroin overdose took place on campus. KRE provides security to the district for sporting events. Jarrod/KRE Security Staff and the state police have been phenomenal.
            </blockquote>
            <footer class="border-t border-border pt-4" data-ps="src/pages/testimonials.astro:wpkweg">
              <p class="font-heading font-bold text-foreground text-sm uppercase tracking-wide" data-ps="src/pages/testimonials.astro:ozbzvx">
                — Andrew M. Potteiger
              </p>
              <p class="font-sans text-muted-foreground text-xs mt-1" data-ps="src/pages/testimonials.astro:ozbzvy">
                School Administrator
              </p>
            </footer>
          </div>

          <!-- Card 3 -->
          <div class="tactical-frame bg-surface p-8 flex flex-col" data-ps="src/pages/testimonials.astro:dkkb8r">
            <div class="text-primary font-heading text-5xl font-bold leading-none mb-4 select-none" aria-hidden="true" data-ps="src/pages/testimonials.astro:dkkb8q">"</div>
            <blockquote class="font-sans text-foreground text-sm leading-relaxed flex-1 mb-6">
              KRE is a terrific business partner and supplier of security services to my company. Their employees are very professional and their rates are very competitive. I highly recommend KRE to anyone looking to improve their security services.
            </blockquote>
            <footer class="border-t border-border pt-4" data-ps="src/pages/testimonials.astro:wpkweh">
              <p class="font-heading font-bold text-foreground text-sm uppercase tracking-wide" data-ps="src/pages/testimonials.astro:ozbzvz">
                — Anonymous
              </p>
              <p class="font-sans text-muted-foreground text-xs mt-1" data-ps="src/pages/testimonials.astro:ozbzw0">
                Manufacturing Facility Manager, Carbon County, PA
              </p>
            </footer>
          </div>

          <!-- Card 4 -->
          <div class="tactical-frame bg-surface p-8 flex flex-col" data-ps="src/pages/testimonials.astro:dkkb8p">
            <div class="text-primary font-heading text-5xl font-bold leading-none mb-4 select-none" aria-hidden="true" data-ps="src/pages/testimonials.astro:dkkb8o">"</div>
            <blockquote class="font-sans text-foreground text-sm leading-relaxed flex-1 mb-6">
              I am very satisfied with KRE Security Investigations, Inc. I called on a Wednesday about a project I was hoping the company could help with involving pictures of a residence. Jarrod was polite, and eager to assist in whatever way necessary. He was able to take 28 photographs for me within 2 days of my request, and captured all the details that I had asked for. The photos were delivered promptly, and there was great follow-up from Jarrod afterwards. Overall I am pleased with the work that was done, and how easy it was to communicate with the company via phone and email. The price was reasonable, and so I would recommend KRE to anyone needing investigative work done.
            </blockquote>
            <footer class="border-t border-border pt-4" data-ps="src/pages/testimonials.astro:wpkwei">
              <p class="font-heading font-bold text-foreground text-sm uppercase tracking-wide" data-ps="src/pages/testimonials.astro:ozbzw1">
                — Lisa McLean
              </p>
              <p class="font-sans text-muted-foreground text-xs mt-1" data-ps="src/pages/testimonials.astro:ozbzw2">
                Client, New Jersey
              </p>
            </footer>
          </div>
        </div>

        <!-- Share Experience Callout -->
        <div class="mt-16 text-center border border-border bg-surface p-10" data-ps="src/pages/testimonials.astro:dkkb8n">
          <p class="font-heading text-xs uppercase tracking-widest text-muted-foreground mb-3" data-ps="src/pages/testimonials.astro:ozbzw3">
            [ Share Your Experience ]
          </p>
          <h2 class="font-heading font-bold uppercase text-foreground text-h3 mb-4" data-ps="src/pages/testimonials.astro:qbkc4x">
            Let Us Know Your Experience with KRE Security
          </h2>
          <p class="font-sans text-muted-foreground text-sm mb-6" data-ps="src/pages/testimonials.astro:ozbzw4">
            Your feedback helps us continue to improve our services.
          </p>
          <div class="flex flex-wrap justify-center gap-4" data-ps="src/pages/testimonials.astro:dkkb8m">
            <a
              href="https://www.facebook.com/KREsecinvestigations/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-foreground text-background font-heading font-bold uppercase tracking-widest text-xs px-6 py-3 border-2 border-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors"
             data-ps="src/pages/testimonials.astro:w39wl1">
              Review on Facebook
            </a>
            <a
              href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.986583,17z"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-transparent text-foreground font-heading font-bold uppercase tracking-widest text-xs px-6 py-3 border-2 border-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors"
            >
              Review on Google
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-dot {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-flex;
  }
  .status-dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background-color: var(--color-primary);
    display: inline-block;
  }
  .tactical-frame {
    border: 1px solid var(--color-border);
    position: relative;
  }
  .tactical-frame::before {
    content: "";
    border-top: 3px solid var(--color-primary);
    border-left: 3px solid var(--color-primary);
    width: 12px;
    height: 12px;
    position: absolute;
    top: -2px;
    left: -2px;
  }
  .tactical-frame::after {
    content: "";
    border-bottom: 3px solid var(--color-primary);
    border-right: 3px solid var(--color-primary);
    width: 12px;
    height: 12px;
    position: absolute;
    bottom: -2px;
    right: -2px;
  }
</style>
