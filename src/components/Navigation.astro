---

<header data-header-variant={headerVariant} id="navbar" class="sticky top-0 z-50 bg-[#070E17] border-b border-[#1A2638] transition-colors duration-200" data-ps="src/components/Navigation.astro:1zp36w">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/Navigation.astro:lxl1mu">
    <div class="flex items-center justify-between h-[76px]" data-ps="src/components/Navigation.astro:lxl1mv">
      
      <!-- Brand Logo + Name -->
      <a href="/" class="flex items-center gap-3 no-underline group" data-ps="src/components/Navigation.astro:7vkjm7">
        <img
          src="https://pagesmith-cdn.com/fe6bcc20/images/kre-security-gold-logo-670a49-1024.webp"
          alt="KRE Security"
          class="h-11 w-auto object-contain transition-transform group-hover:scale-105" data-ps="src/components/Navigation.astro:jfbxaq" />
        <div class="flex flex-col" data-ps="src/components/Navigation.astro:lxl1mw">
          <span class="text-[17px] font-bold text-white font-['Space_Grotesk'] tracking-wider leading-none" data-ps="src/components/Navigation.astro:7xpcao">
            KRE SECURITY <span class="text-[#DBA400]" data-ps="src/components/Navigation.astro:7xpcan">LLC.</span>
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden xl:flex items-center gap-1 2xl:gap-2" data-ps="src/components/Navigation.astro:nrytxv">
        <a href="/" class="px-3 py-2 text-[14px] font-semibold text-white hover:text-[#DBA400] transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjm8">
          HOME
        </a>

        <!-- Services Mega Menu -->
        <div class="relative group h-full py-4" data-ps="src/components/Navigation.astro:lxl1mv">
          <button class="flex items-center gap-1 text-xs font-display font-bold text-foreground/80 uppercase tracking-wider hover:text-primary transition-colors cursor-default" data-ps="src/components/Navigation.astro:4mv8k">
            Services
            <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute left-1/2 -translate-x-1/2 top-full w-[320px] bg-background border border-border shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 p-6 z-50" data-ps="src/components/Navigation.astro:lxl1mw">
            <div class="grid grid-cols-1 gap-4" data-ps="src/components/Navigation.astro:lxl1mx">
              {coreServices.map(item => (
                <a href={item.href} class="flex items-center gap-3 text-xs font-display font-bold text-foreground/80 uppercase tracking-tight hover:text-primary transition-colors no-underline group/item" data-ps="src/components/Navigation.astro:7vkjqp">
                  <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-surface border border-border group-hover/item:border-primary transition-colors" data-ps="src/components/Navigation.astro:gqvsdc">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={iconMap[item.icon]} />
                  </div>
                  {item.title}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Specialized Security Mega Menu -->
        <div class="relative group h-full py-4" data-ps="src/components/Navigation.astro:lxl1my">
          <button class="flex items-center gap-1 text-xs font-display font-bold text-foreground/80 uppercase tracking-wider hover:text-primary transition-colors cursor-default" data-ps="src/components/Navigation.astro:4mv8l">
            Specialized
            <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute left-1/2 -translate-x-1/2 top-full w-[600px] max-w-[90vw] bg-background border border-border shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 p-8 z-50" data-ps="src/components/Navigation.astro:lxl1mz">
            <div class="grid grid-cols-2 gap-x-8 gap-y-4" data-ps="src/components/Navigation.astro:lxl1n0">
              {specializedSecurity.map(item => (
                <a href={item.href} class="flex items-center gap-3 text-xs font-display font-bold text-foreground/80 uppercase tracking-tight hover:text-primary transition-colors no-underline group/item" data-ps="src/components/Navigation.astro:7vkjrb">
                  <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-surface border border-border group-hover/item:border-primary transition-colors" data-ps="src/components/Navigation.astro:gqvsdd">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={iconMap[item.icon]} />
                  </div>
                  {item.title}
                </a>
              ))}
              <div class="col-span-2 pt-4 border-t border-border mt-2" data-ps="src/components/Navigation.astro:lxl1n1">
                <a href="/act-67-certified-services/" class="text-xs font-display font-bold text-primary uppercase tracking-widest hover:text-primary-hover no-underline flex items-center gap-3 group/item" data-ps="src/components/Navigation.astro:7vkjrc">
                  <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-primary text-primary-foreground border border-primary group-hover/item:bg-primary-hover transition-colors" data-ps="src/components/Navigation.astro:gqvsde">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={iconMap['graduation-cap']} />
                  </div>
                  ACT 67 TRAINING SERVICES
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- About Dropdown -->
        <div class="relative group h-full py-4" data-ps="src/components/Navigation.astro:lxl1n2">
          <button class="flex items-center gap-1 text-xs font-display font-bold text-foreground/80 uppercase tracking-wider hover:text-primary transition-colors cursor-default" data-ps="src/components/Navigation.astro:4mv8m">
