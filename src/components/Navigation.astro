            <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute left-1/2 -translate-x-1/2 top-full w-[240px] bg-background border border-border shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 p-6 z-50" data-ps="src/components/Navigation.astro:lxl1n3">
            <div class="flex flex-col gap-4" data-ps="src/components/Navigation.astro:gqvsd5">
              {aboutItems.map(item => (
                <a href={item.href} class="flex items-center gap-3 text-xs font-display font-bold text-foreground/80 uppercase tracking-tight hover:text-primary transition-colors no-underline group/item" data-ps="src/components/Navigation.astro:7vkjrd">
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={iconMap[item.icon]} />
                  {item.title}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- News Dropdown -->
        <div class="relative group h-full py-4" data-ps="src/components/Navigation.astro:gqvsd6">
          <button class="flex items-center gap-1 text-xs font-display font-bold text-foreground/80 uppercase tracking-wider hover:text-primary transition-colors cursor-default" data-ps="src/components/Navigation.astro:4mv8n">
            News
            <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute right-0 top-full w-[300px] bg-background border border-border shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 p-6 z-50" data-ps="src/components/Navigation.astro:gqvsd7">
            <div class="flex flex-col gap-4" data-ps="src/components/Navigation.astro:gqvsd8">
              {newsItems.map((item, idx) => (
                <a href={item.href} class={`flex items-center gap-3 text-xs font-display font-bold uppercase tracking-tight no-underline transition-colors ${idx === 0 ? 'text-primary' : 'text-foreground/80 hover:text-primary'}`} data-ps={`src/components/Navigation.astro:7vkjre-${idx}`}>
                  <svg class={`w-4 h-4 ${idx === 0 ? 'text-primary' : 'text-primary/60'}`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={iconMap[item.icon]} />
                  {item.title}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right Action Button -->
      </nav>
      <div class="hidden lg:flex items-center" data-ps="src/components/Navigation.astro:gqvsd7">
        <a
          href="tel:610-562-0971"
          class="inline-flex items-center justify-center bg-[#DBA400] hover:bg-[#EDBF35] text-[#0B1522] font-bold text-[15px] font-['Space_Grotesk'] px-6 py-2.5 rounded shadow-md transition-all no-underline"
         data-ps="src/components/Navigation.astro:7vkjot">
          610-562-0971
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex xl:hidden items-center gap-3" data-ps="src/components/Navigation.astro:gqvsd8">
        <a
          href="tel:610-562-0971"
          class="inline-flex items-center bg-[#DBA400] text-[#0B1522] font-bold text-[13px] font-['Space_Grotesk'] px-3 py-1.5 rounded no-underline sm:hidden"
         data-ps="src/components/Navigation.astro:7vkjou">
          Call
        </a>
        <button
          id="mobile-menu-button"
          type="button"
          class="p-2 text-white hover:text-[#DBA400] transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
         data-ps="src/components/Navigation.astro:4mv46">
          <svg id="menu-icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-[#070E17] border-t border-[#1A2638] px-4 pt-3 pb-6 max-h-[80vh] overflow-y-auto"
   data-ps="src/components/Navigation.astro:gqvsd9">
    <div class="flex flex-col gap-1" data-ps="src/components/Navigation.astro:gqvsda">
      <a href="/" class="py-2.5 px-3 text-white font-semibold rounded hover:bg-[#102032] no-underline" data-ps="src/components/Navigation.astro:7vkjov">HOME</a>

      <div class="py-2 px-3 text-[#DBA400] text-xs font-bold uppercase tracking-wider" data-ps="src/components/Navigation.astro:gqvsdb">Services</div>
      <a href="/security-services-pa/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjow">Security Services PA</a>
