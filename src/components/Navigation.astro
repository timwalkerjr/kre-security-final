      <a href="/armed-security-guards-quakertown-pa/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjoz">Armed Security Guards Quakertown</a>
      <a href="/vehicle-patrol/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjpl">Vehicle Patrol</a>
      <a href="/security-checks/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjpm">Security Checks</a>
      <a href="/school-security/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjpn">School Security</a>

      <div class="py-2 px-3 text-[#DBA400] text-xs font-bold uppercase tracking-wider mt-2" data-ps="src/components/Navigation.astro:gqvsdc">Specialized</div>
      <a href="/logistical-security/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjpo">Logistical Security</a>
