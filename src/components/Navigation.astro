      <a href="/fire-watch/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjpq">Fire Watch Services</a>
      <a href="/school-event-staff/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjpr">School Event Staff</a>
      <a href="/event-traffic-control/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjps">Event Traffic Control</a>
      <a href="/armed-money-escorts/" class="py-1.5 px-6 text-sm text-gray-300 hover:text-white no-underline" data-ps="src/components/Navigation.astro:7vkjpt">Armed Money Escorts</a>
