---
// Navigation matching KRE Security exact header
// ps:header-variant — BaseLayout passes variant="solid" on pages whose source
// shows the header solid at the top; the scroll script below keeps it so.
const headerVariant =
  (Astro.props as { variant?: 'transparent' | 'solid' }).variant ??
  'transparent';

const coreServices = [
  { title: 'Security Services PA', href: '/security-services-pa/', icon: 'shield' },
  { title: 'Security Guards PA', href: '/security-guards-pa/', icon: 'user-check' },
  { title: 'Armed Security PA', href: '/armed-security-pa/', icon: 'crosshair' },
  { title: 'Armed Security Guards Quakertown', href: '/armed-security-guards-quakertown-pa/', icon: 'map-pin' },
  { title: 'Vehicle Patrol', href: '/vehicle-patrol/', icon: 'car' },
  { title: 'Security Checks', href: '/security-checks/', icon: 'search' },
  { title: 'School Security', href: '/school-security/', icon: 'school' },
];

const specializedSecurity = [
  { title: 'Eastern PA Educators', href: 'https://www.easternpaeducators.com/', icon: 'graduation-cap' },
  { title: 'Logistical Security', href: '/logistical-security/', icon: 'truck' },
  { title: 'Warehouse Security', href: '/warehouse-distribution-security/', icon: 'warehouse' },
  { title: 'Fire Watch Services', href: '/fire-watch/', icon: 'flame' },
  { title: 'School Event Staff', href: '/school-event-staff/', icon: 'users' },
  { title: 'Event Traffic Control', href: '/event-traffic-control/', icon: 'signpost' },
  { title: 'Armed Money Escorts', href: '/armed-money-escorts/', icon: 'banknote' },
  { title: 'In-Home Security', href: '/in-home-security/', icon: 'home' },
  { title: 'Private Investigations', href: '/private-investigations/', icon: 'eye' },
  { title: 'Process Services', href: '/process-services/', icon: 'file-text' },
