---
import HeroSupportPanel from './HeroSupportPanel.astro';
---

<section id="hero" class="relative bg-[#070E17] text-white pt-12 pb-16 lg:py-20 overflow-hidden border-b border-[#1A2638]" data-ps="src/components/home/Hero.astro:ah8l9u">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/home/Hero.astro:iy4t8r">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start" data-ps="src/components/home/Hero.astro:iy4t9d">
      
      <!-- Left Column: Headline, Copy, CTAs, Badges & Testimonial Carousel -->
      <div class="lg:col-span-7 flex flex-col" data-ps="src/components/home/Hero.astro:iy4t9e">
        
        <p class="text-[#DBA400] font-['Space_Grotesk'] text-[13px] font-bold tracking-[0.18em] uppercase mb-4" data-ps="src/components/home/Hero.astro:6uykqj">
          PENNSYLVANIA SECURITY PROFESSIONALS
        </p>

        <h1 class="text-white text-[38px] sm:text-[48px] lg:text-[56px] font-bold font-['Space_Grotesk'] leading-[1.1] mb-6" data-ps="src/components/home/Hero.astro:307k00">
          Precision Protection <span class="block text-[#DBA400]" data-ps="src/components/home/Hero.astro:z1i21l">for the Commonwealth.</span>
        </h1>

        <p class="text-gray-300 text-[16px] sm:text-[17px] leading-relaxed max-w-[620px] mb-8 font-['Manrope']" data-ps="src/components/home/Hero.astro:6uykqi">
          KRE Security, LLC delivers comprehensive, licensed, and responsive security services that protect the people, property, and operations of every client we serve across Pennsylvania.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 mb-8" data-ps="src/components/home/Hero.astro:iy4t9f">
          <a
            href="tel:610-562-0971"
            class="inline-flex items-center gap-2 bg-[#DBA400] hover:bg-[#EDBF35] text-[#0B1522] font-bold font-['Space_Grotesk'] text-[16px] px-7 py-3.5 rounded transition-all shadow-lg no-underline"
           data-ps="src/components/home/Hero.astro:8zbxm">
            <span data-ps="src/components/home/Hero.astro:z1i20z">610-562-0971</span>
            <span class="text-lg" data-ps="src/components/home/Hero.astro:z1i20y">↗</span>
          </a>
          <a
            href="/#services"
            class="inline-flex items-center bg-[#102032] hover:bg-[#162B44] border border-[#20344D] text-white font-medium text-[15px] font-['Manrope'] px-6 py-3.5 rounded transition-all no-underline"
           data-ps="src/components/home/Hero.astro:8zbxn">
            Explore our services
          </a>
        </div>

        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-gray-400 pb-8 border-b border-[#1A2638] mb-8" data-ps="src/components/home/Hero.astro:iy4t9g">
          <div class="flex items-center gap-2" data-ps="src/components/home/Hero.astro:iy4t9h">
            <span class="w-2 h-2 rounded-full bg-[#DBA400]" data-ps="src/components/home/Hero.astro:z1i20x"></span>
            <span data-ps="src/components/home/Hero.astro:z1i20w">Licensed & insured · No. 84</span>
          </div>
          <span class="text-gray-600 hidden sm:inline" data-ps="src/components/home/Hero.astro:z1i20v">|</span>
          <div class="flex items-center gap-2" data-ps="src/components/home/Hero.astro:iy4t9i">
            <span class="w-2 h-2 rounded-full bg-[#DBA400]" data-ps="src/components/home/Hero.astro:z1i20u"></span>
            <span data-ps="src/components/home/Hero.astro:z1i20t">Veteran supported firm</span>
          </div>
        </div>

        <!-- Hero Testimonial Carousel -->
        <div class="bg-[#0B1522]/70 border border-[#1E2D42] rounded-lg p-5 sm:p-6 relative" data-ps="src/components/home/Hero.astro:iy4t9j">
          <div class="flex items-center justify-between mb-3" data-ps="src/components/home/Hero.astro:iy4t9k">
            <div class="flex text-[#DBA400] text-sm tracking-widest" data-ps="src/components/home/Hero.astro:iy4t9l">
              ★★★★★
            </div>
            <div class="flex items-center gap-2" data-ps="src/components/home/Hero.astro:iy4t9m">
              <button
                id="hero-testimonial-prev"
                type="button"
                aria-label="Previous testimonial"
                class="w-7 h-7 rounded bg-[#152538] hover:bg-[#DBA400] hover:text-[#0B1522] text-gray-300 flex items-center justify-center text-xs transition-colors cursor-pointer"
               data-ps="src/components/home/Hero.astro:c0ayqo">
                ←
              </button>
              <button
                id="hero-testimonial-next"
                type="button"
                aria-label="Next testimonial"
                class="w-7 h-7 rounded bg-[#152538] hover:bg-[#DBA400] hover:text-[#0B1522] text-gray-300 flex items-center justify-center text-xs transition-colors cursor-pointer"
               data-ps="src/components/home/Hero.astro:c0ayqp">
                →
              </button>
            </div>
          </div>

          <div id="hero-testimonials-container" class="relative min-h-[68px]" data-ps="src/components/home/Hero.astro:iy4ta8">
            <div class="hero-testimonial-slide block transition-opacity duration-300" data-ps="src/components/home/Hero.astro:iy4ta9">
              <p class="text-gray-200 text-sm sm:text-[15px] italic mb-2" data-ps="src/components/home/Hero.astro:6uykqh">
                "Great company who responds to our needs in a timely fashion and have great workers!"
              </p>
              <p class="text-xs font-semibold text-[#DBA400]" data-ps="src/components/home/Hero.astro:6uykqg">— Daniel Weber</p>
            </div>

            <div class="hero-testimonial-slide hidden transition-opacity duration-300" data-ps="src/components/home/Hero.astro:iy4taa">
              <p class="text-gray-200 text-sm sm:text-[15px] italic mb-2" data-ps="src/components/home/Hero.astro:6uykqf">
                "Great agency, helped me in my time of need with training/ services! Top notch!"
              </p>
              <p class="text-xs font-semibold text-[#DBA400]" data-ps="src/components/home/Hero.astro:6uykqe">— Angela Yager</p>
            </div>

            <div class="hero-testimonial-slide hidden transition-opacity duration-300" data-ps="src/components/home/Hero.astro:iy4tab">
              <p class="text-gray-200 text-sm sm:text-[15px] italic mb-2" data-ps="src/components/home/Hero.astro:6uykqd">
                "Very professional, great customer service."
              </p>
              <p class="text-xs font-semibold text-[#DBA400]" data-ps="src/components/home/Hero.astro:6uykpr">— Rachel Radel-Bardo</p>
            </div>

            <div class="hero-testimonial-slide hidden transition-opacity duration-300" data-ps="src/components/home/Hero.astro:iy4tac">
              <p class="text-gray-200 text-sm sm:text-[15px] italic mb-2" data-ps="src/components/home/Hero.astro:6uykpq">
                "More relaxed feeling at functions knowing guards that are well trained are watching the area"
              </p>
              <p class="text-xs font-semibold text-[#DBA400]" data-ps="src/components/home/Hero.astro:6uykpp">— John Lubas</p>
            </div>

            <div class="hero-testimonial-slide hidden transition-opacity duration-300" data-ps="src/components/home/Hero.astro:iy4tad">
              <p class="text-gray-200 text-sm sm:text-[15px] italic mb-2" data-ps="src/components/home/Hero.astro:6uykpo">
                "Great for Pediatric first aid and CPR training! Thanks a lot for all of the information!"
              </p>
              <p class="text-xs font-semibold text-[#DBA400]" data-ps="src/components/home/Hero.astro:6uykpn">— Alisia</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Netlify support panel styling -->
      <div class="lg:col-span-5">
        <HeroSupportPanel />
      </div>

    </div>
  </div>
</section>

<script is:inline>
  const slides = document.querySelectorAll('.hero-testimonial-slide');
  const prevBtn = document.getElementById('hero-testimonial-prev');
  const nextBtn = document.getElementById('hero-testimonial-next');
  let currentSlide = 0;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('hidden');
        slide.classList.add('block');
      } else {
        slide.classList.add('hidden');
        slide.classList.remove('block');
      }
    });
  }

  prevBtn?.addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + slides.length) % slides.length;
    showSlide(currentSlide);
  });

  nextBtn?.addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % slides.length;
    showSlide(currentSlide);
  });
</script>
