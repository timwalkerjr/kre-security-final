<section id="contact" class="bg-[#070E17] py-20 text-white border-b border-[#1A2638]" data-ps="src/components/home/Contact.astro:hfh227">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/home/Contact.astro:o1wv08">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14" data-ps="src/components/home/Contact.astro:o1wv07">
      
      <!-- Left Column: Dispatch Portal Details -->
      <div class="lg:col-span-6 flex flex-col" data-ps="src/components/home/Contact.astro:o1wv06">
        
        <div class="flex items-center gap-2 mb-3" data-ps="src/components/home/Contact.astro:o1wv05">
          <span class="w-2.5 h-2.5 bg-[#DBA400] rotate-45 inline-block" data-ps="src/components/home/Contact.astro:jamzur"></span>
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-[#DBA400] font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:jamzuq">
            DISPATCH PORTAL
          </span>
        </div>

        <h2 class="font-bold font-['Space_Grotesk'] leading-[1.15] mb-4 text-[rgb(250,250,250)] text-[40px]" data-ps="src/components/home/Contact.astro:hp7u1q">
          Contact Us Today for a Security Service Quote
        </h2>

        <p class="text-gray-300 text-base leading-relaxed mb-8 max-w-xl font-['Manrope']" data-ps="src/components/home/Contact.astro:u4l09x">
          Professional protection begins with a tailored assessment. Connect with our regional headquarters to discuss your security requirements.
        </p>

        <!-- Office & Dispatch Information Cards -->
        <div class="space-y-6" data-ps="src/components/home/Contact.astro:o1wv04">
          
          <div class="flex items-start gap-4 p-4 bg-[#102032] border border-[#1E2D42] rounded-lg" data-ps="src/components/home/Contact.astro:o1wuzi">
            <div class="text-[#DBA400] text-xl mt-1" data-ps="src/components/home/Contact.astro:o1wuzh">
              📞
            </div>
            <div data-ps="src/components/home/Contact.astro:o1wuzg">
              <p class="text-xs font-bold text-[#DBA400] uppercase tracking-wider font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:u4l09y">
                EMERGENCY DISPATCH
              </p>
              <a href="tel:610-562-0971" class="text-xl sm:text-2xl font-bold font-['Space_Grotesk'] text-white hover:text-[#DBA400] no-underline" data-ps="src/components/home/Contact.astro:xsl506">
                610-562-0971
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 bg-[#102032] border border-[#1E2D42] rounded-lg" data-ps="src/components/home/Contact.astro:o1wuzf">
            <div class="text-[#DBA400] text-xl mt-1" data-ps="src/components/home/Contact.astro:o1wuze">
              📍
            </div>
            <div data-ps="src/components/home/Contact.astro:o1wuzd">
              <p class="text-xs font-bold text-[#DBA400] uppercase tracking-wider font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:u4l09z">
                MAIN OFFICE
              </p>
              <p class="text-sm text-gray-200 mt-1 font-['Manrope']" data-ps="src/components/home/Contact.astro:u4l0a0">
                16600 Pottsville Pike, Hamburg, PA 19526
              </p>
              <a href="tel:610-562-0971" class="text-sm font-bold text-white hover:text-[#DBA400] no-underline block mt-1" data-ps="src/components/home/Contact.astro:xsl505">
                610-562-0971
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 bg-[#102032] border border-[#1E2D42] rounded-lg" data-ps="src/components/home/Contact.astro:o1wuzc">
            <div class="text-[#DBA400] text-xl mt-1" data-ps="src/components/home/Contact.astro:o1wuzb">
              🏢
            </div>
            <div data-ps="src/components/home/Contact.astro:o1wuza">
              <p class="text-xs font-bold text-[#DBA400] uppercase tracking-wider font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:u4l0a1">
                HARRISBURG REGIONAL OFFICE
              </p>
              <p class="text-sm text-gray-200 mt-1 font-['Manrope']" data-ps="src/components/home/Contact.astro:u4l0a2">
                3405 North 6th Street, Suite 204, Harrisburg, PA 17110
              </p>
              <a href="tel:717-480-2961" class="text-sm font-bold text-white hover:text-[#DBA400] no-underline block mt-1" data-ps="src/components/home/Contact.astro:xsl504">
                717-480-2961
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 bg-[#102032] border border-[#1E2D42] rounded-lg" data-ps="src/components/home/Contact.astro:o1wuz9">
            <div class="text-[#DBA400] text-xl mt-1" data-ps="src/components/home/Contact.astro:1ijz25">
              ✉️
            </div>
            <div class="text-sm text-gray-300 space-y-1 font-['Manrope']" data-ps="src/components/home/Contact.astro:1ijz26">
              <p class="text-xs font-bold text-[#DBA400] uppercase tracking-wider font-['Space_Grotesk'] mb-1" data-ps="src/components/home/Contact.astro:u4l0a3">
                EMAIL US
              </p>
              <p data-ps="src/components/home/Contact.astro:u4l0ap">General: <a href="mailto:jemes@kresecurity.com" class="text-white hover:text-[#DBA400] underline" data-ps="src/components/home/Contact.astro:xsl503">jemes@kresecurity.com</a></p>
              <p data-ps="src/components/home/Contact.astro:u4l0aq">Billing: <a href="mailto:financial@kresecurity.com" class="text-white hover:text-[#DBA400] underline" data-ps="src/components/home/Contact.astro:xsl502">financial@kresecurity.com</a></p>
              <p data-ps="src/components/home/Contact.astro:u4l0ar">Scheduling: <a href="mailto:scheduling@kresecurity.com" class="text-white hover:text-[#DBA400] underline" data-ps="src/components/home/Contact.astro:xsl4zg">scheduling@kresecurity.com</a></p>
            </div>
          </div>

        </div>

      </div>

      <!-- Right Column: Contact / Quote Form -->
      <div class="lg:col-span-6" data-ps="src/components/home/Contact.astro:1ijz27">
        <div class="bg-[#102032] border border-[#1E2D42] rounded-xl p-8 sm:p-10 shadow-2xl" data-ps="src/components/home/Contact.astro:1ijz28">
          
          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" data-ps="src/components/home/Contact.astro:1ijz29">
              <div data-ps="src/components/home/Contact.astro:1ijz2a">
                <label for="first-name" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2 font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:tikb9o">
                  First Name *
                </label>
                <input
                  type="text"
                  id="first-name"
                  name="firstName"
                  required
                  placeholder="First name"
                  class="w-full bg-[#070E17] border border-[#1E2D42] focus:border-[#DBA400] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors"
                />
              </div>

              <div data-ps="src/components/home/Contact.astro:1ijz2b">
                <label for="last-name" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2 font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:tikb9p">
                  Last Name
                </label>
                <input
                  type="text"
                  id="last-name"
                  name="lastName"
                  placeholder="Last name"
                  class="w-full bg-[#070E17] border border-[#1E2D42] focus:border-[#DBA400] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors"
                />
              </div>
            </div>

            <div data-ps="src/components/home/Contact.astro:1ijz2c">
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2 font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:tikb9q">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@example.com"
                class="w-full bg-[#070E17] border border-[#1E2D42] focus:border-[#DBA400] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors"
              />
            </div>

            <div data-ps="src/components/home/Contact.astro:1ijz2d">
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-gray-300 mb-2 font-['Space_Grotesk']" data-ps="src/components/home/Contact.astro:tikb9r">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="How can we help protect your people, property, or event?"
                class="w-full bg-[#070E17] border border-[#1E2D42] focus:border-[#DBA400] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-[#DBA400] hover:bg-[#EDBF35] text-[#0B1522] font-bold text-sm uppercase tracking-wider font-['Space_Grotesk'] py-4 rounded transition-all shadow-lg cursor-pointer"
            >
              SUBMIT REQUEST
            </button>

            <div id="form-feedback" class="hidden text-sm text-center py-2 rounded mt-3 font-medium" data-ps="src/components/home/Contact.astro:1ijz2e"></div>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const formFeedback = document.getElementById('form-feedback');

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !formFeedback) return;

    submitBtn.setAttribute('disabled', 'true');
    submitBtn.textContent = 'SENDING...';

    const formData = new FormData(contactForm);
    const firstName = formData.get('firstName');
    const lastName = formData.get('lastName');
    const email = formData.get('email');
    const message = formData.get('message');

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: `${firstName} ${lastName}`.trim(),
          email: email,
          message: message,
          subject: 'Security Quote Request - KRE Security'
        })
      });

      if (res.ok) {
        formFeedback.className = 'text-sm text-center py-2 rounded mt-3 font-medium text-green-400 bg-green-950/40 border border-green-800';
        formFeedback.textContent = 'Thank you! Your quote request has been submitted. Our dispatch team will contact you shortly.';
        formFeedback.classList.remove('hidden');
        contactForm.reset();
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      formFeedback.className = 'text-sm text-center py-2 rounded mt-3 font-medium text-amber-300 bg-amber-950/40 border border-amber-800';
      formFeedback.textContent = 'Request received. You can also reach our 24/7 dispatch directly at 610-562-0971.';
      formFeedback.classList.remove('hidden');
    } finally {
      submitBtn.removeAttribute('disabled');
      submitBtn.textContent = 'SUBMIT REQUEST';
    }
  });
</script>
